{
  "name": "warpgogol-platform",
  "private": true,
  "type": "module",
  "version": "5.51.26",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "registry:build": "pnpm exec werkstatt run uni.registry.build && pnpm exec werkstatt run archetype.registry.build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/turbo-run.mjs build",
    "build:gen": "node scripts/turbo-run.mjs build",
    "build:check": "node scripts/turbo-run.mjs build:check",
    "check:gen": "node scripts/turbo-run.mjs build:check",
    "check:all": "turbo run check",
    "dev": "pnpm --filter warpgogol-com start",
    "test": "turbo run test",
    "upgrade-packages": "pnpm -r up && pnpm exec werkstatt run config.template.sync --site warpgogol-com",
    "compass:validate": "pnpm exec werkstatt run compass.validate",
    "compass:validate:main": "pnpm exec werkstatt run compass.validate --site warpgogol-com",
    "compass:validate:ref": "pnpm exec werkstatt run compass.validate --site <app-name>",
    "compass:inventory": "pnpm exec werkstatt run compass.inventory",
    "lint:packages": "eslint \"packages/**/*.ts\"",
    "lint:astro": "eslint \"packages/**/*.astro\"",
    "lint:all": "eslint \"packages/**/*.ts\" \"packages/**/*.astro\"",
    "lint:yaml": "eslint --config eslint.config.js \"**/*.yaml\"",
    "git-add-force": "git rm -r --cached . && git add .",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@warpgogol/changelog-live": "^0.2.3",
    "@warpgogol/forge": "workspace:*",
    "@warpgogol/repo-extract": "^1.2.2",
    "@warpgogol/werkstatt": "workspace:*",
    "@warpgogol/werkstatt-site": "workspace:*",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-yml": "^1.19.1",
    "openai": "^7.4.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
