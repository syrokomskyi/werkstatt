{
  "name": "@warpgogol/werkstatt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Werkstatt engine plugin contract and validation (RFC-0770).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin-contract.ts",
      "default": "./src/plugin-contract.ts"
    },
    "./os/werkstatt-plugin-module": {
      "types": "./os/werkstatt-plugin.module.ts",
      "default": "./os/werkstatt-plugin.module.ts"
    }
  },
  "scripts": {
    "build:check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@warpgogol/site-kernel": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
