{
  "name": "warpgogol-platform",
  "private": true,
  "type": "module",
  "version": "4.17.24",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "registry:build": "node packages/os/site-kernel/bin/site-kernel.mjs run uni.registry.build && node packages/os/site-kernel/bin/site-kernel.mjs run archetype.registry.build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/turbo-run.mjs build",
    "build:gen": "node scripts/turbo-run.mjs build",
    "build:check": "node scripts/turbo-run.mjs build:check",
    "check:gen": "node scripts/turbo-run.mjs build:check",
    "check:all": "turbo run check",
    "dev": "pnpm --filter warpgogol-com start",
    "test": "turbo run test",
    "upgrade-packages": "pnpm -r up && pnpm exec site-kernel run config.template.sync --site warpgogol-com",
    "compass:validate": "node packages/os/site-kernel/bin/site-kernel.mjs run compass.validate",
    "compass:validate:main": "node packages/os/site-kernel/bin/site-kernel.mjs run compass.validate --site warpgogol-com",
    "compass:validate:ref": "node packages/os/site-kernel/bin/site-kernel.mjs run compass.validate --site <app-name>",
    "compass:inventory": "node packages/os/site-kernel/bin/site-kernel.mjs run compass.inventory",
    "lint:packages": "eslint \"packages/**/*.ts\"",
    "lint:yaml": "eslint --config eslint.config.js \"**/*.yaml\"",
    "git-add-force": "git rm -r --cached . && git add .",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "@warpgogol/forge": "workspace:*",
    "@warpgogol/observability": "workspace:*",
    "@warpgogol/site-kernel": "workspace:*",
    "@warpgogol/site-kernel-astro": "workspace:*",
    "@warpgogol/site-kernel-changelog": "workspace:*",
    "@warpgogol/site-kernel-checks": "workspace:*",
    "@warpgogol/site-kernel-codegen": "workspace:*",
    "@warpgogol/site-kernel-deploy": "workspace:*",
    "@warpgogol/site-kernel-handoff": "workspace:*",
    "@warpgogol/site-kernel-integrity": "workspace:*",
    "@warpgogol/site-kernel-observability": "workspace:*",
    "@warpgogol/site-kernel-onboarding": "workspace:*",
    "eslint": "^10.8.0",
    "eslint-plugin-yml": "^1.19.1",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
