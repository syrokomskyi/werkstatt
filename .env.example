# RFC-0388: Root-level environment variables for monorepo tooling.
# Copy to .env (never commit) and fill values as needed.
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# ── Node.js environment
# How to obtain: Set to "production" for production builds, "development" for local dev.
NODE_ENV=

# ── Cloudflare API (optional — used by root-level wrangler commands)
# How to obtain: Cloudflare Dashboard → My Profile → API Tokens → Create Token.
CLOUDFLARE_API_TOKEN=

# ── Cloudflare Zone ID (optional — used by Leitstand post-deploy CDN cache purge, RFC-0624)
# How to obtain: Cloudflare Dashboard → Overview → Zone ID (right sidebar).
CLOUDFLARE_ZONE_ID=

# ── Cloudflare Account ID (optional — used by wrangler deploy in Leitstand, RFC-0379)
# How to obtain: Cloudflare Dashboard → Overview → Account ID (right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# ── Ecosystem commit (transient — set programmatically by ecosystem.commit, not by the operator)
# How to obtain: Set programmatically by ecosystem.commit; not configured by the operator.
ECOSYSTEM_COMMIT=

# ── Passport signing key (RFC-0558 identity model)
# How to obtain: run `pnpm exec site-kernel run identity.bootstrap --operator-name "Your Name" --domain warpgogol.com --json`
# The private key is printed to stdout during identity.bootstrap. Copy it here or to a GitHub Actions secret.
# NEVER commit the actual key value — only the variable name.
PASSPORT_SIGNING_KEY=

# ── Cloudflare R2 (RFC-0651 evidence sync and fetch)
# How to obtain: Cloudflare Dashboard → R2 → Overview → Account ID (right sidebar).
R2_ACCOUNT_ID=

# How to obtain: Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token with Object Read & Write.
R2_ACCESS_KEY_ID=

# How to obtain: Same token creation flow as R2_ACCESS_KEY_ID — the secret is shown once during creation.
R2_SECRET_ACCESS_KEY=
