#!/bin/bash
# Pre-commit hook: block direct git commit for platform-scope changes.
# Activated via: git config core.hooksPath hooks/

set -euo pipefail

# ecosystem.commit sets ECOSYSTEM_COMMIT=1 when invoking git commit.
# It bypasses the platform-scope guard (ecosystem.commit IS the platform commit path),
# but CSS token validation and ENV-CONTRACT checks still run.
if [ -z "${ECOSYSTEM_COMMIT:-}" ]; then
  # Check if any staged file matches platform scope
  PLATFORM_FILES=$(git diff --cached --name-only -- 'packages/' 'integrations/' 'services/' || true)

  if [ -n "$PLATFORM_FILES" ]; then
    echo "ERROR: Direct git commit blocked for platform-scope changes." >&2
    echo "" >&2
    echo "Staged files touch platform scope (packages/**, integrations/**, services/**)." >&2
    echo "Use ecosystem.commit instead:" >&2
    echo "" >&2
    echo "  pnpm exec site-kernel run ecosystem.commit --message \"<your message>\" [--rfc RFC-XXXX]" >&2
    echo "" >&2
    echo "Tip for AI agents: remember this rule — platform-scope changes MUST use" >&2
    echo "ecosystem.commit, not git commit. Non-platform changes (docs/rfcs/**, missions/**)" >&2
    echo "may use git commit directly." >&2
    exit 1
  fi
fi

# ENV-CONTRACT-06: blank line between variable blocks in .env.example files
# These checks run regardless of ECOSYSTEM_COMMIT — they protect all commits.
ENV_EXAMPLE_FILES=$(git diff --cached --name-only -- '*.env.example' '.env.example' '**/.env.example' || true)
if [ -n "$ENV_EXAMPLE_FILES" ]; then
  ENV_ERRORS=""
  for f in $ENV_EXAMPLE_FILES; do
    if [ ! -f "$f" ]; then continue; fi
    # Check: every variable block (except the first) must be preceded by a blank line
    # A "block" is a comment line(s) followed by a KEY= line
    while IFS= read -r line_num; do
      [ -z "$line_num" ] && continue
      ENV_ERRORS="$ENV_ERRORS\n  $f:$line_num — missing blank line before variable block (ENV-CONTRACT-06)"
    done < <(awk '
      /^[A-Z][A-Z0-9_]*=/ {
        if (prev_was_var && !blank_seen) {
          print NR
        }
        prev_was_var = 1
        blank_seen = 0
        next
      }
      /^$/ { blank_seen = 1; next }
      /^#/ { next }
      { prev_was_var = 0; blank_seen = 0 }
    ' "$f")
  done
  if [ -n "$ENV_ERRORS" ]; then
    echo "ERROR: .env.example ENV-CONTRACT-06 violations detected:" >&2
    echo -e "$ENV_ERRORS" >&2
    echo "" >&2
    echo "Every variable block (except the first) must be preceded by an empty line (RFC-0388 Rule 3)." >&2
    echo "Fix: add a blank line above the comment block for each flagged variable." >&2
    exit 1
  fi

  # ENV-CONTRACT-05: every variable must have a "# How to obtain:" line in its comment block
  ENV05_ERRORS=""
  for f in $ENV_EXAMPLE_FILES; do
    if [ ! -f "$f" ]; then continue; fi
    while IFS= read -r line_num; do
      [ -z "$line_num" ] && continue
      VAR_NAME=$(sed -n "${line_num}p" "$f" | sed 's/=.*//')
      ENV05_ERRORS="$ENV05_ERRORS\n  $f:$line_num — variable \"$VAR_NAME\" missing \"# How to obtain:\" instruction (ENV-CONTRACT-05)"
    done < <(awk '
      /^[A-Z][A-Z0-9_]*=/ {
        if (!has_how_to) {
          print NR
        }
        has_how_to = 0
        next
      }
      /^#[[:space:]]*[Hh]ow to obtain:/ { has_how_to = 1 }
      /^#/ { next }
      /^$/ { has_how_to = 0 }
    ' "$f")
  done
  if [ -n "$ENV05_ERRORS" ]; then
    echo "ERROR: .env.example ENV-CONTRACT-05 violations detected:" >&2
    echo -e "$ENV05_ERRORS" >&2
    echo "" >&2
    echo "Every variable in .env.example must include a \"# How to obtain:\" instruction line (RFC-0388 Rule 3)." >&2
    echo "Fix: add a \"# How to obtain: <instructions>\" line above each flagged variable." >&2
    exit 1
  fi
fi

# CSS design token validation (RFC-0718)
# Fast grep-based check for invalid --ds-* tokens in staged .css files
CSS_FILES=$(git diff --cached --name-only -- '*.css' || true)
if [ -n "$CSS_FILES" ]; then
  TOKENS_FILE="packages/tokens/src/tokens.css"
  if [ ! -f "$TOKENS_FILE" ]; then
    echo "WARNING: $TOKENS_FILE not found — skipping CSS token validation" >&2
  else
    CSS_ERRORS=""
    for f in $CSS_FILES; do
      if [ ! -f "$f" ]; then continue; fi
      while IFS= read -r token; do
        [ -z "$token" ] && continue
        if ! grep -qP "^\s*\Q$token\E\s*:" "$TOKENS_FILE"; then
          CSS_ERRORS="$CSS_ERRORS\n  $f — invalid token: $token"
        fi
      done < <(grep -oP 'var\(\s*\K--ds-[a-z0-9-]+' "$f")
    done
    if [ -n "$CSS_ERRORS" ]; then
      echo "ERROR: Invalid CSS design tokens detected:" >&2
      echo -e "$CSS_ERRORS" >&2
      echo "" >&2
      echo "Only --ds-* tokens from packages/tokens/src/tokens.css are allowed." >&2
      echo "Fix: replace invalid tokens with valid ones from the token list." >&2
      exit 1
    fi
  fi
fi

# RFC/ADR directory structure guard (RFC-0722)
# Block commits that stage files in unauthorized subdirectories under docs/rfcs/ or docs/adrs/
RFC_DIR_STAGED=$(git diff --cached --name-only -- 'docs/rfcs/' 'docs/adrs/' || true)
if [ -n "$RFC_DIR_STAGED" ]; then
  DIR_ERRORS=""
  for f in $RFC_DIR_STAGED; do
    case "$f" in
      docs/rfcs/archive/*|docs/rfcs/verification/*)
        ;; # allowed subdirectories under docs/rfcs/
      docs/rfcs/*/*)
        DIR_ERRORS="$DIR_ERRORS\n  $f — unauthorized subdirectory under docs/rfcs/ (only archive/ and verification/ are allowed)"
        ;;
      docs/adrs/archive/*)
        ;; # allowed subdirectory under docs/adrs/
      docs/adrs/*/*)
        DIR_ERRORS="$DIR_ERRORS\n  $f — unauthorized subdirectory under docs/adrs/ (only archive/ is allowed)"
        ;;
    esac
  done
  if [ -n "$DIR_ERRORS" ]; then
    echo "ERROR: Unauthorized RFC/ADR directory structure (RFC-0722):" >&2
    echo -e "$DIR_ERRORS" >&2
    echo "" >&2
    echo "Only archive/ (RFC-0367) and verification/ subdirectories are sanctioned." >&2
    echo "To introduce a new subdirectory convention, write an ADR first." >&2
    exit 1
  fi
fi

# Command manifest staleness check (RFC-0646)
# Warn when command-registration files change without manifest regeneration.
COMMAND_FILES=$(git diff --cached --name-only -- 'packages/forge/os/core/' 'packages/forge/os/*/core.module.ts' 'tools/kernel.config.ts' || true)
MANIFEST_STAGED=$(git diff --cached --name-only -- 'docs/command-manifest.generated.yaml' || true)

if [ -n "$COMMAND_FILES" ] && [ -z "$MANIFEST_STAGED" ]; then
  echo "WARNING: Command-registration files are staged but docs/command-manifest.generated.yaml is not." >&2
  echo "" >&2
  echo "Staged command files:" >&2
  echo "$COMMAND_FILES" | sed 's/^/  /' >&2
  echo "" >&2
  echo "If these changes add, remove, or modify commands, regenerate the manifest:" >&2
  echo "  pnpm exec site-kernel run command.manifest.generate" >&2
  echo "Then stage and commit docs/command-manifest.generated.yaml." >&2
  echo "" >&2
  echo "If this commit does not change the command surface, you may proceed." >&2
  echo "" >&2
fi

exit 0
