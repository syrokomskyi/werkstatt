{
  "name": "@gogol/growth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendor-agnostic growth layer for the WGogol platform: GrowthAdapter interface, typed emit(), and GrowthProvider island (DNA-27..30, RFC-0027).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapter": {
      "types": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./emit": {
      "types": "./src/emit.ts",
      "default": "./src/emit.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./null-adapter": {
      "types": "./src/null-adapter.ts",
      "default": "./src/null-adapter.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./provider": {
      "types": "./src/provider.astro",
      "default": "./src/provider.astro"
    },
    "./provider.astro": {
      "types": "./src/provider.astro",
      "default": "./src/provider.astro"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "echo 'No build step required — TypeScript sources consumed directly'",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gogol/ontology": "workspace:*",
    "astro": "^7.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  },
  "gogol": {
    "testSignal": {
      "signal": "direct",
      "owner": "architecture",
      "rationale": "Vitest unit tests cover emit queue lifecycle, event catalog, config schema, and null adapter."
    }
  }
}
