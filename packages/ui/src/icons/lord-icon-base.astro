---
/*
<MODULE_CONTRACT>
<purpose>Maintains packages/ui/src/icons/lord-icon-base.astro as an authored ui authored module so agents can evolve it without rediscovering local boundaries.</purpose>
<non-goals>
  <item>Do not manage complex state or interactivity beyond provided props.</item>
  <item>Do not parse or transform raw icon data sources.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Revised Compass scaffolding for improved clarity and structure in the LordIconBase component.</item>
</CHANGE_SUMMARY>
*/

/**
 * Base LordIcon component
 *
 * Renders a lord-icon web component with configurable animation, colors, and styling.
 * This component requires the LordIcon script to be loaded in the page.
 *
 * @example
 * ```astro
 * import LordIconBase from '@warpgogol/ui/icons/lord-icon-base';
 * import iconSrc from './icon.json?url';
 *
 * <LordIconBase src={iconSrc} size={24} color="primary" trigger="hover" />
 * ```
 */
import type { LordIconColor, LordIconProps } from "./lord-icon-types.js";

export type Props = LordIconProps;

/**
 * Color palette mapping
 * These map to CSS custom properties defined in global styles
 */
const COLORS: Record<LordIconColor, string> = {
  current: "#E5E7EB",
  primary: "#1a4332",
  secondary: "#b54c1f",
  accent: "#d69e2e",
  success: "#22C55E",
  warning: "#D97706",
  error: "#EF4444",
  muted: "#6B7280",
  white: "#FFFFFF",
  gray: "#9CA3AF",
};

const {
  src,
  size = 20,
  color = "current",
  colors: customColors,
  class: className,
  speed,
  trigger = "hover",
  stroke = "bold",
  loading,
  "aria-label": ariaLabel,
} = Astro.props as Props;

// Build colors attribute for lord-icon element
let colorsAttr: string | undefined;

if (customColors) {
  if (typeof customColors === "string") {
    colorsAttr = customColors;
  } else {
    const parts: string[] = [];
    if (customColors.primary) parts.push(`primary:${customColors.primary}`);
    if (customColors.secondary) parts.push(`secondary:${customColors.secondary}`);
    colorsAttr = parts.join(",");
  }
} else if (color !== "current") {
  const colorHex = COLORS[color] ?? COLORS["current"];
  if (!COLORS[color]) {
    console.warn(
      `[lord-icon-base] Unknown color: "${color}". Expected: ${Object.keys(COLORS).join(", ")}. Falling back to "current".`,
    );
  }
  colorsAttr = `primary:${colorHex},secondary:${colorHex}`;
}
---

<lord-icon
  class:list={["lord-icon", { "current-color": !colorsAttr && color === "current" }, className]}
  data-src={src}
  trigger={trigger}
  speed={speed}
  stroke={stroke}
  colors={colorsAttr}
  loading={loading}
  aria-label={ariaLabel}
  style={`width:${size}px;height:${size}px;display:inline-flex;flex-shrink:0;vertical-align:middle;`}
></lord-icon>
