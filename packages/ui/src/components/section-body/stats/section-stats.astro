---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0103 + RFC-0040] Canonical body component for body.kind: "stats". Renders
  a grid of stat tiles and emits the js-stat-counter / data-numeric / data-prefix
  / data-suffix / data-decimals / data-duration markup that the existing
  gsap-counter.ts script consumes when runStandardLayoutOrchestration({ counters: true }).
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import { resolveCounterStats } from "@warpgogol/share";
import type { StatItem, HorizontalAlign } from "@warpgogol/share";
import "./section-stats.css";

interface Props {
  stats: StatItem[];
  animated?: boolean;
  align?: HorizontalAlign;
  /** Active locale for Intl.NumberFormat. */
  lang?: string;
}

const { stats, animated = false, align = "left", lang } = Astro.props as Props;
if (!lang) {
  throw new Error("[section-stats] lang is required.");
}
const resolvedStats = resolveCounterStats(stats, animated, lang);
---

<div
  class:list={["section-stats", `section-stats--align-${align}`]}
  data-animated={animated ? "true" : undefined}
>
  {
    resolvedStats.map((stat) => (
      <div class="section-stats__item">
        <div class="section-stats__value-wrap">
          {stat.prefix && (
            <span
              class:list={["section-stats__affix", { "js-stat-prefix": stat.isAnimated }]}
              style={stat.isAnimated ? "opacity:0;transform:translateY(4px)" : undefined}
            >
              {stat.prefix}
            </span>
          )}
          <span
            class:list={["section-stats__value", { "js-stat-counter": stat.isAnimated }]}
            data-numeric={stat.isAnimated ? String(stat.numericValue) : undefined}
            data-start={stat.isAnimated ? stat.startValue : undefined}
            data-prefix={stat.isAnimated ? (stat.prefix ?? "") : undefined}
            data-suffix={stat.isAnimated ? (stat.suffix ?? "") : undefined}
            data-decimals={stat.isAnimated ? String(stat.decimals ?? 0) : undefined}
            data-duration={stat.isAnimated ? String(stat.duration ?? 1.8) : undefined}
            style="font-variant-numeric: tabular-nums;"
          >
            {stat.isAnimated ? stat.startValue : stat.finalFormatted}
          </span>
          {stat.suffix && (
            <span
              class:list={[
                "section-stats__affix",
                "section-stats__affix--suffix",
                { "js-stat-suffix": stat.isAnimated },
              ]}
              style={stat.isAnimated ? "opacity:0;transform:translateY(4px)" : undefined}
            >
              {stat.suffix}
            </span>
          )}
        </div>
        <span class="section-stats__label">{stat.label}</span>
      </div>
    ))
  }
</div>
