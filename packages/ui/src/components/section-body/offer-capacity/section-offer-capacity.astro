---
/*
<MODULE_CONTRACT>
<purpose>Maintains packages/ui/src/components/section-body/offer-capacity/section-offer-capacity.astro as an authored ui component module so agents can evolve it without rediscovering local boundaries.</purpose>
<non-goals>
  <item>Do not fetch live private CRM data or imply availability through animation.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0322: add reusable capacity counter primitive.</item>
</CHANGE_SUMMARY>
*/

import type { OfferCapacityState } from "@gogol/share/offer-capacity";
import "./section-offer-capacity.css";

interface Props {
  state: OfferCapacityState;
  label: string;
  rangeLabel: string;
  unknownAvailabilityLabel: string;
  capacityLabel: string;
  currentWaveLabel: string;
  remainingLabel: string;
  daysRemainingText: string;
  openSlotsLabel: string;
}

const {
  state,
  label,
  rangeLabel,
  unknownAvailabilityLabel,
  capacityLabel,
  currentWaveLabel,
  remainingLabel,
  daysRemainingText,
  openSlotsLabel,
} = Astro.props as Props;
const hasOpenSlots = state.availabilityStatus !== "unknown" && typeof state.openSlots === "number";
---

<aside class="section-offer-capacity" aria-label={label} data-offer-capacity>
  <div class="section-offer-capacity__header">
    <span class="section-offer-capacity__label">{label}</span>
    <strong class="section-offer-capacity__wave">{state.waveId}</strong>
  </div>
  <div
    class="section-offer-capacity__meter"
    role="meter"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={state.progress}
    aria-label={`${label}: ${state.progress}%`}
  >
    <span class="section-offer-capacity__meter-fill" style={`width:${state.progress}%`}></span>
  </div>
  <dl class="section-offer-capacity__facts">
    <div>
      <dt>{capacityLabel}</dt>
      <dd>{rangeLabel}</dd>
    </div>
    <div>
      <dt>{currentWaveLabel}</dt>
      <dd>
        <time datetime={state.startsAt}>{state.startsAt}</time>
        {" - "}
        <time datetime={state.endsAt}>{state.endsAt}</time>
      </dd>
    </div>
    <div>
      <dt>{remainingLabel}</dt>
      <dd>{daysRemainingText}</dd>
    </div>
    <div>
      <dt>{openSlotsLabel}</dt>
      <dd>{hasOpenSlots ? state.openSlots : unknownAvailabilityLabel}</dd>
    </div>
  </dl>
</aside>
