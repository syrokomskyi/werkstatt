---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0103] Canonical body component for body.kind: "paragraphs". Renders a
  stack of paragraph elements bounded by the narrow content measure.
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import type { HorizontalAlign } from "@warpgogol/share";
import "./section-paragraphs.css";

interface Props {
  paragraphs: string[];
  align?: HorizontalAlign;
}

const { paragraphs, align = "left" } = Astro.props as Props;
---

<div class:list={["section-paragraphs", `section-paragraphs--align-${align}`]}>
  {paragraphs.map((p) => <p class="section-paragraphs__text">{p}</p>)}
</div>
