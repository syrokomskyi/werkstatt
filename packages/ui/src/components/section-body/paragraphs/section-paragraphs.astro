---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0103] Canonical body component for body.kind: "paragraphs". Renders a
  stack of paragraph elements bounded by the narrow content measure.
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import type { HorizontalAlign } from "@warpgogol/share";
import { parsePriceMarkers } from "../../../utils/price-marker.ts";
import { loadDerivedPrices } from "../../../sections/price-card/price-variants.ts";
import CurrencyAwarePriceDisplay from "../../currency-aware-price-display/currency-aware-price-display-component.astro";
import "./section-paragraphs.css";

interface Props {
  paragraphs: string[];
  align?: HorizontalAlign;
  lang?: string;
}

const { paragraphs, align = "left", lang = "de" } = Astro.props as Props;
const derivedPrices = loadDerivedPrices();
---

<div class:list={["section-paragraphs", `section-paragraphs--align-${align}`]}>
  {
    paragraphs.map((p) => (
      <p class="section-paragraphs__text">
        {parsePriceMarkers(p, lang, derivedPrices).map((part) =>
          part.kind === "text" ? (
            part.value
          ) : part.variants ? (
            <CurrencyAwarePriceDisplay priceVariants={part.variants} />
          ) : null,
        )}
      </p>
    ))
  }
</div>
