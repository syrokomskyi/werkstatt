---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0103 + RFC-0134] Canonical body component for body.kind: "comparison". Renders
  side-by-side rows with left/right cells, optional column labels, and row-level effects.
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
  <item>RFC-0134 replaces legacy surface prop with composable row effects.</item>
</CHANGE_SUMMARY>
*/

import { resolveEffectsForTarget } from "@gogol/share";
import type { HorizontalAlign, EffectAssignment } from "@gogol/share";
import EffectHost from "../../../components/effects/effect-host.astro";
import "./section-comparison.css";

interface Row {
  left: string;
  right: string;
}
interface Props {
  rows: Row[];
  labels?: { left: string; right: string };
  align?: HorizontalAlign;
  effects?: EffectAssignment[];
}

const { rows, labels, align = "left", effects } = Astro.props as Props;
const rowEffects = resolveEffectsForTarget(effects, "row");
---

<div class:list={["section-comparison", `section-comparison--align-${align}`]}>
  {
    labels && (
      <div class="section-comparison__labels">
        <div class="section-comparison__label section-comparison__label--left">{labels.left}</div>
        <div class="section-comparison__label section-comparison__label--right">{labels.right}</div>
      </div>
    )
  }
  <div class="section-comparison__grid">
    {
      rows.map((r) => (
        <EffectHost as="div" effects={rowEffects} class="section-comparison__row">
          <div class="section-comparison__cell section-comparison__cell--left">{r.left}</div>
          <div class="section-comparison__cell section-comparison__cell--right">{r.right}</div>
        </EffectHost>
      ))
    }
  </div>
</div>
