---
/* 
<MODULE_CONTRACT> 
<purpose>Facilitates the display of build provenance information in a structured format.</purpose> 
 
 
<non-goals> 
  <item>Do not manage data fetching beyond initial load of passport data.</item> 
  <item>Do not perform any data transformations or validations on the provenance data.</item> 
  <item>Do not handle routing or navigation logic related to provenance display.</item> 
</non-goals> 
</MODULE_CONTRACT> 
 
<CHANGE_SUMMARY>
  <item>Tidied by compass.changesummary.tidy; see git history for prior entries.</item>
</CHANGE_SUMMARY> 
*/

/**
 * PassportProvenance (Bianca) — Build provenance display moon
 *
 * Reads passport.json at build time via @warpgogol/passport/data and displays:
 * commit SHA, build timestamp, builder identity, and optionally the VC proof.
 *
 * RFC-0028 / DNA-31 / DNA-34 / Bianca (Uranus minor moon)
 */

import { loadPassportData } from "@warpgogol/passport/data";
import "./passport-provenance-component.css";

interface Props {
  showVC?: boolean;
}

const { showVC = false } = Astro.props;

const passport = await loadPassportData();
const prov = passport?.provenance;
---

<section class="passport-provenance" data-component="passport-provenance">
  <h2 class="passport-provenance__heading">Build Provenance</h2>

  {
    prov ? (
      <dl class="passport-provenance__list">
        <div class="passport-provenance__entry">
          <dt>Built at</dt>
          <dd>
            <time datetime={prov.builtAt}>{new Date(prov.builtAt).toLocaleString()}</time>
          </dd>
        </div>
        <div class="passport-provenance__entry">
          <dt>Commit</dt>
          <dd>
            <code class="passport-provenance__sha">{prov.commitSha.slice(0, 12)}</code>
          </dd>
        </div>
        <div class="passport-provenance__entry">
          <dt>Builder</dt>
          <dd>{prov.builder}</dd>
        </div>
        <div class="passport-provenance__entry">
          <dt>Key version</dt>
          <dd>{prov.keyVersion}</dd>
        </div>
        {showVC && (
          <div class="passport-provenance__entry passport-provenance__entry--vc">
            <dt>Verifiable Credential</dt>
            <dd>
              <details class="passport-provenance__vc-details">
                <summary>View VC proof</summary>
                <pre class="passport-provenance__vc-pre">
                  <code>{JSON.stringify(prov.verifiableCredential, null, 2)}</code>
                </pre>
              </details>
            </dd>
          </div>
        )}
      </dl>
    ) : (
      <p class="passport-provenance__unavailable">
        Provenance data unavailable — run passport.emit first.
      </p>
    )
  }
</section>
