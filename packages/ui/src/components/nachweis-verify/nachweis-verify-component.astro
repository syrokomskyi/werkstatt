---
/*
<MODULE_CONTRACT>
<purpose>
  NachweisVerify (Styx) — Cryptographic verification data display for a
  Nachweis record. Shows source SHA-256, public derivative SHA-256, record
  payload SHA-256, envelope SHA-256, operator signature, and qualified
  timestamp. Read-only. RFC-0708.
</purpose>
<non-goals>
  <item>Does not fetch data — receives all data via props from the page block.</item>
  <item>Does not perform verification — only displays verification data.</item>
  <item>Does not handle routing.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0708: initial implementation.</item>
</CHANGE_SUMMARY>
*/

/**
 * NachweisVerify (Styx) — trust verify component
 * RFC-0708 / DNA-17 / DNA-23 / WCAG 2.2 AA
 */

import "./nachweis-verify-component.css";

interface Props {
  slug: string;
  version: string;
  sourceSha256: string;
  publicDerivativeSha256?: string;
  recordPayloadSha256?: string;
  envelopeSha256?: string;
  operatorSignature?: string;
  qualifiedTimestamp?: string;
  verificationLevel?: string;
}

const {
  slug,
  version,
  sourceSha256,
  publicDerivativeSha256,
  recordPayloadSha256,
  envelopeSha256,
  operatorSignature,
  qualifiedTimestamp,
  verificationLevel,
} = Astro.props;

const headingId = `nachweis-verify-${slug}-${version}-title`;
---

<section class="nachweis-verify" data-component="nachweis-verify" aria-labelledby={headingId}>
  <h2 id={headingId} class="nachweis-verify__title">
    Kryptographische Verifikation — Version {version}
  </h2>

  <dl class="nachweis-verify__data">
    <div class="nachweis-verify__entry">
      <dt>Quell-Hash (SHA-256)</dt>
      <dd><code class="nachweis-verify__hash">{sourceSha256}</code></dd>
    </div>
    {publicDerivativeSha256 && (
      <div class="nachweis-verify__entry">
        <dt>Öffentliche Ableitung (SHA-256)</dt>
        <dd><code class="nachweis-verify__hash">{publicDerivativeSha256}</code></dd>
      </div>
    )}
    {recordPayloadSha256 && (
      <div class="nachweis-verify__entry">
        <dt>Datensatz-Hash (SHA-256)</dt>
        <dd><code class="nachweis-verify__hash">{recordPayloadSha256}</code></dd>
      </div>
    )}
    {envelopeSha256 && (
      <div class="nachweis-verify__entry">
        <dt>Umschlag-Hash (SHA-256)</dt>
        <dd><code class="nachweis-verify__hash">{envelopeSha256}</code></dd>
      </div>
    )}
    {verificationLevel && (
      <div class="nachweis-verify__entry">
        <dt>Prüfungsniveau</dt>
        <dd>{verificationLevel}</dd>
      </div>
    )}
    {qualifiedTimestamp && (
      <div class="nachweis-verify__entry">
        <dt>Qualifizierter Zeitstempel</dt>
        <dd>
          <time datetime={qualifiedTimestamp}>{qualifiedTimestamp}</time>
        </dd>
      </div>
    )}
    {operatorSignature && (
      <div class="nachweis-verify__entry">
        <dt>Operator-Signatur</dt>
        <dd><code class="nachweis-verify__hash">{operatorSignature}</code></dd>
      </div>
    )}
  </dl>
</section>
