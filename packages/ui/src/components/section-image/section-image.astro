---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0104] Canonical image primitive shared by every section that renders an
  authored image. Owns Astro <Image> integration, fade masks (top/bottom/left/right),
  and the optional data-parallax-speed hook for RFC-0106 GSAP parallax.
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import { resolveImage, resolveVideo } from "@gogol/share";
import type {
  AttributionDisplay,
  MaterialCredit,
  SectionImageProps,
  SectionImageParallaxProp,
} from "@gogol/share";
import ResponsiveImage from "../responsive-image/responsive-image.astro";
import LivePhoto from "../live-photo/live-photo.astro";
import "./section-image.css";

// RFC-0118: variant alias → numeric speed (mirrors RFC-0106 ParallaxVariant).
const PARALLAX_VARIANT_SPEED = { subtle: 0.2, balanced: 0.4, dramatic: 0.7 } as const;

function resolveParallaxSpeed(p: SectionImageParallaxProp | undefined): number | undefined {
  if (p === undefined || p === false) return undefined;
  if (p === true) return PARALLAX_VARIANT_SPEED.balanced;
  if (typeof p === "number") return p;
  if (typeof p === "object") {
    if (typeof p.speed === "number") return p.speed;
    const variant = p.variant ?? "balanced";
    const speed = PARALLAX_VARIANT_SPEED[variant as keyof typeof PARALLAX_VARIANT_SPEED];
    if (speed === undefined) {
      console.warn(
        `[section-image] Unknown parallax variant: "${variant}". Expected: ${Object.keys(PARALLAX_VARIANT_SPEED).join(", ")}.`,
      );
      return PARALLAX_VARIANT_SPEED.balanced;
    }
    return speed;
  }
  return undefined;
}

type Props = SectionImageProps & {
  class?: string;
  sizes?: string;
  credit?: MaterialCredit | null;
  creditDisplay?: AttributionDisplay;
  defaultLanguageCode?: string;
};

const {
  imageName,
  alt,
  fit = "cover",
  quality = "max",
  loading = "lazy",
  aspectRatio,
  fade,
  parallax = false,
  live,
  lang,
  defaultLanguageCode,
  subPath,
  class: extraClass = "",
  sizes,
  credit,
  creditDisplay,
} = Astro.props as Props;
const activeLang = lang ?? defaultLanguageCode;
if (!activeLang || !defaultLanguageCode) {
  throw new Error("[section-image] lang and defaultLanguageCode are required.");
}

import { contentAssetImages, contentAssetVideos } from "../../content-assets.ts";
import { getLiveVideoByToken } from "../../live-video-manifest.ts";
const images = contentAssetImages;
const imageMeta = resolveImage(images, imageName, { lang: activeLang, subPath });

// RFC-0202/0234: living photo when the author opted in AND a clip resolves.
// `live.media.validate` guards the live-without-clip case at build time; at render
// time a missing clip falls back to the static <ResponsiveImage> below.
//
// RFC-0234: the author ships ONE source clip (webm or mp4); live.variants.generate derives the
// cross-device set into the live-video manifest — desktop WebM + an iOS-playable MP4 for OPAQUE
// clips (an alpha clip stays poster-only on iOS). Prefer the generated manifest; fall back to
// authored sibling resolution (dev before build.prepare, or apps without a manifest).
const liveEnabled = !!live && live.enabled !== false && !!imageName;
const liveEntry = liveEnabled
  ? getLiveVideoByToken(imageName, activeLang, defaultLanguageCode)
  : null;
const liveVideoSrc = liveEnabled
  ? (liveEntry?.webm ?? resolveVideo(contentAssetVideos, imageName, { lang: activeLang, subPath }))
  : null;
const liveMp4VideoSrc = liveEnabled
  ? (liveEntry?.mp4 ??
    resolveVideo(contentAssetVideos, `${imageName}-animated-silent`, {
      lang: activeLang,
      subPath,
      extensions: [".mp4"],
    }))
  : null;

const inlineStyle = aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined;

const fadeClasses = fade
  ? [
      fade.top && "section-image--fade-top",
      fade.bottom && "section-image--fade-bottom",
      fade.left && "section-image--fade-left",
      fade.right && "section-image--fade-right",
    ].filter(Boolean)
  : [];

const fadeStyle = fade?.width
  ? `--section-image-fade-width: ${Math.round(fade.width * 100)}%;`
  : undefined;

const parallaxSpeed = resolveParallaxSpeed(parallax);
---

{
  imageMeta && (
    <div
      class:list={["section-image", `section-image--fit-${fit}`, ...fadeClasses, extraClass]}
      style={[inlineStyle, fadeStyle].filter(Boolean).join(" ") || undefined}
      data-parallax-speed={parallaxSpeed !== undefined ? String(parallaxSpeed) : undefined}
    >
      {live && liveVideoSrc ? (
        <LivePhoto
          image={imageMeta}
          videoSrc={liveVideoSrc}
          mp4VideoSrc={liveMp4VideoSrc ?? undefined}
          alt={alt}
          config={live}
          class="section-image__img"
          quality={quality}
          loading={loading}
          sizes={sizes}
        />
      ) : (
        <ResponsiveImage
          image={imageMeta}
          alt={alt}
          class="section-image__img"
          quality={quality}
          loading={loading}
          sizes={sizes}
          credit={credit}
          creditDisplay={creditDisplay}
          lang={activeLang}
          defaultLanguageCode={defaultLanguageCode}
        />
      )}
    </div>
  )
}
