---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0101 + RFC-0134] Canonical wrapper component for every shared section in @gogol/ui.
  Owns the outer <section> element, ARIA wiring, the container, background paint
  (color / image / texture / transparent / fade), optional section-level effects,
  density, tone, and the RFC-0106 motion reveal hook.
</purpose>
<non-goals>
  <item>Do not render any header, body, or CTA content directly — those are sibling components.</item>
  <item>Do not absorb the global SiteBackground (RFC-0105) — that is a separate shell-layer block.</item>
  <item>Do not perform image resolution inside the shell beyond bg image lookup; section images flow through <SectionImage> (RFC-0104).</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial creation per RFC-0101 step 1 — additive landing of the framework primitive.</item>
  <item>RFC-0134 routes section-level effects through the shared EffectHost primitive.</item>
</CHANGE_SUMMARY>
*/

import { resolveEffectsForTarget, resolveImage, type SectionShellProps } from "@gogol/share";
import EffectHost from "../effects/effect-host.astro";
import ResponsiveImage from "@gogol/ui/components/responsive-image.astro";
import "../section-header/section-header.css";
import "./section-shell.css";

type Props = SectionShellProps & { lang?: string };

const {
  slug,
  sectionId,
  ariaLabel,
  ariaLabelledBy,
  background,
  effects,
  density = "normal",
  tone = "default",
  containerVariant = "default",
  animated = "none",
  motion,
  lang,
} = Astro.props as Props;
if (!lang) {
  throw new Error("[section-shell] lang is required.");
}

const motionOff = motion?.off === true;
const revealVariant = motionOff
  ? undefined
  : (motion?.reveal?.variant ?? (animated === "reveal" ? "fade-up" : undefined));
const revealThreshold = motion?.reveal?.threshold;
const revealOnce = motion?.reveal?.once;
const staggerDelay = motionOff ? undefined : motion?.stagger?.delay;
const staggerChild = motion?.stagger?.childSelector;

const bg = background ?? { kind: "color" as const };
const sectionEffects = resolveEffectsForTarget(effects, "section");

import { contentAssetImages } from "../../content-assets.ts";
const images = contentAssetImages;
const bgImage = bg.kind === "image" ? resolveImage(images, bg.imageName, { lang }) : null;

const qualityMap = { low: 30, mid: 60, high: 80, max: 100 } as const;
const bgQuality = bg.kind === "image" ? qualityMap[bg.quality ?? "high"] : 80;
const bgFitClass = bg.kind === "image" ? `section-shell__bg-image--${bg.fit ?? "cover"}` : "";

const fadeVars: string[] = [];
if (bg.kind === "fade") {
  const direction = bg.direction === "horizontal" ? "to right" : "to bottom";
  const from = bg.from ?? "var(--ds-color-bg)";
  const to = bg.to ?? "var(--ds-color-bg)";
  const startOpacity = bg.noStartFade ? 1 : (bg.startOpacity ?? 1);
  const endOpacity = bg.noEndFade ? 1 : (bg.endOpacity ?? 1);
  fadeVars.push(`--shell-fade-direction: ${direction};`);
  fadeVars.push(`--shell-fade-from: ${from};`);
  fadeVars.push(`--shell-fade-to: ${to};`);
  fadeVars.push(`--shell-fade-start-opacity: ${startOpacity};`);
  fadeVars.push(`--shell-fade-end-opacity: ${endOpacity};`);
}

const colorVar = bg.kind === "color" && bg.color ? `--shell-bg-color: ${bg.color};` : "";

const imageTintVar =
  bg.kind === "image" && typeof bg.tintOpacity === "number"
    ? `--shell-bg-tint-opacity: ${bg.tintOpacity};`
    : "";

const textureVar =
  bg.kind === "texture"
    ? bg.texture === "noise"
      ? `--shell-bg-texture: var(--ds-image-texture-noise);`
      : `--shell-bg-texture: url("${bg.texture}");`
    : "";

const transparentOpacityVar =
  bg.kind === "transparent" && typeof bg.opacity === "number"
    ? `--shell-transparent-opacity: ${bg.opacity};`
    : "";

const inlineStyle =
  [colorVar, imageTintVar, textureVar, transparentOpacityVar, ...fadeVars]
    .filter(Boolean)
    .join(" ") || undefined;
---

<EffectHost
  as="section"
  effects={sectionEffects}
  class:list={[
    "section-shell",
    `section-shell--bg-${bg.kind}`,
    `section-shell--density-${density}`,
    `section-shell--tone-${tone}`,
    `section-shell--container-${containerVariant}`,
  ]}
  data-slug={slug}
  data-density={density}
  data-tone={tone}
  data-bg-kind={bg.kind}
  data-motion-reveal={revealVariant ? "true" : undefined}
  data-motion-reveal-variant={revealVariant}
  data-motion-reveal-threshold={revealThreshold !== undefined ? String(revealThreshold) : undefined}
  data-motion-reveal-once={revealOnce === false ? "false" : undefined}
  data-motion-stagger={staggerDelay !== undefined ? "true" : undefined}
  data-motion-stagger-delay={staggerDelay !== undefined ? String(staggerDelay) : undefined}
  data-motion-stagger-child={staggerChild}
  id={sectionId}
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledBy}
  style={inlineStyle}
>
  {
    bg.kind === "image" && bgImage && (
      <div class:list={["section-shell__bg-image-wrap", bgFitClass]} aria-hidden="true">
        <ResponsiveImage
          image={bgImage}
          alt=""
          class="section-shell__bg-image"
          loading="lazy"
          lang={lang}
        />
        <div class="section-shell__bg-tint" />
      </div>
    )
  }
  <div class="section-shell__container">
    <slot />
  </div>
</EffectHost>
