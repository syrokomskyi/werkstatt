---
/*
<MODULE_CONTRACT>
<purpose>Renders a single-button language switcher that shows the current language and cycles to the next one on click.</purpose>
<non-goals>
  <item>Do not read Astro.url inside this component — keep it testable and portable.</item>
  <item>Do not hardcode visitor-facing strings — all copy comes from content.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0002: Initial creation of lang-switcher component.</item>
  <item>Refactor: single-button cycle mode — show current lang, click → next lang.</item>
  <item>Complete three-way mirroring: load aria-label from content instead of hardcoding.</item>
</CHANGE_SUMMARY>
*/

import { getResolvedComponentContent } from "@gogol/share";
import { localizeUrl } from "@gogol/share/astro/url-policy";
import type { LangSwitcherComponentContent } from "@gogol/ui/components/lang-switcher/types";
import { loadVendorIcon } from "../../icons/icon-resolver.ts";
import "./lang-switcher-component.css";

const ArrowCircleRoundAltHoverIcon = await loadVendorIcon({
  vendor: "lordicon",
  collection: "doodle-outline",
  name: "ArrowCircleRoundAltHover",
});

interface Props {
  lang: string;
  currentPath: string;
  supportedLangs: string[];
  localizedSiblingPath?: string;
  getLocalizedUrl?: (path: string, lang: string) => string;
  /** RFC-0048: Function to get proper sibling URL with localized slug */
  getLocalizedSiblingPath?: (path: string, lang: string) => Promise<string> | string;
  defaultLanguage?: string;
  pageOverride?: Partial<LangSwitcherComponentContent>;
}

const {
  lang,
  currentPath,
  supportedLangs,
  localizedSiblingPath,
  getLocalizedUrl,
  getLocalizedSiblingPath,
  defaultLanguage,
  pageOverride,
} = Astro.props as Props;

if (!defaultLanguage) {
  throw new Error("[lang-switcher] defaultLanguage is required.");
}

const content = await getResolvedComponentContent<LangSwitcherComponentContent>({
  componentPath: "lang-switcher",
  languageCode: lang,
  defaultLanguageCode: defaultLanguage,
  pageOverride,
});

const langs = supportedLangs;
const currentIndex = langs.indexOf(lang);
const nextLang = langs[(currentIndex + 1) % langs.length] ?? langs[0]!;

// RFC-0048: Use getLocalizedSiblingPath if available for proper localized slugs
let nextUrl: string;
if (localizedSiblingPath) {
  nextUrl = localizedSiblingPath;
} else if (getLocalizedSiblingPath) {
  nextUrl = await getLocalizedSiblingPath(currentPath, nextLang);
} else if (getLocalizedUrl) {
  nextUrl = getLocalizedUrl(currentPath, nextLang);
} else if (defaultLanguage) {
  nextUrl = localizeUrl(nextLang, "", { defaultLanguage });
} else {
  nextUrl = `/${nextLang}/`;
}

const ariaLabel = content.switchAriaLabel
  .replace("{currentLang}", lang.toUpperCase())
  .replace("{lang}", nextLang.toUpperCase());
---

<a href={nextUrl} class="lang-switcher__link" hreflang={nextLang} aria-label={ariaLabel}>
  <span class="lang-switcher__lang-text">{lang.toUpperCase()}</span>
  <ArrowCircleRoundAltHoverIcon class="lang-switcher__nav-icon" size={33} />
</a>
