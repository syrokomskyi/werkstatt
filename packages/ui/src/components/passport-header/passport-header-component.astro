---
/*
<MODULE_CONTRACT>
<purpose>
  PassportHeader (Methone) — Cosmic Passport header moon.
  Displays the app's identity: title, subtitle (app name), and a
  Cosmic Passport label badge. Reads no runtime data; props come from
  the page block declaration.
  Emits "passport-view" growth event on mount (DNA-27 / RFC-0028).
</purpose>
<non-goals>
  <item>Do not fetch runtime data beyond passport metadata.</item>
  <item>Do not handle user interactions — display only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Initial implementation as Methone moon for RFC-0028 passport system.</item>
  <item>Added growth event emission for passport-view tracking.</item>
</CHANGE_SUMMARY>
*/

import { loadPassportData } from "@gogol/passport/data";
import "./passport-header-component.css";

interface Props {
  title: string;
  subtitle?: string;
  badgeLabel?: string;
}

const { title, subtitle, badgeLabel } = Astro.props;

const passport = await loadPassportData();
const appId = passport?.appId ?? subtitle ?? "unknown";
const nebulaScore = passport?.nebulaScore?.composite ?? undefined;
---

<header class="passport-header" data-component="passport-header">
  <div class="passport-header__badge">
    <span class="passport-header__icon" aria-hidden="true">🌟</span>
    <span class="passport-header__label">{badgeLabel}</span>
  </div>
  <h1 class="passport-header__title">{title}</h1>
  {subtitle && <p class="passport-header__subtitle">{subtitle}</p>}
</header>

<script define:vars={{ appId, nebulaScore }}>
  // Emit passport-view growth event after page hydration.
  // Uses window.__webgogol_emit__ if the growth layer is active; no-ops otherwise.
  (function () {
    function tryEmit() {
      const emitFn = window.__webgogol_emit__;
      if (typeof emitFn !== "function") return;
      const payload = { appId };
      if (typeof nebulaScore === "number") payload.nebulaScore = nebulaScore;
      emitFn("passport-view", payload);
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", tryEmit, { once: true });
    } else {
      tryEmit();
    }
  })();
</script>
