---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0174] Mandatory language notice + persistent "unofficial translation"
  indicator for non-binding renders of legal documents. Rendered by the shared
  layout for any page whose resolved translationContext requests it. The notice
  states the page is an unofficial translation, names the binding language,
  declares that the binding version prevails on any discrepancy, and links to the
  vetted binding document. Copy is shown in the page language AND repeated in the
  binding language (German).
</purpose>
<non-goals>
  <item>Do not decide whether to show — the resolver (translationContext) already did.</item>
  <item>Do not fetch content — all inputs arrive as props.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0174: initial translation-notice legal chrome component.</item>
</CHANGE_SUMMARY>
*/

interface Props {
  pageLang: string;
  bindingLang: string;
  bindingUrl: string;
  bindingDocLabel?: string;
  showNotice: boolean;
  showIndicator: boolean;
}

const { pageLang, bindingLang, bindingUrl, bindingDocLabel, showNotice, showIndicator } =
  Astro.props as Props;

// Localized microcopy for the page-language line. Falls back to English. The
// binding-language paragraph below is always German-first via BINDING_LINE.
type NoticeCopy = { intro: string; before: string; after: string; badge: string; hint: string };

const PAGE_COPY: Record<string, NoticeCopy> = {
  en: {
    intro: "Language notice.",
    before:
      "This page is an unofficial translation. Only the following version is legally binding:",
    after: "In case of any discrepancies or ambiguity, that version prevails.",
    badge: "Unofficial translation",
    hint: "This page is a simplified service translation, not the legally binding text.",
  },
  uk: {
    intro: "Примітка щодо мови.",
    before: "Ця сторінка є неофіційним перекладом. Юридично обов'язковою є виключно версія:",
    after: "У разі будь-яких розбіжностей або двозначностей вирішальною є саме ця версія.",
    badge: "Неофіційний переклад",
    hint: "Ця сторінка — спрощений сервісний переклад, а не юридично обов'язковий текст.",
  },
  de: {
    intro: "Hinweis zur Sprache.",
    before:
      "Diese Seite ist eine inoffizielle Übersetzung. Rechtlich verbindlich ist ausschließlich:",
    after: "Bei Abweichungen oder Mehrdeutigkeiten gilt diese Fassung vorrangig.",
    badge: "Inoffizielle Übersetzung",
    hint: "Diese Seite ist eine vereinfachte Servicefassung, nicht der rechtlich verbindliche Text.",
  },
};

const copy = PAGE_COPY[pageLang] ?? PAGE_COPY.en!;
const linkLabel = bindingDocLabel ?? copy.before;

// The binding-language (German) paragraph, always repeated per the lawyer's
// dual-language recommendation. When the page itself is German this is omitted
// (the page-language copy is already German).
const showBindingParagraph = bindingLang === "de" && pageLang !== "de";
const BINDING_LINE =
  "Hinweis zur Sprache: Diese Seite ist eine inoffizielle Übersetzung. Rechtlich verbindlich ist ausschließlich die deutschsprachige Fassung. Bei Abweichungen gilt die deutschsprachige Fassung.";
---

{
  (showNotice || showIndicator) && (
    <div class="translation-chrome">
      {showIndicator && (
        <div class="translation-indicator" tabindex="0" role="status" aria-label={copy.hint}>
          <span class="translation-indicator__dot" aria-hidden="true" />
          <span>{copy.badge}</span>
          <span class="translation-indicator__hint" role="tooltip">
            {copy.hint}
          </span>
        </div>
      )}
      {showNotice && (
        <aside class="translation-notice" role="note" aria-label={copy.intro}>
          <span class="translation-notice__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 9v4" />
              <path d="M12 17h.01" />
              <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
            </svg>
          </span>
          <div class="translation-notice__body">
            <p class="translation-notice__line">
              <strong>{copy.intro}</strong> {copy.before}{" "}
              {bindingUrl ? (
                <a href={bindingUrl} class="translation-notice__link">
                  {linkLabel}
                </a>
              ) : (
                <span>{linkLabel}</span>
              )}
              . {copy.after}
            </p>
            {showBindingParagraph && (
              <p class="translation-notice__line translation-notice__de">{BINDING_LINE}</p>
            )}
          </div>
        </aside>
      )}
    </div>
  )
}

<style>
  .translation-chrome {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 68ch;
    margin: 1.5rem auto 0.5rem;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }

  .translation-indicator {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, #c47f17 14%, white);
    color: #7a5210;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: help;
  }
  .translation-indicator__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #c47f17;
    flex: none;
  }
  .translation-indicator__hint {
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 30ch;
    padding: 0.55rem 0.75rem;
    border-radius: 0.5rem;
    background: #1f2937;
    color: #fff;
    font-size: 0.74rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease;
    pointer-events: none;
    z-index: 20;
  }
  .translation-indicator:hover .translation-indicator__hint,
  .translation-indicator:focus-visible .translation-indicator__hint,
  .translation-indicator:focus-within .translation-indicator__hint {
    opacity: 1;
    visibility: visible;
  }

  .translation-notice {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    width: 100%;
    padding: 0.9rem 1.1rem;
    border: 1px solid color-mix(in srgb, #c47f17 25%, transparent);
    border-left: 3px solid #c47f17;
    border-radius: 0.7rem;
    background: color-mix(in srgb, #f5b942 10%, white);
    color: #4a3a1c;
    font-size: 0.9rem;
    line-height: 1.55;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }
  .translation-notice__icon {
    display: inline-flex;
    color: #c47f17;
    margin-top: 0.1rem;
    flex: none;
  }
  .translation-notice__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .translation-notice__line {
    margin: 0;
  }
  .translation-notice__de {
    opacity: 0.72;
    font-size: 0.82rem;
  }
  .translation-notice__link {
    color: #9a6310;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .translation-notice__link:hover {
    color: #7a5210;
  }
</style>
