---
/*
<MODULE_CONTRACT>
<purpose>Dynamic status indicator section — renders a single data-driven value with label and optional context. RFC-0758 bodyKind: composite.</purpose>
<non-goals>
  <item>Do not add app-specific logic; shared sections are composition-only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Generated by section.scaffold with Compass markers (RFC-0155).</item>
  <item>RFC-0758: Customized composite template for data-driven status indicator.</item>
</CHANGE_SUMMARY>
*/

import type { SectionProps } from "@warpgogol/share/page";
import { need, cast, resolveSectionAnchor } from "@warpgogol/share";
import SectionShell from "@warpgogol/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/ui/components/section-header.astro";
import type { DynamicStatusBlockSectionContent } from "./dynamic-status-block-section.types.generated.ts";
import "./dynamic-status-block-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "dynamic-status-block");
const props = cast<DynamicStatusBlockSectionContent>(pageOverride);

const isNumeric = typeof props.value === "number";
const numericValue = isNumeric ? (props.value as number) : Number(props.value);
const isAnimated = props.animated === true && !isNaN(numericValue);
---

<SectionShell
  slug="dynamic-status-block"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="dynamic-status-block-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <SectionHeader
    sectionNumber={sectionNumber}
    heading={need("header.heading", props.header?.heading)}
    subheading={props.header?.subheading}
    align={props.header?.align ?? "left"}
    level={props.header?.level ?? 2}
    hideSectionNumber={props.header?.hideSectionNumber}
    id="dynamic-status-block-title"
  />
  <div
    class="dynamic-status-block__body"
    data-value-tone={props.valueTone ?? "default"}
    data-animated={isAnimated ? "true" : undefined}
  >
    <div class="dynamic-status-block__stat">
      {
        props.valuePrefix && (
          <span class="js-stat-prefix dynamic-status-block__prefix">{props.valuePrefix}</span>
        )
      }
      <span
        class="dynamic-status-block__value js-stat-counter"
        data-numeric={isAnimated ? String(numericValue) : undefined}
        data-start={isAnimated ? "0" : undefined}>{String(props.value)}</span
      >
      {
        props.valueSuffix && (
          <span class="js-stat-suffix dynamic-status-block__suffix">{props.valueSuffix}</span>
        )
      }
    </div>
    <span class="dynamic-status-block__label">{need("label", props.label)}</span>
    {props.contextText && <p class="dynamic-status-block__context">{props.contextText}</p>}
  </div>
</SectionShell>
