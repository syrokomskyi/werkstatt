---
/* <MODULE_CONTRACT>
<purpose>RFC-0504: Article header section — renders title (H1), category, summary,
articleType, author name, review date, and read time as a metadata-rich header
for ratgeber articles.</purpose>
<non-goals>
  <item>Do not render the article body or TOC — those are separate blocks.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0504: initial implementation — article-header section for ratgeber 12-section layout.</item>
</CHANGE_SUMMARY> */

import "./article-header-section.css";
import type { SectionProps } from "@warpgogol/share/page";

const rawProps = (Astro.props as SectionProps) ?? {};
const p = (rawProps.pageOverride ?? {}) as Record<string, any>;
const heading: string = p.header?.heading ?? "";
const headingLevel: number = p.header?.level ?? 1;
const category: string | undefined = p.category;
const summary: string | undefined = p.summary;
const articleType: string | undefined = p.articleType;
const authorName: string | undefined = p.authorName;
const reviewedAt: string | undefined = p.reviewedAt;
const readTime: string | undefined = p.readTime;
---

<section class="article-header-section" data-article-type={articleType}>
  {category && <span class="article-header-category">{category}</span>}
  {
    headingLevel === 1 ? (
      <h1 class="article-header-title">{heading}</h1>
    ) : (
      <h2 class="article-header-title">{heading}</h2>
    )
  }
  {summary && <p class="article-header-summary">{summary}</p>}
  {
    (authorName || reviewedAt || readTime) && (
      <div class="article-header-meta">
        {authorName && <span class="article-header-author">{authorName}</span>}
        {reviewedAt && <span class="article-header-reviewed">{reviewedAt}</span>}
        {readTime && <span class="article-header-readtime">{readTime}</span>}
      </div>
    )
  }
</section>
