---
/* <MODULE_CONTRACT>
<purpose>RFC-0504: Changelog section — renders editorial history entries
(date, summary, authorId) from the article frontmatter.</purpose>
<non-goals>
  <item>Do not render provenance footer — that is a separate block (RFC-0502).</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0504: initial implementation — changelog section for ratgeber 12-section layout.</item>
</CHANGE_SUMMARY> */

import "./changelog-section.css";
import type { SectionProps } from "@warpgogol/share/page";

const rawProps = (Astro.props as SectionProps) ?? {};
interface ChangelogOverride {
  entries?: Array<{ date: string; summary: string; authorId: string }>;
}
const p = (rawProps.pageOverride ?? {}) as ChangelogOverride;
const entries: Array<{ date: string; summary: string; authorId: string }> = Array.isArray(p.entries)
  ? p.entries
  : [];
---

{
  entries.length > 0 && (
    <section class="changelog-section">
      <ul class="changelog-list">
        {entries.map((entry) => (
          <li class="changelog-item">
            <time class="changelog-date" datetime={entry.date}>
              {entry.date}
            </time>
            <span class="changelog-summary">{entry.summary}</span>
            <span class="changelog-author">{entry.authorId}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
