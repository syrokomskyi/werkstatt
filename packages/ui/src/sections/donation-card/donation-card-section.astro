import { getEntry } from "astro:content";
import type { SectionProps } from "@warpgogol/share/page";
import { cast } from "@warpgogol/share";
import type { DonationCardSectionContent } from "./donation-card-section.types.generated.ts";
import SectionShell from "@warpgogol/ui/components/section-shell.astro";
import DonationCard from "@warpgogol/ui/components/donation-card/donation-card-component.astro";
import "./donation-card-section.css";

interface DonationCardBusinessData {
  companyName: string;
  bankName: string;
  iban: string;
  bic: string;
  konto: string;
  blz: string;
  trustIndicators: string[];
}

const { lang, pageOverride } = Astro.props as SectionProps;
const props = cast<DonationCardSectionContent>(pageOverride);

const legalEntry =
  (await getEntry("site", `${lang}/legal`)) ?? (await getEntry("site", "de/legal"));
const legalData = legalEntry?.data as
  | {
      companyName?: string;
      bank?: { bankName?: string; iban?: string; bic?: string; konto?: string; blz?: string };
      donationTrustIndicators?: string[];
    }
  | undefined;
const override = pageOverride as Partial<DonationCardBusinessData>;
const componentContent: DonationCardBusinessData = {
  companyName: override.companyName ?? legalData?.companyName ?? "NEED_THIS_COMPANY_NAME",
  bankName: override.bankName ?? legalData?.bank?.bankName ?? "NEED_THIS_BANK_NAME",
  iban: override.iban ?? legalData?.bank?.iban ?? "NEED_THIS_IBAN",
  bic: override.bic ?? legalData?.bank?.bic ?? "NEED_THIS_BIC",
  konto: override.konto ?? legalData?.bank?.konto ?? "NEED_THIS_KONTO",
  blz: override.blz ?? legalData?.bank?.blz ?? "NEED_THIS_BLZ",
  trustIndicators: override.trustIndicators ?? legalData?.donationTrustIndicators ?? [],
};
---

<SectionShell
  slug="donation-card"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  containerVariant="narrow"
  lang={lang}
>
  <DonationCard
    lang={lang}
    content={props.labels}
    companyName={componentContent.companyName}
    bankName={componentContent.bankName}
    iban={componentContent.iban}
    bic={componentContent.bic}
    konto={componentContent.konto}
    blz={componentContent.blz}
    trustIndicators={componentContent.trustIndicators}
  />
</SectionShell>
