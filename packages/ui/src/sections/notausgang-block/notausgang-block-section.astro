---
/*
<MODULE_CONTRACT>
<purpose>Defines a Notausgang block section that displays a header, a list of items, and an optional call-to-action.</purpose>
<non-goals>
  <item>Do not handle data fetching or state management.</item>
  <item>Do not implement navigation logic outside of section anchoring.</item>
  <item>Do not modify global styles or themes.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Enhance file documentation for clarity and maintainability.</item>
  <item>Pass surface prop from body to SectionList for glass effects.</item>
</CHANGE_SUMMARY>
*/

/* RFC-0103: notausgang-block thin dispatcher — list body + optional CTA. */

import type { SectionProps } from "@warpgogol/share/page";
import { cast, need, resolveSectionAnchor, resolveSemanticTarget } from "@warpgogol/share";
import SectionShell from "@warpgogol/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/ui/components/section-header.astro";
import SectionList from "@warpgogol/ui/components/section-body/list/section-list.astro";
import type { NotausgangBlockSectionContent } from "./notausgang-block-section.types.generated.ts";
import "./notausgang-block-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "notausgang");
const props = cast<NotausgangBlockSectionContent>(pageOverride);
const body = need("body", props.body) as {
  kind: "list";
  items: any[];
  note?: string;
  iconColor?: string;
  align?: string;
  itemAlign?: string;
  hideMarkers?: boolean;
  effects?: any[];
};
const ctaAlign = props.header?.align ?? "left";

let ctaHref: string | null = null;
if (props.cta?.target) {
  if (props.cta.target.startsWith("#")) {
    ctaHref = props.cta.target;
  } else {
    ctaHref = await resolveSemanticTarget({ kind: "internal", pageId: props.cta.target }, lang);
  }
}
---

<SectionShell
  slug="notausgang-block"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="notausgang-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone ?? "warning"}
  lang={lang}
>
  <SectionHeader
    sectionNumber={sectionNumber}
    heading={need("header.heading", props.header?.heading)}
    subheading={props.header?.subheading}
    align={props.header?.align ?? "left"}
    level={props.header?.level ?? 2}
    hideSectionNumber={props.header?.hideSectionNumber}
    id="notausgang-title"
    lang={lang}
  />
  <SectionList
    items={body.items ?? []}
    note={body.note}
    iconColor={(body.iconColor as
      "error" | "success" | "primary" | "accent" | "warning" | "muted" | undefined) ?? "warning"}
    align={body.align as "left" | "center" | "right" | undefined}
    itemAlign={body.itemAlign as "left" | "center" | "right" | undefined}
    hideMarkers={body.hideMarkers}
    effects={body.effects}
    lang={lang}
  />
  {
    props.cta && ctaHref && (
      <div
        class:list={["notausgang-block__cta-wrap", `notausgang-block__cta-wrap--align-${ctaAlign}`]}
      >
        <a class="notausgang-block__cta" href={ctaHref}>
          {props.cta.label}
        </a>
      </div>
    )
  }
</SectionShell>
