---
/*
<MODULE_CONTRACT>
<purpose>Price card composite — price tiers + included features list via SectionShell + SectionHeader.</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
  <item>RFC-0134 replaces legacy surface and glass props with composable effects.</item>
</CHANGE_SUMMARY>
*/

import { readFileSync } from "node:fs";
import { join } from "node:path";
import type { SectionProps } from "@warpgogol/share/page";
import {
  cast,
  getSiteSectionLabels,
  need,
  resolveEffectsForTarget,
  resolveSectionAnchor,
} from "@warpgogol/share";
import { formatRecurrence } from "@warpgogol/share/formula-eval";
import SectionShell from "@warpgogol/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/ui/components/section-header.astro";
import EffectHost from "../../components/effects/effect-host.astro";
import CurrencyAwarePriceDisplay from "../../components/currency-aware-price-display/currency-aware-price-display-component.astro";
import { loadVendorIcon } from "../../icons/icon-resolver.ts";
import type { PriceCardSectionContent } from "./price-card-section.types.generated.ts";
import "./price-card-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "price-card");
const props = cast<PriceCardSectionContent>(pageOverride);
const panelEffects = resolveEffectsForTarget(props.effects, "panel");
const siteLabels = await getSiteSectionLabels<Record<string, unknown>>(
  lang,
  Astro.props.defaultLanguageCode,
  "priceCard",
);
const monthlyLabel = need(
  "sections.priceCard.monthly",
  typeof siteLabels?.monthly === "string" ? siteLabels.monthly : undefined,
);
const yearlyLabel = need(
  "sections.priceCard.yearly",
  typeof siteLabels?.yearly === "string" ? siteLabels.yearly : undefined,
);
const setupLabel = need(
  "sections.priceCard.setup",
  typeof siteLabels?.setup === "string" ? siteLabels.setup : undefined,
);
const includesHeading = need(
  "sections.priceCard.includesHeading",
  typeof siteLabels?.includesHeading === "string" ? siteLabels.includesHeading : undefined,
);

const resolvedIncludes = await Promise.all(
  (props.includes ?? []).map(async (item) => {
    const Icon = await loadVendorIcon(item.icon);
    return { text: item.text, Icon, iconConfig: item.icon };
  }),
);

function formatPrice(
  prop: { amount?: string; currency?: string; recurrence?: string } | undefined,
  lang: string,
): string {
  if (!prop || !prop.amount || prop.amount.trim() === "") return "";
  const numericAmount = Number(prop.amount);
  if (!Number.isFinite(numericAmount)) return "";
  const currency = prop.currency ?? "EUR";
  const formatted = new Intl.NumberFormat(lang, {
    style: "currency",
    currency,
    currencyDisplay: "narrowSymbol",
    minimumFractionDigits: 0,
    maximumFractionDigits: 2,
  }).format(numericAmount);
  const suffix = formatRecurrence(prop.recurrence, lang);
  return suffix ? `${formatted}\u00A0${suffix}` : formatted;
}

interface DerivedPriceEntry {
  chargeRef: string;
  targetCurrency: string;
  amount: { value: string; currency: string };
  trace: {
    source: { amount: string; currency: string };
    rate: { value: string; pair: string };
  };
}

const NOTE_TEMPLATES: Record<string, string> = {
  de: "Preis berechnet nach Kurs 1 EUR = {rate} {currency}.",
  uk: "\u0426\u0456\u043d\u0430 \u0440\u043e\u0437\u0440\u0430\u0445\u043e\u0432\u0430\u043d\u0430 \u0437\u0430 \u043a\u0443\u0440\u0441\u043e\u043c 1 EUR = {rate} {currency}.",
};

function loadDerivedPrices(): Record<string, DerivedPriceEntry[]> | null {
  try {
    const filePath = join(process.cwd(), "src", "derived-prices.generated.json");
    const raw = readFileSync(filePath, "utf-8");
    return JSON.parse(raw) as Record<string, DerivedPriceEntry[]>;
  } catch {
    return null;
  }
}

const derivedPrices = loadDerivedPrices();
const offeringRef = (pageOverride as Record<string, unknown>).offeringRef as string | undefined;

function buildPriceVariants(
  sourceProp: { amount?: string; currency?: string; recurrence?: string } | undefined,
  chargeRef: string,
  lang: string,
): Array<{ currency: string; formatted: string; note: string | null }> | null {
  if (!offeringRef || !derivedPrices || !sourceProp) return null;
  const entries = derivedPrices[offeringRef];
  if (!entries) return null;
  const matching = entries.filter((e) => e.chargeRef === chargeRef);
  if (matching.length === 0) return null;

  const variants: Array<{ currency: string; formatted: string; note: string | null }> = [];

  const sourceCurrency = sourceProp.currency ?? "EUR";
  const sourceFormatted = formatPrice(sourceProp, lang);
  if (sourceFormatted) {
    variants.push({ currency: sourceCurrency, formatted: sourceFormatted, note: null });
  }

  const noteTemplate = NOTE_TEMPLATES[lang] ?? NOTE_TEMPLATES["de"];

  for (const entry of matching) {
    const numericAmount = Number(entry.amount.value);
    if (!Number.isFinite(numericAmount)) continue;
    const formatted = new Intl.NumberFormat(lang, {
      style: "currency",
      currency: entry.amount.currency,
      currencyDisplay: "narrowSymbol",
      minimumFractionDigits: 0,
      maximumFractionDigits: 2,
    }).format(numericAmount);
    const suffix = formatRecurrence(sourceProp.recurrence, lang);
    const formattedWithSuffix = suffix ? `${formatted}\u00A0${suffix}` : formatted;
    const note = noteTemplate
      .replace("{rate}", entry.trace.rate.value)
      .replace("{currency}", entry.amount.currency);
    variants.push({
      currency: entry.amount.currency,
      formatted: formattedWithSuffix,
      note,
    });
  }

  return variants.length > 1 ? variants : null;
}

const monthlyPrice = formatPrice(props.monthly, lang);
const yearlyPrice = formatPrice(props.yearly, lang);
const setupPrice = formatPrice(props.setup, lang);

const monthlyVariants = buildPriceVariants(props.monthly, "monthlySubscription", lang);
const yearlyVariants = buildPriceVariants(props.yearly, "yearlySubscription", lang);
const setupVariants = buildPriceVariants(props.setup, "activation", lang);
---

<SectionShell
  slug="price-card"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="price-card-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <SectionHeader
    sectionNumber={sectionNumber}
    heading={need("header.heading", props.header?.heading)}
    subheading={props.header?.subheading}
    align={props.header?.align ?? "left"}
    level={props.header?.level ?? 2}
    hideSectionNumber={props.header?.hideSectionNumber}
    id="price-card-title"
  />

  <EffectHost as="div" effects={panelEffects} class="price-card__panel price-card__panel-surface">
    <dl class="price-card__prices">
      {
        monthlyPrice && (
          <>
            <dt>{monthlyLabel}</dt>
            <dd>
              {monthlyVariants ? (
                <CurrencyAwarePriceDisplay priceVariants={monthlyVariants} />
              ) : (
                monthlyPrice
              )}
            </dd>
          </>
        )
      }
      {
        yearlyPrice && (
          <>
            <dt>{yearlyLabel}</dt>
            <dd>
              {yearlyVariants ? (
                <CurrencyAwarePriceDisplay priceVariants={yearlyVariants} />
              ) : (
                yearlyPrice
              )}
            </dd>
          </>
        )
      }
      {
        setupPrice && (
          <>
            <dt>{setupLabel}</dt>
            <dd>
              {setupVariants ? (
                <CurrencyAwarePriceDisplay priceVariants={setupVariants} />
              ) : (
                setupPrice
              )}
            </dd>
          </>
        )
      }
    </dl>
    {
      props.includes && (
        <div class="price-card__includes">
          <h3>{includesHeading}</h3>
          <ul>
            {resolvedIncludes.map(({ text, Icon, iconConfig }) => (
              <li>
                {Icon ? (
                  <Icon
                    size={iconConfig?.size ?? 24}
                    color="success"
                    trigger="hover"
                    aria-label=""
                  />
                ) : (
                  <span class="price-card__marker" aria-hidden="true" />
                )}
                <span>{text}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </EffectHost>
</SectionShell>
