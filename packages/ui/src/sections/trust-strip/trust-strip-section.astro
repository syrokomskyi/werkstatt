---
/*
<MODULE_CONTRACT>
<purpose>Defines the structure and rendering logic for a trust strip section, emphasizing a list of trust signals.</purpose>
<non-goals>
  <item>Do not handle user interaction state management.</item>
  <item>Do not perform data fetching or parsing beyond the provided props.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Added Compass scaffolding to improve code clarity and facilitate future modifications.</item>
  <item>Pass surface prop from body to SectionList for glass effects.</item>
</CHANGE_SUMMARY>
*/

/* RFC-0103: trust-strip thin dispatcher — optional header + list body. */

import type { SectionProps } from "@warpgogol/share/page";
import { cast, need, resolveSemanticTarget } from "@warpgogol/share";
import SectionShell from "@warpgogol/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/ui/components/section-header.astro";
import SectionList from "@warpgogol/ui/components/section-body/list/section-list.astro";
import type { TrustStripSectionContent } from "./trust-strip-section.types.generated.ts";
import "./trust-strip-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const props = cast<TrustStripSectionContent>(pageOverride);
const body = need("body", props.body);
const headerId = props.header?.heading ? "trust-strip-title" : undefined;
const ctaAlign = props.header?.align ?? "center";

let ctaHref: string | null = null;
if (props.cta?.target) {
  if (props.cta.target.startsWith("#")) {
    ctaHref = props.cta.target;
  } else {
    ctaHref = await resolveSemanticTarget({ kind: "internal", pageId: props.cta.target }, lang);
  }
}
---

<SectionShell
  slug="trust-strip"
  sectionNumber={sectionNumber}
  ariaLabel={headerId ? undefined : "Vertrauenssignale"}
  ariaLabelledBy={headerId}
  background={props.background}
  effects={props.effects}
  density={props.density ?? "compact"}
  tone={props.tone}
  lang={lang}
>
  {
    props.header?.heading && (
      <SectionHeader
        sectionNumber={sectionNumber}
        heading={props.header.heading}
        subheading={props.header.subheading}
        align={props.header.align ?? "center"}
        level={props.header.level ?? 2}
        hideSectionNumber={props.header.hideSectionNumber}
        id={headerId}
      lang={lang}
      />
    )
  }
  <SectionList
    items={body.items}
    note={body.note}
    iconColor={body.iconColor}
    align={body.align ?? "center"}
    itemAlign={body.itemAlign}
    hideMarkers={body.hideMarkers}
    effects={body.effects}
  />
  {
    props.cta && ctaHref && (
      <div class:list={["trust-strip__cta-wrap", `trust-strip__cta-wrap--align-${ctaAlign}`]}>
        <a class="trust-strip__cta" href={ctaHref}>
          {props.cta.label}
        </a>
      </div>
    )
  }
</SectionShell>
