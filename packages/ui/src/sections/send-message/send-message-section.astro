---
/*
<MODULE_CONTRACT>
<purpose>Render a send-message section with a single textarea, real-time validation checklist, and runtime channel submission.</purpose>
<non-goals>
  <item>Do not perform server-side transport logic in the section itself.</item>
  <item>Do not store submitted visitor messages in the browser.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Introduce a new shared send-message section with one-field lead capture UX and extensible channel badges.</item>
  <item>RFC-0514: add structured emailField (required) and phoneField (optional) inputs; remove contactRequirementMessage.</item>
  <item>RFC-0572: revert to single-textarea — remove email/phone inputs, re-add contactRequirementMessage.</item>
  <item>Add real-time validation checklist with Lord Icons: to-do-list (pending) and approved-checked (ready).</item>
</CHANGE_SUMMARY>
*/

import { getEntry } from "astro:content";
import type { SectionProps } from "@warpgogol/share/page";
import { cast, need, resolveSectionAnchor, getSiteSectionLabels } from "@warpgogol/share";
import SectionShell from "@warpgogol/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/ui/components/section-header.astro";
import TodoListIcon from "../../icons/gen/lordicon/doodle-outline/t/to-do-list-hover-icon.astro";
import ApprovedCheckedIcon from "../../icons/gen/lordicon/doodle-outline/a/approved-checked-hover-icon.astro";
import RectangleIcon from "../../icons/gen/lordicon/doodle-outline/r/rectangle-hover-icon.astro";
import ApproveCheckedSimpleIcon from "../../icons/gen/lordicon/doodle-outline/a/approve-checked-simple-hover-icon.astro";
import type { SendMessageSectionContent } from "./send-message-section.types.generated.ts";
import "./send-message-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "send-message");
const props = cast<SendMessageSectionContent>(pageOverride);
const formId = props.formId ?? "send-message";
const endpoint = props.endpoint ?? "/api/send-message";
const bodyAlign = props.body?.align ?? "center";

const siteLabels = await getSiteSectionLabels<Record<string, unknown>>(
  lang,
  Astro.props.defaultLanguageCode,
  "sendMessage",
);

function resolveLabel(key: string, fallback: string): string {
  const propValue = (props as any)[key];
  if (typeof propValue === "string" && propValue.length > 0) return propValue;
  const siteValue = siteLabels?.[key];
  if (typeof siteValue === "string" && siteValue.length > 0) return siteValue;
  return fallback;
}

const businessContactEntry =
  (await getEntry("business-profile", `${lang}/contact/general-email`)) ??
  (await getEntry("business-profile", "de/contact/general-email"));
const businessEmail = (businessContactEntry?.data as { value?: string } | undefined)?.value;
const fallbackEmail = props.fallbackEmail ?? businessEmail ?? "";
---

<SectionShell
  slug="send-message"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="send-message-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <div class="send-message" data-send-message-root>
    <SectionHeader
      sectionNumber={sectionNumber}
      heading={need("header.heading", props.header?.heading)}
      subheading={props.header?.subheading}
      align={props.header?.align ?? "center"}
      level={props.header?.level ?? 2}
      hideSectionNumber={props.header?.hideSectionNumber}
      id="send-message-title"
    />

    {
      props.body?.paragraphs && props.body.paragraphs.length > 0 && (
        <div class={`send-message__body send-message__body--${bodyAlign}`}>
          <div class="send-message__paragraphs">
            {props.body.paragraphs.map((paragraph) => (
              <p class="send-message__paragraph">{paragraph}</p>
            ))}
          </div>
        </div>
      )
    }

    <form
      class="send-message__form"
      data-send-message-form
      autocomplete="off"
      data-endpoint={endpoint}
      data-form-id={formId}
      data-locale={lang}
      data-empty-message={resolveLabel("emptyMessage", "")}
      data-sending-label={resolveLabel("sendingLabel", "")}
      data-success-message={resolveLabel("successMessage", "")}
      data-error-message={resolveLabel("errorMessage", "")}
      data-min-message-length={String(props.minMessageLength ?? 12)}
      data-fallback-email={fallbackEmail}
      data-fallback-email-label={resolveLabel("fallbackEmailLabel", "")}
      data-fallback-body-label={resolveLabel("fallbackBodyLabel", "")}
      data-copy-message-label={resolveLabel("copyMessageLabel", "")}
      data-contact-requirement-message={resolveLabel("contactRequirementMessage", "")}
      data-referrer-field-enabled={String(props.referrerField?.enabled ?? false)}
      data-referrer-field-required={String(props.referrerField?.required ?? false)}
      data-referrer-field-label={resolveLabel("referrerFieldLabel", "")}
      data-referrer-field-placeholder={resolveLabel("referrerFieldPlaceholder", "")}
      data-checklist-title={resolveLabel("checklistTitle", "")}
      data-checklist-ready-label={resolveLabel("checklistReadyLabel", "")}
      data-checklist-length-label={resolveLabel("checklistLengthLabel", "")}
      data-checklist-contact-label={resolveLabel("checklistContactLabel", "")}
    >
      {
        props.referrerField?.enabled && (
          <label class="send-message__field send-message__field--referrer">
            <input
              class="send-message__input"
              type="text"
              name="referrer"
              autocomplete="off"
              data-send-message-referrer
              placeholder={resolveLabel("referrerFieldPlaceholder", "")}
              required={props.referrerField.required}
              aria-label={resolveLabel("referrerFieldLabel", "")}
            />
          </label>
        )
      }

      <label class="send-message__field">
        <span class="sr-only">{resolveLabel("placeholder", "")}</span>
        <textarea
          class="send-message__textarea"
          name="contact-message"
          autocomplete="off"
          data-send-message-textarea
          placeholder={resolveLabel("placeholder", "")}
          aria-describedby="send-message-hint"></textarea>
      </label>

      <div class="send-message__checklist" data-send-message-checklist>
        <div class="send-message__checklist-header" data-send-message-checklist-header>
          <span
            class="send-message__checklist-icon send-message__checklist-icon--pending"
            data-send-message-checklist-icon-pending
          >
            <TodoListIcon size={28} trigger="in" stroke="regular" />
          </span>
          <span
            class="send-message__checklist-icon send-message__checklist-icon--ready"
            data-send-message-checklist-icon-ready
            hidden
          >
            <ApprovedCheckedIcon size={28} trigger="in" stroke="regular" />
          </span>
          <span class="send-message__checklist-title" data-send-message-checklist-title>
            {resolveLabel("checklistTitle", "")}
          </span>
        </div>
        <ul class="send-message__checklist-items">
          <li class="send-message__checklist-item" data-send-message-checklist-item="length">
            <span
              class="send-message__checklist-indicator send-message__checklist-indicator--pending"
              data-send-message-checklist-indicator-pending
              ><RectangleIcon size={24} trigger="in" stroke="regular" /></span
            >
            <span
              class="send-message__checklist-indicator send-message__checklist-indicator--checked"
              data-send-message-checklist-indicator-checked
              hidden><ApproveCheckedSimpleIcon size={24} trigger="in" stroke="regular" /></span
            >
            <span class="send-message__checklist-text" data-send-message-checklist-text="length"
            ></span>
          </li>
          <li class="send-message__checklist-item" data-send-message-checklist-item="contact">
            <span
              class="send-message__checklist-indicator send-message__checklist-indicator--pending"
              data-send-message-checklist-indicator-pending
              ><RectangleIcon size={24} trigger="in" stroke="regular" /></span
            >
            <span
              class="send-message__checklist-indicator send-message__checklist-indicator--checked"
              data-send-message-checklist-indicator-checked
              hidden><ApproveCheckedSimpleIcon size={24} trigger="in" stroke="regular" /></span
            >
            <span class="send-message__checklist-text" data-send-message-checklist-text="contact">
              {resolveLabel("checklistContactLabel", "")}
            </span>
          </li>
        </ul>
      </div>

      <div
        class="send-message__hint"
        id="send-message-hint"
        data-send-message-status
        data-status="idle"
      >
      </div>

      <div class="send-message__actions">
        <button
          class="send-message__button"
          type="submit"
          data-send-message-submit
          data-default-label={resolveLabel("buttonLabel", "")}
        >
          {resolveLabel("buttonLabel", "")}
        </button>
      </div>
    </form>

    <div class="send-message__success" data-send-message-success hidden>
      {resolveLabel("successMessage", "")}
    </div>

    {
      fallbackEmail && (
        <div class="send-message__fallback" data-send-message-fallback hidden>
          <p class="send-message__fallback-error">{resolveLabel("errorMessage", "")}</p>
          {resolveLabel("fallbackEmailLabel", "") && (
            <p class="send-message__fallback-lead">{resolveLabel("fallbackEmailLabel", "")}</p>
          )}
          <a class="send-message__fallback-link" href={`mailto:${fallbackEmail}`}>
            {fallbackEmail}
          </a>
          <p class="send-message__fallback-lead">{resolveLabel("fallbackBodyLabel", "")}</p>
          <div class="send-message__fallback-body">
            <pre class="send-message__fallback-text" data-send-message-fallback-text />
            <button
              class="send-message__copy-btn"
              type="button"
              aria-label={resolveLabel("copyMessageLabel", "")}
              title={resolveLabel("copyMessageLabel", "")}
              data-copy-value=""
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
              </svg>
            </button>
          </div>
        </div>
      )
    }
  </div>
</SectionShell>

<script>
  import "./send-message-section.client";
</script>
