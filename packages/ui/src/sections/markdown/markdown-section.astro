---
/* <MODULE_CONTRACT>
<purpose>Facilitates the rendering of multilingual markdown content within a structured layout.</purpose>
<non-goals>
  <item>Do not handle raw markdown parsing or content transformation — delegated to prose-pipeline.ts.</item>
  <item>Do not manage routing or navigation logic for language selection.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Rename markdown-content-component to markdown-section and move to section folder to align with monorepo patterns.</item>
  <item>Refactor CSS classes from markdown-page to markdown-section for naming consistency.</item>
  <item>Extract prose image resolution and rendering pipeline into prose-image-resolver.ts and prose-pipeline.ts for testability.</item>
</CHANGE_SUMMARY> */

import "./markdown-section.css";
import "../../components/material-credit/material-credit.css";

import { getEntry, render } from "astro:content";
import type {
  SectionBackground,
  EffectAssignment,
  SectionDensity,
  SectionTone,
} from "@gogol/share";
import type { SectionProps } from "@gogol/share/page";
import {
  getSiteLabelsData,
  materialCreditLabelsSchema,
  readCreditsSiteDefault,
} from "@gogol/share";
import { pageIdToContentFileSlug } from "@gogol/share/content";
import SectionShell from "@gogol/ui/components/section-shell.astro";
import SectionHeader from "@gogol/ui/components/section-header.astro";
import { renderProse } from "./prose-pipeline.ts";

/** RFC-0035: Markdown section specific pageOverride shape */
interface MarkdownPageOverride {
  heading: string;
  lead?: string;
  /** RFC-0102: hide the section-number prefix on <SectionHeader>. Default true for prose pages. */
  hideSectionNumber?: boolean;
  variant?: "default" | "open-source";
  pageId?: string;
  languages?: string[];
  showLanguageLabels?: boolean;
  /**
   * [DNA-24][RFC-0026][RFC-0047] Reference to prose content in the prose domain.
   * Format: "prose/<slug>.<lang>" — e.g. "prose/impressum.de".
   * When provided the section loads and renders that entry instead of expecting a <slot />.
   */
  contentRef?: string;
  /** RFC-0041: wrap inline numbers in prose for GSAP animation. Default false. */
  animateNumbers?: boolean;
  /** RFC-0041: also animate year numbers (1200–currentYear+120). Default true. */
  animateYears?: boolean;
  /** RFC-0041: GSAP count-up duration in seconds. Default 3.0. */
  numberDuration?: number;
  /** RFC-0104 ImageFade: per-edge fade applied to prose images. */
  defaultImageFade?: {
    top?: boolean;
    bottom?: boolean;
    left?: boolean;
    right?: boolean;
  };
  /** RFC-0101 visual modifiers. */
  background?: SectionBackground;
  effects?: EffectAssignment[];
  density?: SectionDensity;
  tone?: SectionTone;
}

const { lang, defaultLanguageCode, sectionNumber, pageOverride } = Astro.props as SectionProps;
const {
  heading,
  lead,
  hideSectionNumber = true,
  variant = "default",
  pageId,
  languages = [],
  showLanguageLabels = true,
  contentRef,
  animateNumbers = false,
  animateYears = true,
  numberDuration = 3.0,
  defaultImageFade = {},
  background,
  effects,
  density,
  tone,
} = pageOverride as MarkdownPageOverride;

const localizedSiteLabels = await getSiteLabelsData(lang, defaultLanguageCode);
const defaultSiteLabels =
  lang === defaultLanguageCode
    ? localizedSiteLabels
    : await getSiteLabelsData(defaultLanguageCode, defaultLanguageCode);
const materialCreditLabels = materialCreditLabelsSchema.parse(
  (localizedSiteLabels as { materialCredits?: unknown } | null)?.materialCredits ??
    (defaultSiteLabels as { materialCredits?: unknown } | null)?.materialCredits,
);
// RFC-0231: site-level material-credit visibility default for prose images.
const creditsSiteDefault = readCreditsSiteDefault(
  localizedSiteLabels ?? defaultSiteLabels ?? undefined,
);

// Render prose content through the extracted pipeline.
const proseResult = await renderProse({
  lang,
  defaultLanguageCode,
  contentRef,
  animateNumbers,
  animateYears,
  numberDuration,
  materialCreditLabels,
  creditsSiteDefault,
});

const normalizedLanguages = Array.from(
  new Set(
    languages
      .filter((languageCode): languageCode is string => typeof languageCode === "string")
      .map((languageCode) => languageCode.trim().toLowerCase())
      .filter(Boolean),
  ),
);

const currentLanguage = lang.toLowerCase();
const requestedLanguages = normalizedLanguages.length > 1 ? normalizedLanguages : [currentLanguage];

const translationColumns = pageId
  ? await Promise.all(
      requestedLanguages
        .filter((languageCode) => languageCode !== currentLanguage)
        .map(async (languageCode) => {
          const entry = await getEntry(
            "pages",
            `${languageCode}/${pageIdToContentFileSlug(pageId)}`,
          );

          if (!entry) {
            console.warn(`[Markdown] Missing page entry: ${languageCode}/${pageId}`);
            return undefined;
          }

          const { Content } = await render(entry);

          return {
            languageCode,
            Content,
          };
        }),
    )
  : [];

const availableTranslations = translationColumns.filter(
  (column): column is NonNullable<(typeof translationColumns)[number]> => Boolean(column),
);

const showLanguageColumns = Boolean(pageId && requestedLanguages.length > 1);
const shouldShowLanguageLabels = showLanguageColumns && showLanguageLabels;
---

<SectionShell
  slug="markdown"
  ariaLabelledBy={heading ? "markdown-section-title" : undefined}
  background={background ?? { kind: "color" }}
  effects={effects}
  density={density}
  tone={tone}
  containerVariant="narrow"
  lang={lang}
>
  <div
    class:list={[
      "markdown-section",
      { [`markdown-section--${variant}`]: variant !== "default" },
      { "markdown-section--imageFadeBottom": defaultImageFade.bottom },
      { "markdown-section--imageFadeTop": defaultImageFade.top },
      { "markdown-section--imageFadeLeft": defaultImageFade.left },
      { "markdown-section--imageFadeRight": defaultImageFade.right },
    ]}
  >
    {
      heading && (
        <SectionHeader
          heading={heading}
          subheading={lead}
          level={1}
          align="center"
          id="markdown-section-title"
          sectionNumber={sectionNumber}
          hideSectionNumber={hideSectionNumber}
        />
      )
    }
    {
      showLanguageColumns ? (
        <div class="markdown-section__content markdown-section__content--columns">
          {currentLanguage && (
            <article class="markdown-section__column" lang={currentLanguage}>
              {shouldShowLanguageLabels && (
                <p class="markdown-section__language-label">{currentLanguage.toUpperCase()}</p>
              )}
              <div class="markdown-section__column-body">
                <slot />
              </div>
            </article>
          )}
          {availableTranslations.map(({ languageCode, Content }) => (
            <article class="markdown-section__column" lang={languageCode}>
              {shouldShowLanguageLabels && (
                <p class="markdown-section__language-label">{languageCode.toUpperCase()}</p>
              )}
              <div class="markdown-section__column-body">
                <Content />
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="markdown-section__content">
          {proseResult.kind === "html" ? (
            <Fragment set:html={proseResult.html} />
          ) : proseResult.kind === "component" ? (
            <proseResult.Component />
          ) : (
            <slot />
          )}
        </div>
      )
    }
  </div>
</SectionShell>
