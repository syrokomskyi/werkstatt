{
  "name": "@warpgogol/agent-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RFC-0290: framework-agnostic Agent Surface runtime (action routes + stateless MCP endpoint), instantiated per site from its Agent Surface Manifest.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./astro": {
      "types": "./src/astro.ts",
      "default": "./src/astro.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@warpgogol/integration": "workspace:*",
    "@warpgogol/ontology": "workspace:*",
    "@warpgogol/share": "workspace:*",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  },
  "gogol": {
    "testSignal": {
      "status": "green",
      "owner": "architecture",
      "rationale": "Fixture-based JSON-RPC conformance corpus (agent.gate.fixtures.run) plus unit tests for the action interpreter."
    }
  }
}
