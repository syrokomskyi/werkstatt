{
  "name": "@warpgogol/werkstatt-knowledge",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Werkstatt Knowledge plugin — evidence-backed knowledge systems stack.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/werkstatt-knowledge.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./paths": {
      "types": "./src/paths/knowledge-paths.ts",
      "default": "./src/paths/knowledge-paths.ts"
    },
    "./invariants": {
      "types": "./src/invariants/knowledge-invariants.ts",
      "default": "./src/invariants/knowledge-invariants.ts"
    },
    "./source/module": {
      "types": "./src/source/module.ts",
      "default": "./src/source/module.ts"
    },
    "./core/module": {
      "types": "./src/core/module.ts",
      "default": "./src/core/module.ts"
    },
    "./extract/module": {
      "types": "./src/extract/module.ts",
      "default": "./src/extract/module.ts"
    },
    "./materialize/module": {
      "types": "./src/materialize/module.ts",
      "default": "./src/materialize/module.ts"
    },
    "./release/module": {
      "types": "./src/release/module.ts",
      "default": "./src/release/module.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "lint": "pnpm exec eslint \"src/**/*.ts\"",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@warpgogol/werkstatt": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10"
  }
}
