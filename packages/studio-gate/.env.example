# @gogol/studio-gate environment variables (RFC-0555, ADR-0005)
# Copy to .env (never commit) and fill values as needed.

# ── Workspace root resolution (RFC-0555)
# How to obtain: Set to the absolute path of the Werkstatt root directory.
# Falls back to process.cwd() if unset.
WERKSTATT_ROOT=

# ── Build concurrency limit (ADR-0005)
# How to obtain: Set to the max number of concurrent build-triggering tool calls
# (mission.validate, mission.build) allowed per studio-gate process. Default: 2.
# Increase if the VM has more CPU cores and can handle parallel builds.
STUDIO_GATE_BUILD_CONCURRENCY=
