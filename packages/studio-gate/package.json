{
  "name": "@warpgogol/studio-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RFC-0555: stdio MCP server for site owner content editing with mission lifecycle. Projects workpiece.read/write and mission lifecycle commands as MCP tools.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@warpgogol/site-kernel": "workspace:*",
    "@warpgogol/site-kernel-handoff": "workspace:*",
    "@warpgogol/passport": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
