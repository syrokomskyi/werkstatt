{
  "name": "@warpgogol/pbp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public Business Profile (PBP) entity envelope, namespace, and URI policy (RFC-0399, pbp/*@1).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./loaders": {
      "types": "./src/loaders.ts",
      "default": "./src/loaders.ts"
    },
    "./astro": {
      "types": "./src/astro.ts",
      "default": "./src/astro.ts"
    },
    "./compiler": {
      "types": "./src/compiler/index.ts",
      "default": "./src/compiler/index.ts"
    },
    "./semantic-profile": {
      "types": "./src/semantic-profile.ts",
      "default": "./src/semantic-profile.ts"
    },
    "./semantic-model": {
      "types": "./src/semantic-model.ts",
      "default": "./src/semantic-model.ts"
    },
    "./cutover-check": {
      "types": "./src/cutover-check.ts",
      "default": "./src/cutover-check.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "echo 'No build step required — TypeScript sources consumed directly'",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@warpgogol/content-source": "workspace:*",
    "@warpgogol/fingerprint": "workspace:*",
    "@warpgogol/share": "workspace:*",
    "@warpgogol/site-kernel-content": "workspace:*",
    "astro": "^7.1.6",
    "zod": "^4.4.3"
  },
  "gogol": {
    "testSignal": {
      "signal": "direct",
      "owner": "architecture",
      "rationale": "Vitest unit tests cover URI validation, schema ID validation, and entity envelope types."
    }
  }
}
