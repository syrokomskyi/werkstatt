{
  "name": "@warpgogol/faq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pluggable FAQ content collection: Zod schema, Astro collection factory, loaders, and semantic mapping (RFC-0475).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./astro": {
      "types": "./src/astro.ts",
      "default": "./src/astro.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "echo 'No build step required — TypeScript sources consumed directly'",
    "build:check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@warpgogol/content-source": "workspace:*",
    "@warpgogol/share": "workspace:*",
    "astro": "^7.1.6",
    "zod": "^4.4.3"
  }
}
