{
  "name": "@warpgogol/integration-adapter-supabase-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CRM buffer DestinationAdapter (Lagebild MVP): writes IntegrationEvents into a Supabase buffer (contacts, deals, stage_transitions, sync_outbox) for async Pipedrive sync. Mirrors the growth (RFC-0027) and content-source (RFC-0141) port/adapter pattern.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./adapter": {
      "types": "./src/adapter.ts",
      "default": "./src/adapter.ts"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "default": "./src/worker.ts"
    },
    "./pipedrive-sync-target": {
      "types": "./src/pipedrive-sync-target.ts",
      "default": "./src/pipedrive-sync-target.ts"
    },
    "./tenant-registry": {
      "types": "./src/tenant-registry.ts",
      "default": "./src/tenant-registry.ts"
    }
  },
  "files": ["src", "migrations"],
  "scripts": {
    "build": "echo 'No build step required — TypeScript sources consumed directly'",
    "build:check": "tsc --noEmit",
    "test:check": "tsc --noEmit --project tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@warpgogol/integration": "workspace:*",
    "@warpgogol/share": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  }
}
