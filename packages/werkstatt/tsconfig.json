{
  "extends": "../../tsconfig/node-lib.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "os/**/*.ts"],
  "exclude": ["src/**/*.template.*", "dist/**", "node_modules/**"]
}
