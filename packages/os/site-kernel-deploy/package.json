{
  "name": "@warpgogol/site-kernel-deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@warpgogol/werkstatt-site": "workspace:*",
    "@warpgogol/site-kernel": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {},
  "gogol": {
    "testSignal": {
      "signal": "skipped",
      "owner": "architecture",
      "rationale": "Deploy/export behavior is operational and not run in unit tests yet; direct tests are deferred until filesystem fixture coverage is added.",
      "reviewAfter": "2026-10-01"
    }
  }
}
