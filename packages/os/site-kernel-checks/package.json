    "file-type": "^22.0.1",
    "picomatch": "^4.0.5",
    "playwright": "^1.61.1",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
