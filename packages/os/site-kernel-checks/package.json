{
  "name": "@gogol/site-kernel-checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./audit/types": {
      "types": "./src/audit/types.ts",
      "default": "./src/audit/types.ts"
    },
    "./ecosystem": {
      "types": "./src/ecosystem.ts",
      "default": "./src/ecosystem.ts"
    },
    "./lib/astro-site-url": {
      "types": "./src/lib/astro-site-url.ts",
      "default": "./src/lib/astro-site-url.ts"
    },
    "./lib/i18n": {
      "types": "./src/lib/i18n.ts",
      "default": "./src/lib/i18n.ts"
    },
    "./maintenance-debt-queue": {
      "types": "./src/maintenance-debt-queue.ts",
      "default": "./src/maintenance-debt-queue.ts"
    },
    "./module": {
      "types": "./src/module.ts",
      "default": "./src/module.ts"
    },
    "./pipelines/packages-check": {
      "types": "./src/pipelines/packages-check.ts",
      "default": "./src/pipelines/packages-check.ts"
    },
    "./pipelines": {
      "types": "./src/pipelines/index.ts",
      "default": "./src/pipelines/index.ts"
    },
    "./result-helpers": {
      "types": "./src/result-helpers.ts",
      "default": "./src/result-helpers.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
