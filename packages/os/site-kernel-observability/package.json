  "dependencies": {
    "@gogol/observability": "workspace:*",
    "@gogol/site-kernel": "workspace:*",
    "@gogol/site-kernel-checks": "workspace:*",
    "@gogol/site-kernel-content": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  }
}
