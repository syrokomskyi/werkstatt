{
  "name": "@gogol/site-kernel-observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./module": {
      "types": "./src/module.ts",
      "default": "./src/module.ts"
    }
  },
  "files": ["src"],
  "scripts": {
