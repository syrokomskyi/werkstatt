---
{{GENERATED_HEADER}}
/*
<MODULE_CONTRACT>
<purpose>
  [DNA-07][DNA-25][RFC-0026] Thin proxy route for all block-declarative pages.
  Delegates ALL data resolution to @warpgogol/share/astro/page-handler resolvePageRoute().
  Uses shared @warpgogol/ui/components/layout/layout-component.astro directly — no app-local
  layout proxy. No per-page composition logic — every page is generated by this single route.
</purpose>
<non-goals>
  <item>Do not read system.md or content entries directly — all data flows through resolvePageRoute.</item>
  <item>Do not hand-assemble sections. Use BlocksRenderer for all block rendering.</item>
  <item>Do not add consumer imports of .astro components without ensuring the producer package's
        package.json exports map has a corresponding .astro-suffixed key (RFC-0089 dual-key
        convention: every extensionless "exports" key targeting a .astro file must have a sibling
        "${key}.astro" → sameFile pair so Vite's resolver works in static builds).</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Autogenerated file.</item>
</CHANGE_SUMMARY>
*/

import {
  getStaticPathsForPrefixedLangs,
  getStaticPathsForDefaultLangRedirects,
  getRouteRegistry,
} from "@warpgogol/share";
import { resolvePageRoute } from "@warpgogol/share/astro/page-handler";
import type { SemanticPageType } from "@warpgogol/share/semantic";
import { buildPageSemanticModel, buildPbpSemanticProfile } from "@warpgogol/pbp/semantic-profile";
import BaseLayout from "@warpgogol/ui/components/layout";
import BlocksRenderer from "@warpgogol/ui/blocks-renderer.astro";
import TranslationNotice from "@warpgogol/ui/legal/translation-notice.astro";
import GrowthProvider from "@warpgogol/growth/provider.astro";
import Header from "@warpgogol/ui/components/header";
import Footer from "@warpgogol/ui/components/footer";
import globalStylesheetUrl from "@styles/global.css?url";

export async function getStaticPaths() {
  // RFC-0160: non-default languages are served here; default-language prefixed
  // URLs emit a redirect to the unprefixed canonical path.
  const [prefixed, redirects] = await Promise.all([
    getStaticPathsForPrefixedLangs(),
    getStaticPathsForDefaultLangRedirects(),
  ]);
  return [...prefixed, ...redirects];
}

const { lang, slug } = Astro.params;

// Redirect default-language prefixed URLs to the unprefixed canonical path.
const { defaultLanguage } = await getRouteRegistry();
if (lang === defaultLanguage) {
  return Astro.redirect(slug ? `/${slug}` : "/", 308);
}

const data = await resolvePageRoute({
  lang: lang!,
  slug: slug ?? "",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  buildSemanticModel: async ({ pageId, semanticType, lang, url, fallbackFrontmatter, breadcrumbs, collectionItems, surfaceId, depth }) => {
    const profile = await buildPbpSemanticProfile(
      lang,
      url,
      `${process.cwd()}/src/content/business-profile`,
    );
    return buildPageSemanticModel(
      pageId,
      semanticType as SemanticPageType,
      lang,
      url,
      profile,
      fallbackFrontmatter,
      breadcrumbs,
      collectionItems,
      surfaceId,
      depth,
    );
  },
});

// RFC-0174: a `disabled` legal translation falls back to the binding-language
// document instead of serving the untrusted translation.
if (data.translationContext?.redirectTo) {
  return Astro.redirect(data.translationContext.redirectTo, 308);
}

// RFC-0192: Programmatic Surface redirect stub — 301 to the live ancestor.
if (data.redirectTo) {
  return Astro.redirect(data.redirectTo, 301);
}

// RFC-0174: the translation notice sits directly below the breadcrumbs but above
// the page content. Split the in-flow (non-shell) blocks around the breadcrumbs
// block (cosmic name "Thebe") so the notice can be rendered between them.
const sectionBlocks = data.page.blocks.filter((b) => b.layer !== "shell");
const breadcrumbBlocks = sectionBlocks.filter((b) => b.planetName === "Thebe");
const contentBlocks = sectionBlocks.filter((b) => b.planetName !== "Thebe");
---

<BaseLayout
  title={data.page.title}
  description={data.resolvedDescription}
  lang={data.page.lang}
  biome={data.biome}
  alternateLinks={data.alternateLinks}
  semanticPage={data.semanticPage ?? undefined}
  skipLinkLabel={data.skipLinkLabel}
  globalStylesheetUrl={globalStylesheetUrl}
  orchestratorConfig={data.orchestratorConfig}
>
  {
    data.growthConfig && (
      <GrowthProvider
        appId={data.appId}
        locale={lang!}
        vendor={data.growthConfig.vendor}
        activeFunnels={data.growthConfig.funnels ?? []}
        activeExperiments={data.growthConfig.experiments ?? []}
      />
    )
  }
  <Header
    lang={lang!}
    currentPath={Astro.url.pathname}
    supportedLangs={data.supportedLangs}
    localizedSiblingPath={data.localizedSiblingPath}
    ctaTarget={data.ctaTarget}
    defaultLanguage={defaultLanguage}
  />
  <BlocksRenderer
    blocks={data.page.blocks.filter((b) => b.layer === "shell")}
    lang={lang!}
    defaultLanguageCode={data.defaultLanguageCode}
    linkRegistry={{}}
    pageId={data.pageId}
  />
  <main id="main-content">
    <BlocksRenderer
      blocks={breadcrumbBlocks}
      lang={lang!}
      defaultLanguageCode={data.defaultLanguageCode}
      linkRegistry={{}}
      pageId={data.pageId}
    />
    {
      data.translationContext &&
        (data.translationContext.showNotice || data.translationContext.showIndicator) && (
          <TranslationNotice
            pageLang={lang!}
            bindingLang={data.translationContext.bindingLang}
            bindingUrl={data.translationContext.bindingUrl}
            bindingDocLabel={data.translationContext.bindingDocLabel}
            showNotice={data.translationContext.showNotice}
            showIndicator={data.translationContext.showIndicator}
          />
        )
    }
    <BlocksRenderer
      blocks={contentBlocks}
      lang={lang!}
      defaultLanguageCode={data.defaultLanguageCode}
      linkRegistry={{}}
      pageId={data.pageId}
    />
  </main>
  <Footer lang={lang!} defaultLang={defaultLanguage} />
  <script>
    import "../../scripts/layout-orchestrator";
  </script>
</BaseLayout>
