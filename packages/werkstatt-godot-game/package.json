{
  "name": "@warpgogol/werkstatt-godot-game",
  "version": "0.7.2",
  "private": false,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Werkstatt Godot plugin — Godot 4.x + C# stack.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syrokomskyi/werkstatt-godot-game.git"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./paths": {
      "types": "./src/paths/godot-paths.ts",
      "default": "./src/paths/godot-paths.ts"
    },
    "./checks": {
      "types": "./src/checks/index.ts",
      "default": "./src/checks/index.ts"
    },
    "./checks/module": {
      "types": "./src/checks/module.ts",
      "default": "./src/checks/module.ts"
    },
    "./invariants": {
      "types": "./src/invariants/godot-invariants.ts",
      "default": "./src/invariants/godot-invariants.ts"
    },
    "./deploy/types": {
      "types": "./src/deploy/types.ts",
      "default": "./src/deploy/types.ts"
    },
    "./build": {
      "types": "./src/build/dotnet-build.ts",
      "default": "./src/build/dotnet-build.ts"
    },
    "./build/dev-server": {
      "types": "./src/build/godot-dev-server.ts",
      "default": "./src/build/godot-dev-server.ts"
    },
    "./build/test": {
      "types": "./src/build/dotnet-test.ts",
      "default": "./src/build/dotnet-test.ts"
    },
    "./dev/module": {
      "types": "./src/dev/module.ts",
      "default": "./src/dev/module.ts"
    },
    "./release-evidence": {
      "types": "./src/release-evidence/godot-evidence.ts",
      "default": "./src/release-evidence/godot-evidence.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "lint": "pnpm exec eslint \"src/**/*.ts\"",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build": "pnpm exec tsc -p tsconfig.json --noEmit",
    "build:check": "pnpm exec tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@warpgogol/werkstatt": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "^4.1.10"
  }
}
