---
/* <MODULE_CONTRACT>
<purpose>RFC-0504: Table of contents section — renders an auto-generated TOC
from H2 headings in the article prose body. Entries are populated at render time
from the sourceContentRef.</purpose>
<non-goals>
  <item>Do not parse markdown here — the renderer/entrypoint resolves the contentRef and passes entries.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0504: initial implementation — TOC section for ratgeber 12-section layout.</item>
</CHANGE_SUMMARY> */

import "./toc-section.css";
import type { SectionProps } from "@warpgogol/werkstatt-site/share/page";

const rawProps = (Astro.props as SectionProps) ?? {};
interface TocOverride {
  entries?: Array<{ text: string; anchor: string }>;
}
const p = (rawProps.pageOverride ?? {}) as TocOverride;
const entries: Array<{ text: string; anchor: string }> = Array.isArray(p.entries) ? p.entries : [];
---

{
  entries.length > 0 && (
    <nav class="toc-section" aria-label="Table of contents">
      <ul class="toc-list">
        {entries.map((entry) => (
          <li class="toc-item">
            <a href={`#${entry.anchor}`} class="toc-link">
              {entry.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
