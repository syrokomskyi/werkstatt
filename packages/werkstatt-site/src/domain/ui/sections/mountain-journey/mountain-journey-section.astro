---
/*
<MODULE_CONTRACT>
<purpose>mountain-journey composite section — interactive maturity mountain with GSAP camera pan and marker animation. RFC-0802.</purpose>
<non-goals>
  <item>Do not add app-specific logic; shared sections are composition-only.</item>
  <item>Do not import GSAP in the .astro file; animation is handled by the client script.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Generated by section.scaffold with Compass markers (RFC-0155).</item>
  <item>RFC-0802: replaced scaffolded composite template with mountain scene SVG + form layout.</item>
</CHANGE_SUMMARY>
*/

import "./mountain-journey-section.css";
import type { SectionProps } from "@warpgogol/werkstatt-site/share/page";
import { need, cast, resolveSectionAnchor } from "@warpgogol/werkstatt-site/share";
import SectionShell from "@warpgogol/werkstatt-site/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/werkstatt-site/ui/components/section-header.astro";
import type { MountainJourneySectionContent } from "./mountain-journey-section.types.generated.ts";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "mountain-journey");
const props = cast<MountainJourneySectionContent>(pageOverride);
const { svgViewBox, routePath, stages, form } = props;
---

<SectionShell
  slug="mountain-journey"
  sectionId={sectionId}
  ariaLabelledBy="mountain-journey-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  containerVariant="full"
  lang={lang}
>
  <div
    class="mountain-journey__scene"
    data-mountain-journey-scene
    data-route-path={routePath}
    data-view-box-width={svgViewBox.width}
    data-view-box-height={svgViewBox.height}
    data-worker-endpoint={props.workerEndpoint ?? ""}
  >
    <div class="mountain-journey__visual" data-mountain-journey-visual>
      <img
        class="mountain-journey__background"
        src={props.backgroundImage}
        alt=""
        loading="eager"
      />
      <svg
        class="mountain-journey__overlay"
        viewBox={`0 0 ${svgViewBox.width} ${svgViewBox.height}`}
        preserveAspectRatio="xMinYMax slice"
        aria-hidden="true"
      >
        <path
          class="mountain-journey__route"
          data-mountain-journey-route
          d={routePath}
          fill="none"
          stroke="#ff0000"
          stroke-width="4"
          stroke-dasharray="8 4"
          vector-effect="non-scaling-stroke"></path>
        <circle
          class="mountain-journey__marker"
          data-mountain-journey-marker
          cx="0"
          cy="0"
          r="12"
          fill="#ffff00"
          stroke="#ff0000"
          stroke-width="2"></circle>
      </svg>
    </div>
    <div class="mountain-journey__header">
      <SectionHeader
        sectionNumber={sectionNumber}
        heading={need("header.heading", props.header?.heading)}
        subheading={props.header?.subheading}
        align={props.header?.align ?? "left"}
        level={props.header?.level ?? 2}
        hideSectionNumber={props.header?.hideSectionNumber}
        id="mountain-journey-title"
      />
    </div>
    <form class="mountain-journey__form" data-mountain-journey-form>
      <div class="mountain-journey__form-row">
        <input
          class="mountain-journey__form-input"
          type="text"
          id="mountain-journey-url"
          name="url"
          placeholder={form.inputPlaceholder}
          required
        />
        <button class="mountain-journey__form-submit" type="submit">
          {form.submitLabel}
        </button>
      </div>
      <p class="mountain-journey__form-error" data-mountain-journey-error role="alert" hidden>
        {form.errorMessage}
      </p>
    </form>
  </div>

  <noscript>
    <p class="mountain-journey__noscript">
      {form.errorMessage}
    </p>
  </noscript>
</SectionShell>

<script>
  import "./mountain-journey-section.client";
</script>
