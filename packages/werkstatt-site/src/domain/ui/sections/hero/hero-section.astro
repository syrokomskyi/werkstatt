---
/*
<MODULE_CONTRACT>
<purpose>Hero composite section — bespoke layout (bg image + portrait + ctas + stats) wrapped in SectionShell + SectionHeader.</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
  <item>RFC-0167: universal hero — render `leadImage` (highest-precedence portrait + own alt), omit stats block when empty (no NEED_THIS placeholder), enabling text-only heroes.</item>
  <item>RFC-0250: optional portrait and CTA targets no longer fall back to app-specific `hero-1` / `donateContact` tokens.</item>
  <item>Hero sections never render a section number above the heading.</item>
</CHANGE_SUMMARY>
*/

import {
  cast,
  need,
  resolveImage,
  resolveSemanticTarget,
  resolveSectionAnchor,
  resolveEffectsForTarget,
  creditByTarget,
} from "@warpgogol/werkstatt-site/share";
import { resolveCounterStats } from "@warpgogol/werkstatt-site/share";
import type { HeroSectionContent } from "./hero-section.types.generated.ts";
import type { SectionProps } from "@warpgogol/werkstatt-site/share/page";
import SectionShell from "@warpgogol/werkstatt-site/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/werkstatt-site/ui/components/section-header.astro";
import EffectHost from "@warpgogol/werkstatt-site/ui/components/effects/effect-host.astro";
import ResponsiveImage from "@warpgogol/werkstatt-site/ui/components/responsive-image.astro";
import "./hero-section.css";

import { contentAssetCredits, contentAssetImages } from "../../content-assets.ts";
const images = contentAssetImages;

const { lang, defaultLanguageCode, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "hero");
const props = cast<HeroSectionContent>(pageOverride);

const heroBgImage =
  resolveImage(images, props.backgroundImage, { lang }) ??
  resolveImage(images, "hero-bg", { lang });

// RFC-0167/RFC-0250: the lead/content image is the highest-precedence portrait
// source and carries its own required alt. Missing optional portrait input omits
// the portrait instead of guessing an app-specific asset token.
const leadImage = props.leadImage ? resolveImage(images, props.leadImage.src, { lang }) : null;
const legacyPortraitImage = props.portraitImage
  ? resolveImage(images, props.portraitImage, { lang })
  : null;
const portraitImage = leadImage ?? legacyPortraitImage;
const leadImagePlacement = props.leadImagePlacement ?? "portrait";
const renderPortraitImage = portraitImage && leadImagePlacement === "portrait";
const renderInlineLeadImage = leadImage && leadImagePlacement === "after-heading";
const portraitImageToken = props.leadImage?.src ?? props.portraitImage;
const portraitAlt = props.leadImage?.alt ?? props.imageAlt;
// RFC-0231: always resolve the credit (provenance must survive hiding); the
// per-placement `creditDisplay` only governs whether the visible row renders.
const portraitCredit = portraitImageToken
  ? creditByTarget(
      contentAssetCredits,
      { kind: "image", id: portraitImageToken, domain: "pages" },
      lang,
      defaultLanguageCode,
    )
  : null;

const primaryCtaTarget = props.primaryCtaTarget;
const secondaryCtaTarget = props.secondaryCtaTarget;
const primaryCtaHref =
  props.ctaPrimaryUrl ??
  (primaryCtaTarget
    ? await resolveSemanticTarget({ kind: "internal", pageId: primaryCtaTarget }, lang)
    : null);
const secondaryCtaHref =
  props.ctaSecondaryUrl ??
  (secondaryCtaTarget
    ? await resolveSemanticTarget({ kind: "internal", pageId: secondaryCtaTarget }, lang)
    : null);

// WCAG 2.5.3 Label in Name: if ariaLabel is set but doesn't contain the visible
// label text, prepend the label so the accessible name includes the visible text.
function resolveLabelInName(
  ariaLabel: string | undefined,
  label: string | undefined,
): string | undefined {
  if (!ariaLabel || !label) return ariaLabel;
  if (ariaLabel.toLowerCase().includes(label.toLowerCase())) return ariaLabel;
  return `${label} — ${ariaLabel}`;
}

const resolvedCtaPrimaryAriaLabel = resolveLabelInName(
  props.ctaPrimaryAriaLabel,
  props.ctaPrimaryLabel,
);
const resolvedCtaSecondaryAriaLabel = resolveLabelInName(
  props.ctaSecondaryAriaLabel,
  props.ctaSecondaryLabel,
);

// RFC-0167: a universal hero renders without stats (e.g. a text-only legal hero).
// No placeholder default — an empty stats array simply omits the stats block.
const stats = props.stats ?? [];
const resolvedStats = resolveCounterStats(stats, props.animated ?? false, lang);
const itemEffects = resolveEffectsForTarget(props.effects, "item");
const headingEffects = resolveEffectsForTarget(props.effects, "heading");
const leadImageFadeStyle = props.leadImageFade?.width
  ? `--section-image-fade-width: ${Math.round(props.leadImageFade.width * 100)}%;`
  : undefined;
const portraitImageClass = [
  "hero__portrait-image",
  props.leadImageFade?.top && "hero__portrait-image--fade-top",
  props.leadImageFade?.bottom && "hero__portrait-image--fade-bottom",
  props.leadImageFade?.left && "hero__portrait-image--fade-left",
  props.leadImageFade?.right && "hero__portrait-image--fade-right",
]
  .filter(Boolean)
  .join(" ");
---

<SectionShell
  slug="hero"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="hero-title"
  background={props.background ?? { kind: "transparent" }}
  density={props.density}
  tone={props.tone}
  containerVariant={props.containerVariant ?? "full"}
  lang={lang}
>
  {
    heroBgImage && (
      <div class="hero__bg" aria-hidden="true">
        <ResponsiveImage
          image={heroBgImage}
          alt=""
          class="hero__bg-image"
          quality="max"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__overlay" />
      </div>
    )
  }

  <div class:list={["hero__container", { "hero__container--inline-lead": renderInlineLeadImage }]}>
    {
      renderPortraitImage && (
        <div class="hero__portrait">
          <ResponsiveImage
            image={portraitImage}
            alt={need("leadImage.alt/imageAlt", portraitAlt)}
            class={portraitImageClass}
            style={leadImageFadeStyle}
            quality="max"
            loading="eager"
            fetchpriority="high"
            data-content-image={leadImage ? true : undefined}
            credit={portraitCredit}
            creditDisplay={props.creditDisplay}
            lang={lang}
            defaultLanguageCode={defaultLanguageCode}
          />
        </div>
      )
    }

    <div class="hero__content">
      {props.tagline && <p class="hero__tagline">{props.tagline}</p>}
      <SectionHeader
        sectionNumber={sectionNumber}
        heading={need("header.heading", props.header?.heading)}
        subheading={props.header?.subheading ?? props.subheading}
        align={props.header?.align ?? "left"}
        level={props.header?.level ?? 1}
        hideSectionNumber={true}
        id="hero-title"
        headingEffects={headingEffects}
        lang={lang}
      />
      {
        renderInlineLeadImage && (
          <div class="hero__inline-media">
            <div class="hero__inline-frame">
              <ResponsiveImage
                image={leadImage}
                alt={need("leadImage.alt", props.leadImage?.alt)}
                class="hero__inline-image"
                quality="max"
                loading="eager"
                fetchpriority="high"
                data-content-image={true}
                credit={portraitCredit}
                creditDisplay={props.creditDisplay}
                lang={lang}
                defaultLanguageCode={defaultLanguageCode}
              />
            </div>
          </div>
        )
      }
      {props.description && <p class="hero__description">{props.description}</p>}

      <div class="hero__cta-group">
        {
          primaryCtaHref && props.ctaPrimaryLabel && (
            <a
              href={primaryCtaHref}
              class="btn btn--primary hero__cta"
              aria-label={resolvedCtaPrimaryAriaLabel}
            >
              {props.ctaPrimaryLabel}
            </a>
          )
        }
        {
          secondaryCtaHref && props.ctaSecondaryLabel && (
            <a
              href={secondaryCtaHref}
              class="btn btn--secondary hero__cta-secondary"
              aria-label={resolvedCtaSecondaryAriaLabel}
            >
              {props.ctaSecondaryLabel}
            </a>
          )
        }
      </div>

      {
        resolvedStats.length > 0 && (
          <div class="hero__stats" data-animated={props.animated ? "true" : undefined}>
            {resolvedStats.map((stat) => (
              <EffectHost effects={itemEffects} class="hero__stat">
                <span
                  class:list={["hero__stat-value", { "js-stat-counter": stat.isAnimated }]}
                  data-numeric={stat.isAnimated ? String(stat.numericValue) : undefined}
                  data-start={stat.isAnimated ? stat.startValue : undefined}
                  data-prefix={stat.isAnimated ? (stat.prefix ?? "") : undefined}
                  data-suffix={stat.isAnimated ? (stat.suffix ?? "") : undefined}
                  data-decimals={stat.isAnimated ? String(stat.decimals ?? 0) : undefined}
                  data-duration={stat.isAnimated ? String(stat.duration ?? 1.8) : undefined}
                  style="font-variant-numeric: tabular-nums;"
                >
                  {stat.isAnimated ? stat.startValue : stat.finalFormatted}
                </span>
                <span class="hero__stat-label">{stat.label}</span>
              </EffectHost>
            ))}
          </div>
        )
      }
    </div>
  </div>
</SectionShell>
