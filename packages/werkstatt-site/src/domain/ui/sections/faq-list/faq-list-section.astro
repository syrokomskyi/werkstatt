---
/*
<MODULE_CONTRACT>
<purpose>FAQ list — composite section that loads business/faq entries and renders accordion via SectionShell + SectionHeader.</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import { getCollection, type CollectionEntry } from "astro:content";
import type { SectionProps } from "@warpgogol/werkstatt-site/share/page";
import { need, cast, resolveSectionAnchor } from "@warpgogol/werkstatt-site/share";
import SectionShell from "@warpgogol/werkstatt-site/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/werkstatt-site/ui/components/section-header.astro";
import CurrencyAwarePriceDisplay from "@warpgogol/werkstatt-site/ui/components/currency-aware-price-display/currency-aware-price-display-component.astro";
import {
  buildPriceVariants,
  formatPrice,
  loadDerivedPrices,
  type SourcePriceProp,
  type PriceVariant,
} from "../price-card/price-variants.ts";
import { decimalMultiply, decimalRound, type PbpRoundingMode } from "@warpgogol/werkstatt-site/pbp";
import type { FaqListSectionContent } from "./faq-list-section.types.generated.ts";
import type { FaqListItem } from "./faq-list-section.types.ts";
import "./faq-list-section.css";

const { lang, pageOverride, sectionNumber } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "faq-list");

const props = cast<FaqListSectionContent>(pageOverride);
const tagFilter = props.tag || "";

const allFaqEntries = await getCollection("faq", (entry: CollectionEntry<"faq">) =>
  entry.id.startsWith(`${lang}/`),
);

const derivedPrices = loadDerivedPrices();
const offeringUriPrefix = "https://warpgogol.com/id/offerings/";

type TextPart = { kind: "text"; value: string };
type PricePart = { kind: "price"; variants: ReturnType<typeof buildPriceVariants> };
type TextOrPrice = TextPart | PricePart;

const priceMarkerRe = /\{price:([a-zA-Z0-9_-]+):([a-zA-Z0-9_.-]+)\}/g;
const amountMarkerRe = /\{amount:([0-9]+(?:\.[0-9]+)?)\}/g;

function buildAmountVariants(amountEur: string): PriceVariant[] | null {
  if (!derivedPrices) return null;
  const sourceProp: SourcePriceProp = { amount: amountEur, currency: "EUR" };
  const sourceFormatted = formatPrice(sourceProp, lang);
  const variants: PriceVariant[] = [];
  if (sourceFormatted) {
    variants.push({ currency: "EUR", formatted: sourceFormatted, note: null });
  }
  const seenCurrencies = new Set<string>(["EUR"]);
  for (const entries of Object.values(derivedPrices)) {
    for (const entry of entries) {
      const targetCurrency = entry.amount.currency;
      if (seenCurrencies.has(targetCurrency)) continue;
      seenCurrencies.add(targetCurrency);
      const rateStr = entry.trace.rate.value;
      const rateNum = Number(rateStr);
      if (!Number.isFinite(rateNum)) continue;
      const converted = decimalMultiply(amountEur, rateStr);
      const rounding = entry.trace.calculation?.rounding;
      const rounded = rounding
        ? decimalRound(
            converted,
            rounding.mode as PbpRoundingMode,
            rounding.increment,
            rounding.decimalPlaces,
          )
        : converted;
      const numericAmount = Number(rounded);
      if (!Number.isFinite(numericAmount)) continue;
      const formatted = new Intl.NumberFormat(lang, {
        style: "currency",
        currency: targetCurrency,
        currencyDisplay: "narrowSymbol",
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      }).format(numericAmount);
      variants.push({ currency: targetCurrency, formatted, note: null });
    }
  }
  return variants.length > 1 ? variants : null;
}

function parsePriceMarkers(text: string): TextOrPrice[] {
  const parts: TextOrPrice[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;
  priceMarkerRe.lastIndex = 0;
  amountMarkerRe.lastIndex = 0;
  const combinedRe =
    /\{(?:price:([a-zA-Z0-9_-]+):([a-zA-Z0-9_.-]+)|amount:([0-9]+(?:\.[0-9]+)?))\}/g;
  while ((match = combinedRe.exec(text)) !== null) {
    if (match.index > lastIndex) {
      parts.push({ kind: "text", value: text.slice(lastIndex, match.index) });
    }
    if (match[1] && match[2]) {
      const offeringId = match[1];
      const chargeRef = match[2];
      const offeringRef = offeringUriPrefix + offeringId;
      const entries = derivedPrices?.[offeringRef];
      const matching = entries?.filter((e) => e.chargeRef === chargeRef) ?? [];
      const sourceAmount = matching[0]?.trace?.source?.amount ?? "0";
      const sourceProp: SourcePriceProp = { amount: sourceAmount, currency: "EUR" };
      const variants = buildPriceVariants(
        sourceProp,
        chargeRef,
        lang,
        offeringRef,
        derivedPrices,
        undefined,
      );
      parts.push({ kind: "price", variants });
    } else if (match[3]) {
      const variants = buildAmountVariants(match[3]);
      parts.push({ kind: "price", variants });
    }
    lastIndex = match.index + match[0].length;
  }
  if (lastIndex < text.length) {
    parts.push({ kind: "text", value: text.slice(lastIndex) });
  }
  if (parts.length === 0) parts.push({ kind: "text", value: text });
  return parts;
}

type FaqItemWithParts = FaqListItem & {
  questionParts: TextOrPrice[];
  answerParts: TextOrPrice[];
};

const faqItems: FaqItemWithParts[] = allFaqEntries
  .filter((entry: { data: { tags?: string[] } }) => {
    const data = entry.data as { tags?: string[] };
    if (!tagFilter) return true;
    return data.tags?.includes(tagFilter) ?? false;
  })
  .map(
    (entry: { data: { slug?: string; question?: string; answer?: string } }): FaqItemWithParts => {
      const data = entry.data;
      return {
        question: need("question", data.question),
        questionParts: parsePriceMarkers(need("question", data.question)),
        answer: need("answer", data.answer),
        answerParts: parsePriceMarkers(need("answer", data.answer)),
        slug: need("slug", data.slug),
      };
    },
  )
  .sort((a: FaqItemWithParts, b: FaqItemWithParts) => a.slug.localeCompare(b.slug));
---

<SectionShell
  slug="faq-list"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="faq-list-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <SectionHeader
    sectionNumber={sectionNumber}
    heading={need("header.heading", props.header?.heading)}
    subheading={props.header?.subheading}
    align={props.header?.align ?? "left"}
    level={props.header?.level ?? 2}
    hideSectionNumber={props.header?.hideSectionNumber}
    id="faq-list-title"
    lang={lang}
  />

  <div class="faq-list-section__items">
    {
      faqItems.map((item) => (
        <details class="faq-list-section__item" name={`faq-${sectionId}`}>
          <summary class="faq-list-section__question">
            <span>
              {item.questionParts.map((part) =>
                part.kind === "text" ? (
                  part.value
                ) : part.variants ? (
                  <CurrencyAwarePriceDisplay priceVariants={part.variants} />
                ) : null,
              )}
            </span>
            <span class="faq-list-section__icon" aria-hidden="true">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M6 9l6 6 6-6" />
              </svg>
            </span>
          </summary>
          <div class="faq-list-section__answer">
            <span class="faq-list-section__answer-text">
              {item.answerParts.map((part) =>
                part.kind === "text" ? (
                  part.value
                ) : part.variants ? (
                  <CurrencyAwarePriceDisplay priceVariants={part.variants} />
                ) : null,
              )}
            </span>
          </div>
        </details>
      ))
    }
  </div>
</SectionShell>
