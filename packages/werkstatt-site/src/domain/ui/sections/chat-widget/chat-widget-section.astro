---
/*
<MODULE_CONTRACT>
<purpose>RFC-0175: render a consent-gated, click-to-load chat launcher. The first-party launcher is
the only thing present pre-activation; the vendor script loads only after the visitor clicks (handled
by the colocated client script + @warpgogol/werkstatt-site/chat/client). The vendor binding is read from system.md
integrations.chat (engineering-owned); the launcher carries the RFC-0177 legal notice.</purpose>
<non-goals>
  <item>Do not render any third-party script/iframe/origin in server output (RFC-0177).</item>
  <item>Do not carry secrets — only public vendor options from system.md.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0175: initial implementation.</item>
</CHANGE_SUMMARY>
*/

import { getCollection } from "astro:content";
import type { SectionProps } from "@warpgogol/werkstatt-site/share/page";
import { cast, need, resolveSectionAnchor, resolveSemanticTarget } from "@warpgogol/werkstatt-site/share";
import { ChatWidgetConfigSchema, CHAT_CONFIG_SCRIPT_ID } from "@warpgogol/werkstatt-site/chat";
import SectionShell from "@warpgogol/werkstatt-site/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/werkstatt-site/ui/components/section-header.astro";
import type { ChatWidgetSectionContent } from "./chat-widget-section.types.generated.ts";
import "./chat-widget-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "chat-widget");
const props = cast<ChatWidgetSectionContent>(pageOverride);

// Read the engineering-owned chat binding from system.md integrations.chat.
const systemEntries = await getCollection("system");
const systemData = systemEntries[0]?.data as
  | {
      identity?: { appName?: string };
      integrations?: { chat?: { adapter?: string; options?: Record<string, string> } };
    }
  | undefined;
const chatBinding = systemData?.integrations?.chat;
const appId = systemData?.identity?.appName ?? "site";

// Build the public, click-to-load config. Absent/invalid binding → null adapter (no-op).
const config = ChatWidgetConfigSchema.parse({
  appId,
  locale: lang,
  adapter: chatBinding?.adapter ?? "null",
  options: chatBinding?.options ?? {},
});
const configJson = JSON.stringify(config);

const launcherLabel = need("launcherLabel", props.launcherLabel);
const legalNotice = need("legalNotice", props.legalNotice);
const privacyPolicyPageId = need("privacyPolicyPageId", props.privacyPolicyPageId);
// RFC-0048: resolve the semantic pageId to the locale's route (de: /datenschutz, uk: /konfidentsiynist).
const privacyPolicyHref =
  (await resolveSemanticTarget({ kind: "internal", pageId: privacyPolicyPageId }, lang)) ?? "#";
const privacyPolicyLabel = props.privacyPolicyLabel;
---

<SectionShell
  slug="chat-widget"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy={props.header ? "chat-widget-title" : undefined}
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <div class="chat-widget" data-chat-widget-root>
    {
      props.header && (
        <SectionHeader
          sectionNumber={sectionNumber}
          heading={props.header.heading}
          subheading={props.header.subheading}
          align={props.header.align ?? "center"}
          level={props.header.level ?? 2}
          hideSectionNumber={props.header.hideSectionNumber}
          id="chat-widget-title"
          lang={lang}
        />
      )
    }

    <script id={CHAT_CONFIG_SCRIPT_ID} type="application/json" set:html={configJson} />

    <div class="chat-widget__launcher-wrap">
      <button class="chat-widget__launcher" type="button" data-chat-launcher>
        {launcherLabel}
      </button>
      <p class="chat-widget__legal">
        {legalNotice}{" "}
        <a class="chat-widget__legal-link" href={privacyPolicyHref}>{privacyPolicyLabel}</a>
      </p>
    </div>
  </div>
</SectionShell>

<script>
  import "./chat-widget-section.client";
</script>
