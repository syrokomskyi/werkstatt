---
/*
<MODULE_CONTRACT>
<purpose>Service metadata block section — renders page-level metadata footer (version, dates, links, footnote). RFC-0759 bodyKind: composite; default tone muted.</purpose>
<non-goals>
  <item>Do not add app-specific logic; shared sections are composition-only.</item>
  <item>Do not add client-side hydration or React islands — build-time SSG only.</item>
  <item>Do not add structured-data (JSON-LD) output — visible HTML footer only.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>Generated by section.scaffold with Compass markers (RFC-0155).</item>
  <item>RFC-0759: Customized composite template for page-level metadata footer.</item>
  <item>RFC-0759 fix: Added optional label props (versionLabel, effectiveDateLabel, nextReviewDateLabel, linksLabel) for i18n support.</item>
</CHANGE_SUMMARY>
*/

import type { SectionProps } from "@warpgogol/werkstatt-site/share/page";
import { need, cast, resolveSectionAnchor } from "@warpgogol/werkstatt-site/share";
import SectionShell from "@warpgogol/werkstatt-site/ui/components/section-shell.astro";
import SectionHeader from "@warpgogol/werkstatt-site/ui/components/section-header.astro";
import type { ServiceMetadataBlockSectionContent } from "./service-metadata-block-section.types.generated.ts";
import "./service-metadata-block-section.css";

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const sectionId = await resolveSectionAnchor(Astro.props, "service-metadata-block");
const props = cast<ServiceMetadataBlockSectionContent>(pageOverride);
---

<SectionShell
  slug="service-metadata-block"
  sectionId={sectionId}
  sectionNumber={sectionNumber}
  ariaLabelledBy="service-metadata-block-title"
  background={props.background}
  effects={props.effects}
  density={props.density}
  tone={props.tone ?? "muted"}
  lang={lang}
>
  <SectionHeader
    sectionNumber={sectionNumber}
    heading={need("header.heading", props.header?.heading)}
    subheading={props.header?.subheading}
    align={props.header?.align ?? "left"}
    level={props.header?.level ?? 2}
    hideSectionNumber={props.header?.hideSectionNumber}
    id="service-metadata-block-title"
  />
  <div class="service-metadata-block__body">
    {
      (props.version || props.effectiveDate || props.nextReviewDate) && (
        <dl class="service-metadata-block__meta">
          {props.version && (
            <div class="service-metadata-block__meta-item">
              <dt class="service-metadata-block__meta-label">{props.versionLabel ?? "Version"}</dt>
              <dd class="service-metadata-block__meta-value">{props.version}</dd>
            </div>
          )}
          {props.effectiveDate && (
            <div class="service-metadata-block__meta-item">
              <dt class="service-metadata-block__meta-label">
                {props.effectiveDateLabel ?? "Effective date"}
              </dt>
              <dd class="service-metadata-block__meta-value">{props.effectiveDate}</dd>
            </div>
          )}
          {props.nextReviewDate && (
            <div class="service-metadata-block__meta-item">
              <dt class="service-metadata-block__meta-label">
                {props.nextReviewDateLabel ?? "Next review"}
              </dt>
              <dd class="service-metadata-block__meta-value">{props.nextReviewDate}</dd>
            </div>
          )}
        </dl>
      )
    }
    {
      props.links && props.links.length > 0 && (
        <nav
          class="service-metadata-block__links"
          aria-label={props.linksLabel ?? "Related documents"}
        >
          <ul>
            {props.links.map((link) => (
              <li>
                <a href={link.href} rel={link.rel}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {props.footnote && <p class="service-metadata-block__footnote">{props.footnote}</p>}
  </div>
</SectionShell>
