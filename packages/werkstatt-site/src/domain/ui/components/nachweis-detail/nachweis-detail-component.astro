---
/*
<MODULE_CONTRACT>
<purpose>
  NachweisDetail (Kerberos) — Full detail page component for a single Nachweis
  record. Discriminated union: attestation variant renders a nachweis-card
  plus Sichtpass section; technical-assessment variant renders technical
  detail layout with observation history. RFC-0708 / RFC-0876.
</purpose>
<non-goals>
  <item>Does not fetch data — receives all data via props from the page block.</item>
  <item>Does not handle routing.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0708: initial implementation.</item>
  <item>RFC-0871: replace qualifiedTimestamp prop with structured timestamp prop carrying assurance metadata.</item>
  <item>RFC-0876: add technical-assessment variant with observation history section.</item>
  <item>RFC-0887: add display-gated PDF, screenshot, and website link sections to attestation variant.</item>
  <item>ADR-0057: screenshot caption identifies as homepage capture with capture date.</item>
</CHANGE_SUMMARY>
*/

/**
 * NachweisDetail (Kerberos) — trust detail component
 * RFC-0708 / RFC-0876 / DNA-17 / DNA-23 / WCAG 2.2 AA
 */

import type { SectionProps } from "@warpgogol/werkstatt-shared/share/page";
import { need, cast, type Effect } from "@warpgogol/werkstatt-site/share";
import SectionShell from "../section-shell/section-shell.astro";
import NachweisCard, {
  type NachweisAssessmentDimension,
  type NachweisCardLabels,
} from "../nachweis-card/nachweis-card-component.astro";
import EffectHost from "../effects/effect-host.astro";
import "./nachweis-detail-component.css";

export interface NachweisDetailLabels {
  pdfDocument: string;
  pdfNotSupported: string;
  pdfDownload: string;
  sha256Hash: string;
  websiteScreenshot: string;
  screenshotAltTemplate: string;
  screenshotAltFallback: string;
  homepageCapture: string;
  websiteVisit: string;
  sichtpass: string;
  sourceHash: string;
  publicDerivative: string;
  recordHash: string;
  envelopeHash: string;
  verificationLevel: string;
  qualifiedTimestamp: string;
  rfc3161Timestamp: string;
  qualificationEvidence: string;
  operatorSignature: string;
  technicalDetails: string;
  whatItMeasures: string;
  whatItDoesNotProve: string;
  providerReport: string;
  observationHistory: string;
  colDate: string;
  colResult: string;
  colVerificationLevel: string;
  colDetail: string;
  viewLink: string;
}

interface Sichtpass {
  sourceSha256: string;
  publicDerivativeSha256?: string;
  recordPayloadSha256?: string;
  envelopeSha256?: string;
  operatorSignature?: string;
  timestamp?: {
    tokenPresent: boolean;
    assurance: "rfc3161" | "eidas-qualified";
    providerName?: string;
    qualificationEvidenceRef?: string;
  };
  verificationLevel?: string;
}

interface ObservationHistoryEntry {
  observationId: string;
  observedAt: string;
  overallScore?: number;
  overallLevel?: string;
  verificationLevel: string;
  detailSlug: string;
}

interface NachweisAttestationDetailContent {
  variant: "attestation";
  slug: string;
  title: string;
  result: string;
  scope?: string;
  context?: string;
  limitations?: string;
  quote?: string;
  quoteLang?: string;
  source?: string;
  verifiedScope?: string;
  notVerifiedScope?: string;
  status: "draft" | "preview" | "published" | "withdrawn";
  verifiedByLabel?: string;
  verifiedDate?: string;
  sichtpass?: Sichtpass;
  // RFC-0887: display control fields
  display?: {
    document: "visible" | "hidden";
    screenshot: "visible" | "hidden";
    websiteLink: "visible" | "hidden";
  };
  websiteUrl?: string;
  websiteScreenshot?: {
    sha256: string;
    mediaType: string;
    storage: "private" | "public";
    url?: string;
    capturedAt?: string;
  };
  pdfUrl?: string;
  pdfSha256?: string;
  background?: unknown;
  effects?: unknown;
  density?: "compact" | "normal" | "spacious";
  tone?: "default" | "warning" | "success" | "muted";
  labels: NachweisDetailLabels;
  cardLabels: NachweisCardLabels;
}

interface NachweisTechnicalAssessmentDetailContent {
  variant: "technical-assessment";
  slug: string;
  title: string;
  provider: { id: string; name: string };
  tool: { name: string; version?: string };
  executionMode: "operator-run" | "provider-run";
  subjectUrl: string;
  observedAt: string;
  methodology: {
    id: string;
    version: string;
    runCount: number;
    aggregation: "provider" | "median" | "none";
  };
  overall?: { score?: number; level?: string };
  dimensions: NachweisAssessmentDimension[];
  verificationLevel: "N0" | "N1" | "N2" | "N3";
  sourceHashes: string[];
  limitation: string;
  whatItMeasures: string;
  whatItDoesNotProve: string;
  providerReportUrl?: string;
  sichtpass?: Sichtpass;
  observationHistory?: ObservationHistoryEntry[];
  background?: unknown;
  effects?: unknown;
  density?: "compact" | "normal" | "spacious";
  tone?: "default" | "warning" | "success" | "muted";
  labels: NachweisDetailLabels;
  cardLabels: NachweisCardLabels;
}

type NachweisDetailContent =
  NachweisAttestationDetailContent | NachweisTechnicalAssessmentDetailContent;

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const props = cast<NachweisDetailContent>(pageOverride);

const defaultGlassEffects: Effect[] = [
  { kind: "glass", enabled: true, blur: 16, saturate: 180, tintOpacity: 0.6 },
];

const t = need("labels", props.labels) as NachweisDetailLabels;
const cardLabels = need("cardLabels", props.cardLabels) as NachweisCardLabels;

function screenshotAlt(domain: string): string {
  return t.screenshotAltTemplate.replace("{domain}", domain);
}

const sichtpassHeadingId = `nachweis-detail-${props.slug}-sichtpass`;
const historyHeadingId = `nachweis-detail-${props.slug}-history`;
const technicalHeadingId = `nachweis-detail-${props.slug}-technical`;
const pdfHeadingId = `nachweis-detail-${props.slug}-pdf`;
const screenshotHeadingId = `nachweis-detail-${props.slug}-screenshot`;

// RFC-0887: display-gated section variables (attestation variant only)
const display = props.variant === "attestation" ? props.display : undefined;
const websiteUrl = props.variant === "attestation" ? props.websiteUrl : undefined;
const websiteScreenshot = props.variant === "attestation" ? props.websiteScreenshot : undefined;
const pdfUrl = props.variant === "attestation" ? props.pdfUrl : undefined;
const pdfSha256 = props.variant === "attestation" ? props.pdfSha256 : undefined;
const domain = websiteUrl ? safeHostname(websiteUrl) : undefined;
const captureDate = websiteScreenshot?.capturedAt
  ? formatDate(websiteScreenshot.capturedAt)
  : undefined;
const captureDatetime = websiteScreenshot?.capturedAt
  ? toISOString(websiteScreenshot.capturedAt)
  : undefined;

function safeHostname(url: string): string | undefined {
  try {
    return new URL(url).hostname.replace(/^www\./, "");
  } catch {
    return undefined;
  }
}

function isDateLike(value: unknown): value is Date {
  return value instanceof Date || Object.prototype.toString.call(value) === "[object Date]";
}

function toDate(value: unknown): Date | undefined {
  if (isDateLike(value)) return value as Date;
  if (typeof value === "string" || typeof value === "number") {
    const d = new Date(value);
    if (!isNaN(d.getTime())) return d;
  }
  return undefined;
}

function formatDate(value: unknown): string {
  const d = toDate(value);
  if (!d) return String(value);
  const locale = lang === "uk" ? "uk-UA" : "de-DE";
  return d.toLocaleDateString(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function toISOString(value: unknown): string {
  const d = toDate(value);
  if (!d) return String(value);
  return d.toISOString();
}
---

<SectionShell
  slug="nachweis-detail"
  sectionNumber={sectionNumber}
  background={props.background ?? { kind: "transparent" }}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  {
    props.variant === "attestation" && (
      <article class="nachweis-detail" data-component="nachweis-detail" data-variant="attestation">
        <NachweisCard
          variant="attestation"
          slug={props.slug}
          title={props.title}
          result={props.result}
          scope={props.scope}
          context={props.context}
          limitations={props.limitations}
          quote={props.quote}
          quoteLang={props.quoteLang}
          source={props.source}
          verifiedScope={props.verifiedScope}
          notVerifiedScope={props.notVerifiedScope}
          status={props.status}
          verifiedByLabel={props.verifiedByLabel}
          verifiedDate={props.verifiedDate}
          display={display}
          websiteUrl={websiteUrl}
          lang={lang}
          labels={cardLabels}
        />

        {display?.document === "visible" && (pdfUrl || pdfSha256) && (
          <EffectHost
            as="section"
            effects={defaultGlassEffects}
            class="nachweis-detail__pdf"
            aria-labelledby={pdfHeadingId}
          >
            <h2 id={pdfHeadingId} class="nachweis-detail__section-title">
              {t.pdfDocument}
            </h2>
            {pdfUrl && (
              <object
                data={`${pdfUrl}#toolbar=0&navpanes=0&view=Fit`}
                type="application/pdf"
                width="100%"
                class="nachweis-detail__pdf-viewer"
              >
                <p>
                  {t.pdfNotSupported}
                  <a href={pdfUrl} download>
                    {t.pdfDownload}
                  </a>
                </p>
              </object>
            )}
            {pdfSha256 && (
              <p class="nachweis-detail__pdf-hash">
                <span class="sr-only">{t.sha256Hash}</span>
                <code>{pdfSha256}</code>
              </p>
            )}
          </EffectHost>
        )}

        {display?.screenshot === "visible" && websiteScreenshot?.url && (
          <EffectHost
            as="section"
            effects={defaultGlassEffects}
            class="nachweis-detail__screenshot"
            aria-labelledby={screenshotHeadingId}
          >
            <h2 id={screenshotHeadingId} class="nachweis-detail__section-title">
              {t.websiteScreenshot}
            </h2>
            <figure class="nachweis-detail__screenshot-figure">
              <img
                src={websiteScreenshot.url}
                alt={screenshotAlt(domain ?? t.screenshotAltFallback)}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="1280"
                height="720"
              />
              <figcaption>
                {captureDate && (
                  <time datetime={captureDatetime}>
                    {t.homepageCapture} {captureDate}
                  </time>
                )}
              </figcaption>
            </figure>
          </EffectHost>
        )}

        {display?.websiteLink === "visible" && websiteUrl && domain && (
          <section class="nachweis-detail__website-link">
            <a
              href={websiteUrl}
              rel="noopener noreferrer"
              target="_blank"
              class="nachweis-detail__website-link-anchor"
            >
              <span class="nachweis-detail__website-link-icon" aria-hidden="true">
                ↗
              </span>
              {t.websiteVisit} {domain}
            </a>
          </section>
        )}

        {props.sichtpass && (
          <EffectHost
            as="section"
            effects={defaultGlassEffects}
            class="nachweis-detail__sichtpass"
            aria-labelledby={sichtpassHeadingId}
          >
            <h2 id={sichtpassHeadingId} class="nachweis-detail__sichtpass-title">
              {t.sichtpass}
            </h2>

            <dl class="nachweis-detail__hashes">
              <div class="nachweis-detail__entry">
                <dt>{t.sourceHash}</dt>
                <dd>
                  <code class="nachweis-detail__hash">{props.sichtpass.sourceSha256}</code>
                </dd>
              </div>
              {props.sichtpass.publicDerivativeSha256 && (
                <div class="nachweis-detail__entry">
                  <dt>{t.publicDerivative}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">
                      {props.sichtpass.publicDerivativeSha256}
                    </code>
                  </dd>
                </div>
              )}
              {props.sichtpass.recordPayloadSha256 && (
                <div class="nachweis-detail__entry">
                  <dt>{t.recordHash}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">{props.sichtpass.recordPayloadSha256}</code>
                  </dd>
                </div>
              )}
              {props.sichtpass.envelopeSha256 && (
                <div class="nachweis-detail__entry">
                  <dt>{t.envelopeHash}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">{props.sichtpass.envelopeSha256}</code>
                  </dd>
                </div>
              )}
              {props.sichtpass.verificationLevel && (
                <div class="nachweis-detail__entry">
                  <dt>{t.verificationLevel}</dt>
                  <dd>{props.sichtpass.verificationLevel}</dd>
                </div>
              )}
              {props.sichtpass.timestamp?.tokenPresent && (
                <div class="nachweis-detail__entry">
                  <dt>
                    {props.sichtpass.timestamp.assurance === "eidas-qualified"
                      ? t.qualifiedTimestamp
                      : t.rfc3161Timestamp}
                  </dt>
                  <dd>
                    {props.sichtpass.timestamp.providerName && (
                      <span>{props.sichtpass.timestamp.providerName}</span>
                    )}
                    {props.sichtpass.timestamp.qualificationEvidenceRef && (
                      <a
                        href={props.sichtpass.timestamp.qualificationEvidenceRef}
                        rel="noopener noreferrer"
                      >
                        {t.qualificationEvidence}
                      </a>
                    )}
                  </dd>
                </div>
              )}
              {props.sichtpass.operatorSignature && (
                <div class="nachweis-detail__entry">
                  <dt>{t.operatorSignature}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">{props.sichtpass.operatorSignature}</code>
                  </dd>
                </div>
              )}
            </dl>
          </EffectHost>
        )}
      </article>
    )
  }

  {
    props.variant === "technical-assessment" && (
      <article
        class="nachweis-detail"
        data-component="nachweis-detail"
        data-variant="technical-assessment"
      >
        <NachweisCard
          variant="technical-assessment"
          slug={props.slug}
          title={props.title}
          provider={props.provider}
          tool={props.tool}
          executionMode={props.executionMode}
          subjectUrl={props.subjectUrl}
          observedAt={props.observedAt}
          methodology={props.methodology}
          overall={props.overall}
          dimensions={props.dimensions}
          verificationLevel={props.verificationLevel}
          sourceHashes={props.sourceHashes}
          limitation={props.limitation}
          lang={lang}
          labels={cardLabels}
        />

        <EffectHost
          as="section"
          effects={defaultGlassEffects}
          class="nachweis-detail__technical"
          aria-labelledby={technicalHeadingId}
        >
          <h2 id={technicalHeadingId} class="nachweis-detail__section-title">
            {t.technicalDetails}
          </h2>

          <dl class="nachweis-detail__technical-dl">
            <div class="nachweis-detail__entry">
              <dt>{t.whatItMeasures}</dt>
              <dd>{props.whatItMeasures}</dd>
            </div>
            <div class="nachweis-detail__entry">
              <dt>{t.whatItDoesNotProve}</dt>
              <dd>{props.whatItDoesNotProve}</dd>
            </div>
            {props.providerReportUrl && (
              <div class="nachweis-detail__entry">
                <dt>{t.providerReport}</dt>
                <dd>
                  <a href={props.providerReportUrl} rel="noopener noreferrer">
                    {props.providerReportUrl}
                  </a>
                </dd>
              </div>
            )}
          </dl>
        </EffectHost>

        {props.observationHistory && props.observationHistory.length > 0 && (
          <EffectHost
            as="section"
            effects={defaultGlassEffects}
            class="nachweis-detail__history"
            aria-labelledby={historyHeadingId}
          >
            <h2 id={historyHeadingId} class="nachweis-detail__section-title">
              {t.observationHistory}
            </h2>
            <table class="nachweis-detail__history-table">
              <thead>
                <tr>
                  <th scope="col">{t.colDate}</th>
                  <th scope="col">{t.colResult}</th>
                  <th scope="col">{t.colVerificationLevel}</th>
                  <th scope="col">{t.colDetail}</th>
                </tr>
              </thead>
              <tbody>
                {props.observationHistory.map((obs) => (
                  <tr>
                    <td>
                      <time datetime={obs.observedAt}>{formatDate(obs.observedAt)}</time>
                    </td>
                    <td>
                      {obs.overallScore !== undefined && (
                        <span class="nachweis-detail__history-score">{obs.overallScore}</span>
                      )}
                      {obs.overallLevel && (
                        <span class="nachweis-detail__history-level">{obs.overallLevel}</span>
                      )}
                    </td>
                    <td>{obs.verificationLevel}</td>
                    <td>
                      <a href={`/nachweise/${obs.detailSlug}/`}>{t.viewLink}</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </EffectHost>
        )}

        {props.sichtpass && (
          <EffectHost
            as="section"
            effects={defaultGlassEffects}
            class="nachweis-detail__sichtpass"
            aria-labelledby={sichtpassHeadingId}
          >
            <h2 id={sichtpassHeadingId} class="nachweis-detail__sichtpass-title">
              {t.sichtpass}
            </h2>

            <dl class="nachweis-detail__hashes">
              <div class="nachweis-detail__entry">
                <dt>{t.sourceHash}</dt>
                <dd>
                  <code class="nachweis-detail__hash">{props.sichtpass.sourceSha256}</code>
                </dd>
              </div>
              {props.sichtpass.publicDerivativeSha256 && (
                <div class="nachweis-detail__entry">
                  <dt>{t.publicDerivative}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">
                      {props.sichtpass.publicDerivativeSha256}
                    </code>
                  </dd>
                </div>
              )}
              {props.sichtpass.recordPayloadSha256 && (
                <div class="nachweis-detail__entry">
                  <dt>{t.recordHash}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">{props.sichtpass.recordPayloadSha256}</code>
                  </dd>
                </div>
              )}
              {props.sichtpass.envelopeSha256 && (
                <div class="nachweis-detail__entry">
                  <dt>{t.envelopeHash}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">{props.sichtpass.envelopeSha256}</code>
                  </dd>
                </div>
              )}
              {props.sichtpass.verificationLevel && (
                <div class="nachweis-detail__entry">
                  <dt>{t.verificationLevel}</dt>
                  <dd>{props.sichtpass.verificationLevel}</dd>
                </div>
              )}
              {props.sichtpass.timestamp?.tokenPresent && (
                <div class="nachweis-detail__entry">
                  <dt>
                    {props.sichtpass.timestamp.assurance === "eidas-qualified"
                      ? t.qualifiedTimestamp
                      : t.rfc3161Timestamp}
                  </dt>
                  <dd>
                    {props.sichtpass.timestamp.providerName && (
                      <span>{props.sichtpass.timestamp.providerName}</span>
                    )}
                    {props.sichtpass.timestamp.qualificationEvidenceRef && (
                      <a
                        href={props.sichtpass.timestamp.qualificationEvidenceRef}
                        rel="noopener noreferrer"
                      >
                        {t.qualificationEvidence}
                      </a>
                    )}
                  </dd>
                </div>
              )}
              {props.sichtpass.operatorSignature && (
                <div class="nachweis-detail__entry">
                  <dt>{t.operatorSignature}</dt>
                  <dd>
                    <code class="nachweis-detail__hash">{props.sichtpass.operatorSignature}</code>
                  </dd>
                </div>
              )}
            </dl>
          </EffectHost>
        )}
      </article>
    )
  }
</SectionShell>
