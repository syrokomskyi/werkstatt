---
/*
<MODULE_CONTRACT>
<purpose>
  NachweisList (Hydra) — List of nachweis-card components for the Nachweis
  index page. Reads published evidence-source records from the
  business-profile content collection at build time (RFC-0876). Shows an
  empty state message when no published records exist. Supports registry
  and compact variants, kind filtering, and limit. RFC-0708 / RFC-0876.
</purpose>
<non-goals>
  <item>Does not handle routing to detail pages.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0708: initial implementation.</item>
  <item>RFC-0876: add variant, kindFilter, limit props; compact rendering path.</item>
  <item>RFC-0876: load published records from getCollection at build time.</item>
  <item>RFC-0880: remove file-path fallback, require explicit slug in frontmatter.</item>
  <item>RFC-0887: pass through display/websiteUrl from evidence-source data to cards.</item>
  <item>RFC-0892: pass through websiteTagline/websiteFooterTagline from evidence-source data to cards.</item>
</CHANGE_SUMMARY>
*/

/**
 * NachweisList (Hydra) — trust list component
 * RFC-0708 / RFC-0876 / DNA-17 / DNA-23 / WCAG 2.2 AA
 */

import { getCollection } from "astro:content";
import type { SectionProps } from "@warpgogol/werkstatt-shared/share/page";
import { cast } from "@warpgogol/werkstatt-site/share";
import { getEntryLanguage } from "@warpgogol/werkstatt-shared/share/content";
import NachweisCard, {
  type NachweisAssessmentDimension,
} from "../nachweis-card/nachweis-card-component.astro";
import SectionShell from "../section-shell/section-shell.astro";
import SectionHeader from "../section-header/section-header.astro";
import "./nachweis-list-component.css";

interface NachweisAttestationRecord {
  variant: "attestation";
  slug: string;
  title: string;
  result: string;
  scope?: string;
  context?: string;
  limitations?: string;
  quote?: string;
  quoteLang?: string;
  source?: string;
  verifiedScope?: string;
  notVerifiedScope?: string;
  status: "draft" | "preview" | "published" | "withdrawn";
  verifiedByLabel?: string;
  verifiedDate?: string;
  // RFC-0887: display control and website link passthrough
  display?: { websiteLink: "visible" | "hidden" };
  websiteUrl?: string;
  websiteScreenshot?: { url?: string; capturedAt?: string; aspectRatio?: "landscape" | "portrait" };
  // RFC-0892: website meta fields
  websiteTagline?: string;
  websiteFooterTagline?: string;
  sourceHashes?: string[];
  displayHashCode?: "visible" | "hidden";
}

interface NachweisTechnicalAssessmentRecord {
  variant: "technical-assessment";
  slug: string;
  title: string;
  provider: { id: string; name: string; homepage?: string };
  tool: { name: string; version?: string };
  executionMode: "operator-run" | "provider-run";
  subjectUrl: string;
  observedAt: string;
  methodology: {
    id: string;
    version: string;
    runCount: number;
    aggregation: "provider" | "median" | "none";
  };
  overall?: { score?: number; level?: string };
  dimensions: NachweisAssessmentDimension[];
  verificationLevel: "N0" | "N1" | "N2" | "N3";
  sourceHashes: string[];
  limitation: string;
  status?: "draft" | "preview" | "published" | "withdrawn";
  providerReportUrl?: string;
}

type NachweisRecord = NachweisAttestationRecord | NachweisTechnicalAssessmentRecord;

interface NachweisListContent {
  records?: NachweisRecord[];
  emptyMessage?: string;
  variant?: "registry" | "compact";
  kindFilter?: Array<"attestation" | "technical-assessment">;
  limit?: number;
  header?: {
    heading: string;
    subheading?: string;
    align?: "left" | "center" | "right";
    level?: number;
    hideSectionNumber?: boolean;
  };
  background?: unknown;
  effects?: unknown;
  density?: "compact" | "normal" | "spacious";
  tone?: "default" | "warning" | "success" | "muted";
}

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const props = cast<NachweisListContent>(pageOverride);
const emptyMessage = props.emptyMessage ?? "Weitere Nachweise werden derzeit vorbereitet.";
const listVariant = props.variant ?? "registry";
const kindFilter = props.kindFilter;
const limit = props.limit;

const NACHWEIS_EVIDENCE_KINDS = new Set([
  "client-statement",
  "project-confirmation",
  "certificate",
  "operational-evidence",
  "technical-assessment",
]);

interface EvidenceSourceData {
  type?: string;
  kind?: string;
  status?: string;
  name?: string;
  slug?: string;
  items?: Record<string, { sha256?: string }>;
  // RFC-0887: display control and website fields
  display?: { document?: string; screenshot?: string; websiteLink?: string };
  websiteUrl?: string;
  websiteScreenshot?: { url?: string; capturedAt?: string; aspectRatio?: "landscape" | "portrait" };
  // RFC-0892: website meta fields
  websiteTagline?: string;
  websiteFooterTagline?: string;
  assessment?: {
    profile?: string;
    seriesId?: string;
    observationId?: string;
    observedAt?: string;
    subject?: { url?: string };
    provider?: { id?: string; name?: string; homepage?: string };
    tool?: { id?: string; name?: string; version?: string };
    executionMode?: string;
    providerReportUrl?: string;
    methodology?: {
      id: string;
      version: string;
      runCount: number;
      aggregation: "provider" | "median" | "none";
    };
    overall?: { score?: number; level?: string };
    dimensions?: Array<{
      id: string;
      providerLabel: string;
      score?: number;
      numerator?: number;
      denominator?: number;
      status?: string;
      level?: string;
    }>;
  };
  sortOrder?: number;
}

async function loadPublishedNachweisRecords(): Promise<NachweisRecord[]> {
  const systemEntries = await getCollection("system");
  const system = (systemEntries.find((e: { id: string }) => e.id === "system")?.data ?? {}) as {
    i18n?: { default?: string };
  };
  const defaultLang = system.i18n?.default ?? "de";

  const entries = await getCollection("business-profile");
  const langEntries = entries.filter((e: { id: string }) => {
    const entryLang = getEntryLanguage(e.id);
    return entryLang === lang;
  });
  const defaultLangEntries = entries.filter((e: { id: string }) => {
    const entryLang = getEntryLanguage(e.id);
    return entryLang === defaultLang;
  });

  function filterEvidenceSource(e: { id: string; data: unknown }): {
    entry: { id: string; data: EvidenceSourceData };
    slug: string;
  } | null {
    const data = e.data as EvidenceSourceData;
    if (data.type !== "evidence-source") return null;
    if (!data.kind || !NACHWEIS_EVIDENCE_KINDS.has(data.kind)) return null;
    if (data.status !== "published") return null;
    const slug = data.slug;
    if (typeof slug !== "string" || slug.trim() === "") {
      throw new Error(
        `[nachweis-list] Evidence record ${e.id} is missing required frontmatter "slug". ` +
          `Run nachweis.validate to identify affected files.`,
      );
    }
    return { entry: { id: e.id, data }, slug };
  }

  // Collect slugs available in the target language to avoid duplicates
  const seenSlugs = new Set<string>();
  const orderedEntries: Array<{ id: string; data: EvidenceSourceData }> = [];

  for (const entry of langEntries) {
    const filtered = filterEvidenceSource(entry);
    if (!filtered) continue;
    orderedEntries.push(filtered.entry);
    seenSlugs.add(filtered.slug);
  }

  // Per-record fallback: fill missing records from the default language
  for (const entry of defaultLangEntries) {
    const filtered = filterEvidenceSource(entry);
    if (!filtered) continue;
    if (seenSlugs.has(filtered.slug)) continue;
    orderedEntries.push(filtered.entry);
  }

  const records: NachweisRecord[] = [];
  for (const entry of orderedEntries) {
    const data = entry.data;
    const slug = data.slug!;

    if (data.kind === "technical-assessment" && data.assessment) {
      const a = data.assessment;
      const sourceHashes = data.items
        ? Object.values(data.items)
            .map((item) => item.sha256)
            .filter((h): h is string => !!h)
        : [];

      records.push({
        variant: "technical-assessment",
        slug,
        title: data.name ?? slug,
        provider: {
          id: a.provider?.id ?? "unknown",
          name: a.provider?.name ?? "Unknown",
          ...(a.provider?.homepage ? { homepage: a.provider.homepage } : {}),
        },
        tool: {
          name: a.tool?.name ?? "Unknown",
          ...(a.tool?.version ? { version: a.tool.version } : {}),
        },
        executionMode: (a.executionMode as "operator-run" | "provider-run") ?? "operator-run",
        subjectUrl: a.subject?.url ?? "",
        observedAt: a.observedAt ?? "",
        methodology: a.methodology ?? { id: "", version: "", runCount: 1, aggregation: "none" },
        ...(a.overall ? { overall: a.overall } : {}),
        ...(a.providerReportUrl ? { providerReportUrl: a.providerReportUrl } : {}),
        dimensions: (a.dimensions ?? []).map((d) => ({
          id: d.id,
          providerLabel: d.providerLabel,
          ...(d.score !== undefined ? { score: d.score } : {}),
          ...(d.numerator !== undefined ? { numerator: d.numerator } : {}),
          ...(d.denominator !== undefined ? { denominator: d.denominator } : {}),
          ...(d.status ? { status: d.status as "pass" | "fail" | "not-checked" } : {}),
          ...(d.level ? { level: d.level } : {}),
        })),
        verificationLevel: "N1",
        sourceHashes,
        limitation: "Point-in-time measurement. Results may vary between runs.",
        status: "published",
      });
    } else {
      const sourceHashes = data.items
        ? Object.values(data.items)
            .map((item) => item.sha256)
            .filter((h): h is string => !!h && h !== "0".repeat(64))
        : [];
      const screenshotHash =
        typeof (data.websiteScreenshot as Record<string, unknown> | undefined)?.sha256 === "string"
          ? ((data.websiteScreenshot as Record<string, unknown>).sha256 as string)
          : undefined;
      const allHashes = [
        ...sourceHashes,
        ...(screenshotHash && screenshotHash !== "0".repeat(64) ? [screenshotHash] : []),
      ];

      records.push({
        variant: "attestation",
        slug,
        title: data.name ?? slug,
        result: "",
        status: "published",
        ...(allHashes.length > 0 ? { sourceHashes: allHashes } : {}),
        ...((data.display as Record<string, unknown> | undefined)?.hashCode === "visible"
          ? { displayHashCode: "visible" as const }
          : {}),
        ...(data.display?.websiteLink === "visible" || data.display?.websiteLink === "hidden"
          ? { display: { websiteLink: data.display.websiteLink as "visible" | "hidden" } }
          : {}),
        ...(typeof data.websiteUrl === "string" ? { websiteUrl: data.websiteUrl } : {}),
        ...(data.display?.screenshot === "visible" && data.websiteScreenshot?.url
          ? {
              websiteScreenshot: {
                url: data.websiteScreenshot.url,
                ...(data.websiteScreenshot.capturedAt
                  ? { capturedAt: data.websiteScreenshot.capturedAt }
                  : {}),
                ...(data.websiteScreenshot.aspectRatio
                  ? { aspectRatio: data.websiteScreenshot.aspectRatio }
                  : {}),
              },
            }
          : {}),
        ...(typeof data.websiteTagline === "string" ? { websiteTagline: data.websiteTagline } : {}),
        ...(typeof data.websiteFooterTagline === "string"
          ? { websiteFooterTagline: data.websiteFooterTagline }
          : {}),
        ...(typeof data.sortOrder === "number" ? { sortOrder: data.sortOrder } : {}),
      });
    }
  }
  return records;
}

const overrideRecords = props.records ?? [];
const loadedRecords =
  overrideRecords.length > 0 ? overrideRecords : await loadPublishedNachweisRecords();

let records = loadedRecords;
if (kindFilter && kindFilter.length > 0) {
  records = records.filter((r) => kindFilter.includes(r.variant));
}
records = records.sort((a, b) => {
  const orderA = (a as { sortOrder?: number }).sortOrder ?? 100;
  const orderB = (b as { sortOrder?: number }).sortOrder ?? 100;
  return orderA - orderB;
});
if (limit !== undefined && limit > 0) {
  records = records.slice(0, limit);
}
---

<SectionShell
  slug="nachweis-list"
  sectionNumber={sectionNumber}
  background={props.background ?? { kind: "transparent" }}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <div
    class:list={["nachweis-list", `nachweis-list--${listVariant}`]}
    data-component="nachweis-list"
  >
    {
      props.header && (
        <SectionHeader
          sectionNumber={sectionNumber}
          heading={props.header.heading}
          subheading={props.header.subheading}
          align={props.header.align ?? "left"}
          level={props.header.level ?? 2}
          hideSectionNumber={props.header.hideSectionNumber}
          lang={lang}
        />
      )
    }
    {
      records.length === 0 ? (
        <p class="nachweis-list__empty">{emptyMessage}</p>
      ) : (
        <ul class="nachweis-list__items" role="list">
          {records.map((record) => (
            <li class="nachweis-list__item">
              <NachweisCard {...record} compact={listVariant === "compact"} lang={lang} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</SectionShell>
