---
/*
<MODULE_CONTRACT>
<purpose>
  NachweisCard (Nix) — Semantic article displaying a Nachweis record.
  Discriminated union: attestation variant (RFC-0708) and technical-assessment
  variant (RFC-0876). The variant field is the discriminant.
</purpose>
<non-goals>
  <item>Does not fetch data — receives all data via props from the page block.</item>
  <item>Does not handle routing or navigation.</item>
  <item>Does not render the Sichtpass section — use nachweis-detail for that.</item>
  <item>Does not render observation history — use nachweis-detail for that.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0708: initial implementation.</item>
  <item>RFC-0876: add discriminated union with technical-assessment variant.</item>
</CHANGE_SUMMARY>
*/

/**
 * NachweisCard (Nix) — trust card component
 * RFC-0708 / RFC-0876 / DNA-17 / DNA-23 / WCAG 2.2 AA
 */

import EffectHost from "../effects/effect-host.astro";
import type { Effect } from "@warpgogol/werkstatt-site/share";
import "./nachweis-card-component.css";

export interface NachweisAssessmentDimension {
  id: string;
  providerLabel: string;
  score?: number;
  numerator?: number;
  denominator?: number;
  status?: "pass" | "fail" | "not-checked";
  level?: string;
}

interface NachweisAttestationCardProps {
  variant: "attestation";
  slug: string;
  title: string;
  result: string;
  scope?: string;
  context?: string;
  limitations?: string;
  quote?: string;
  quoteLang?: string;
  source?: string;
  verifiedScope?: string;
  notVerifiedScope?: string;
  status: "draft" | "preview" | "published" | "withdrawn";
  verifiedByLabel?: string;
  verifiedDate?: string;
}

interface NachweisTechnicalAssessmentCardProps {
  variant: "technical-assessment";
  slug: string;
  title: string;
  provider: { id: string; name: string; homepage?: string };
  tool: { name: string; version?: string };
  executionMode: "operator-run" | "provider-run";
  subjectUrl: string;
  observedAt: string;
  methodology: {
    id: string;
    version: string;
    runCount: number;
    aggregation: "provider" | "median" | "none";
  };
  overall?: { score?: number; level?: string };
  dimensions: NachweisAssessmentDimension[];
  verificationLevel: "N0" | "N1" | "N2" | "N3";
  sourceHashes: string[];
  limitation: string;
  status?: "draft" | "preview" | "published" | "withdrawn";
  compact?: boolean;
  providerReportUrl?: string;
}

type NachweisCardProps = NachweisAttestationCardProps | NachweisTechnicalAssessmentCardProps;

const props = Astro.props as NachweisCardProps;

const headingId = `nachweis-card-${props.slug}-title`;

function formatDate(iso: string): string {
  try {
    const d = new Date(iso);
    return d.toLocaleDateString("de-DE", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return iso;
  }
}

function scoreRange(score: number | undefined): "good" | "fair" | "poor" | "none" {
  if (score === undefined) return "none";
  if (score >= 90) return "good";
  if (score >= 50) return "fair";
  return "poor";
}

const providerLabels: Record<string, string> = {
  "google-lighthouse": "Lighthouse",
  cloudflare: "Cloudflare",
};

const providerInitials: Record<string, string> = {
  "google-lighthouse": "LH",
  cloudflare: "CF",
};

function hasScoreDimensions(dims: NachweisAssessmentDimension[]): boolean {
  return dims.some((d) => d.score !== undefined);
}

const liveCheckUrls: Record<string, (subjectUrl: string) => string> = {
  "google-lighthouse": (url) => `https://pagespeed.web.dev/analysis?url=${encodeURIComponent(url)}`,
  cloudflare: (url) => `https://isitagentready.com/${url.replace(/\/$/, "")}`,
};

const defaultGlassEffects: Effect[] = [
  { kind: "glass", enabled: true, blur: 16, saturate: 180, tintOpacity: 0.6 },
];

function getLiveCheckUrl(
  providerId: string,
  subjectUrl: string,
  override?: string,
): string | undefined {
  if (override) return override;
  const builder = liveCheckUrls[providerId];
  if (!builder || !subjectUrl) return undefined;
  return builder(subjectUrl);
}
---

{
  props.variant === "attestation" && (
    <EffectHost
      as="article"
      effects={defaultGlassEffects}
      class="nachweis-card"
      data-component="nachweis-card"
      data-variant="attestation"
      aria-labelledby={headingId}
    >
      <h2 id={headingId} class="nachweis-card__title">
        {props.title}
      </h2>

      <p class="nachweis-card__result">{props.result}</p>

      {props.scope && (
        <p class="nachweis-card__scope">
          <span class="nachweis-card__label">Geltungsbereich:</span>
          {props.scope}
        </p>
      )}

      {props.context && <p class="nachweis-card__context">{props.context}</p>}

      {props.limitations && (
        <p class="nachweis-card__limitations">
          <span class="nachweis-card__label">Einschränkungen:</span>
          {props.limitations}
        </p>
      )}

      {props.quote && (
        <blockquote class="nachweis-card__quote" cite={props.source} lang={props.quoteLang}>
          {props.quote}
        </blockquote>
      )}

      {props.source && (
        <p class="nachweis-card__source">
          <span class="nachweis-card__label">Quelle:</span>
          <cite>{props.source}</cite>
        </p>
      )}

      <dl class="nachweis-card__verification">
        {props.verifiedScope && (
          <div class="nachweis-card__entry">
            <dt>Was dokumentiert wird</dt>
            <dd>{props.verifiedScope}</dd>
          </div>
        )}
        {props.notVerifiedScope && (
          <div class="nachweis-card__entry">
            <dt>Was nicht geprüft wurde</dt>
            <dd>{props.notVerifiedScope}</dd>
          </div>
        )}
      </dl>

      {props.verifiedDate && (
        <p class="nachweis-card__date">
          <time datetime={props.verifiedDate}>{props.verifiedDate}</time>
        </p>
      )}

      <p class="nachweis-card__status" data-status={props.status}>
        <span class="nachweis-card__status-text">
          {props.status === "published" && "Veröffentlicht"}
          {props.status === "preview" && "Vorschau"}
          {props.status === "draft" && "Entwurf"}
          {props.status === "withdrawn" && "Zurückgezogen"}
        </span>
        {props.verifiedByLabel && (
          <span class="nachweis-card__verified-by">{props.verifiedByLabel}</span>
        )}
      </p>
    </EffectHost>
  )
}

{
  props.variant === "technical-assessment" && (
    <EffectHost
      as="article"
      effects={defaultGlassEffects}
      class:list={[
        "nachweis-card",
        "nachweis-card--technical",
        props.compact && "nachweis-card--compact",
      ]}
      data-component="nachweis-card"
      data-variant="technical-assessment"
      data-provider={props.provider.id}
      aria-labelledby={headingId}
    >
      <header class="nachweis-card__header">
        <a
          class="nachweis-card__provider-badge"
          data-provider={props.provider.id}
          href={props.provider.homepage ?? "#"}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={providerLabels[props.provider.id] ?? props.provider.name}
        >
          {providerInitials[props.provider.id] ?? props.provider.name.slice(0, 2).toUpperCase()}
        </a>
        <div class="nachweis-card__header-text">
          <h2 id={headingId} class="nachweis-card__title">
            {props.title}
          </h2>
          <p class="nachweis-card__subtitle">
            {props.provider.homepage ? (
              <a href={props.provider.homepage} rel="noopener noreferrer" target="_blank">
                {providerLabels[props.provider.id] ?? props.provider.name}
              </a>
            ) : (
              <span>{providerLabels[props.provider.id] ?? props.provider.name}</span>
            )}
            {" · "}
            {props.tool.name}
            {props.tool.version && ` v${props.tool.version}`}
          </p>
        </div>
      </header>

      {(props.overall?.score !== undefined || props.overall?.level) && (
        <div class="nachweis-card__overall-gauge" data-range={scoreRange(props.overall?.score)}>
          {props.overall.score !== undefined && (
            <div class="nachweis-card__gauge">
              <svg viewBox="0 0 120 120" class="nachweis-card__gauge-svg" aria-hidden="true">
                <circle cx="60" cy="60" r="52" class="nachweis-card__gauge-track" />
                <circle
                  cx="60"
                  cy="60"
                  r="52"
                  class="nachweis-card__gauge-fill"
                  style={`stroke-dashoffset: ${326.7 * (1 - (props.overall.score ?? 0) / 100)}`}
                />
              </svg>
              <span class="nachweis-card__gauge-score">{props.overall.score}</span>
            </div>
          )}
          {props.overall.level && (
            <span class="nachweis-card__gauge-level">{props.overall.level}</span>
          )}
        </div>
      )}

      {props.dimensions.length > 0 && hasScoreDimensions(props.dimensions) && (
        <div class="nachweis-card__score-bars">
          {props.dimensions.map((dim) => (
            <div class="nachweis-card__score-bar" data-range={scoreRange(dim.score)}>
              <div class="nachweis-card__score-bar-header">
                <span class="nachweis-card__score-bar-label">{dim.providerLabel}</span>
                <span class="nachweis-card__score-bar-value">
                  {dim.score !== undefined && (
                    <span class="nachweis-card__score-bar-score">{dim.score}</span>
                  )}
                  {dim.numerator !== undefined && dim.denominator !== undefined && (
                    <span class="nachweis-card__score-bar-frac">
                      {dim.numerator}/{dim.denominator}
                    </span>
                  )}
                  {dim.level && <span class="nachweis-card__score-bar-level">{dim.level}</span>}
                </span>
              </div>
              {dim.score !== undefined && (
                <div class="nachweis-card__score-bar-track">
                  <div
                    class="nachweis-card__score-bar-fill"
                    style={`width: ${Math.min(100, Math.max(0, dim.score))}%`}
                  />
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {props.dimensions.length > 0 && !hasScoreDimensions(props.dimensions) && (
        <div class="nachweis-card__checklist">
          {props.dimensions.map((dim) => (
            <div class="nachweis-card__check-item" data-status={dim.status ?? "not-checked"}>
              <span class="nachweis-card__check-icon" aria-hidden="true">
                {dim.status === "pass" && "✓"}
                {dim.status === "fail" && "✕"}
                {dim.status !== "pass" && dim.status !== "fail" && "—"}
              </span>
              <span class="nachweis-card__check-label">{dim.providerLabel}</span>
              {dim.numerator !== undefined && dim.denominator !== undefined && (
                <span class="nachweis-card__check-score">
                  {dim.numerator}/{dim.denominator}
                </span>
              )}
            </div>
          ))}
        </div>
      )}

      {!props.compact &&
        getLiveCheckUrl(props.provider.id, props.subjectUrl, props.providerReportUrl) && (
          <div class="nachweis-card__live-check">
            <p class="nachweis-card__disclaimer">
              Die hier gezeigten Werte wurden am {formatDate(props.observedAt)} erhoben. Aktuelle
              Live-Ergebnisse können abweichen.
            </p>
            <a
              class="nachweis-card__live-check-link"
              href={getLiveCheckUrl(props.provider.id, props.subjectUrl, props.providerReportUrl)}
              rel="noopener noreferrer"
              target="_blank"
            >
              Live-Prüfung öffnen
            </a>
          </div>
        )}

      {!props.compact && (
        <dl class="nachweis-card__meta-grid">
          <div class="nachweis-card__meta-item">
            <dt>Prüfling</dt>
            <dd>
              <a href={props.subjectUrl} rel="noopener noreferrer">
                {props.subjectUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}
              </a>
            </dd>
          </div>
          <div class="nachweis-card__meta-item">
            <dt>Beobachtet am</dt>
            <dd>
              <time datetime={props.observedAt}>{formatDate(props.observedAt)}</time>
            </dd>
          </div>
          <div class="nachweis-card__meta-item">
            <dt>Methode</dt>
            <dd>
              {props.methodology.id}@{props.methodology.version} · {props.methodology.runCount} Lauf
              {props.methodology.runCount !== 1 ? "e" : ""}
            </dd>
          </div>
          <div class="nachweis-card__meta-item">
            <dt>Ausführung</dt>
            <dd>
              {props.executionMode === "operator-run"
                ? "Operator-ausgeführt"
                : "Anbieter-ausgeführt"}
            </dd>
          </div>
        </dl>
      )}

      {props.compact && (
        <p class="nachweis-card__meta-compact">
          <time datetime={props.observedAt}>{formatDate(props.observedAt)}</time>
        </p>
      )}

      <footer class="nachweis-card__footer">
        <span class="nachweis-card__status-badge" data-status={props.status ?? "published"}>
          <span class="nachweis-card__status-text">
            {(props.status ?? "published") === "published" && "Veröffentlicht"}
            {props.status === "preview" && "Vorschau"}
            {props.status === "draft" && "Entwurf"}
            {props.status === "withdrawn" && "Zurückgezogen"}
          </span>
        </span>
        <span class="nachweis-card__verification-level">
          N{props.verificationLevel.replace("N", "")}
        </span>
        {!props.compact && props.sourceHashes.length > 0 && (
          <span class="nachweis-card__hash-count">
            {props.sourceHashes.length} Hash{props.sourceHashes.length !== 1 ? "es" : ""}
          </span>
        )}
      </footer>
    </EffectHost>
  )
}
