---
/*
<MODULE_CONTRACT>
<purpose>
  RFC-0220 visible material credit disclosure. Renders a compact localized line
  with expandable structured provenance details from a MaterialCredit record.
</purpose>
<non-goals>
  <item>Do not load sidecars or decide fallback; callers pass the resolved credit.</item>
  <item>Do not reveal prompt text; only role/tool/author information is rendered.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0220: initial token-driven material credit disclosure component.</item>
  <item>RFC-0499: add surfacePage prop — suppresses visible credit row, emits Konzeptillustration label + /bildnachweise/ link + data-ai-generated attribute.</item>
</CHANGE_SUMMARY>
*/

import {
  buildMaterialCreditJsonLd,
  formatMaterialCreditLine,
  getSiteLabelsData,
  labelForMaterialCreditRole,
  labelForSourceType,
  materialCreditLabelsSchema,
  resolveAttributionDisplay,
  readCreditsSiteDefault,
  type AttributionDisplay,
  type MaterialCredit,
  type MaterialCreditLabels,
} from "@warpgogol/werkstatt-site/share";
import { claimCreditNode } from "@warpgogol/werkstatt-site/ui/components/material-credit/credit-dedup.js";
import "./material-credit.css";

interface Props {
  credit: MaterialCredit;
  lang?: string;
  defaultLanguageCode?: string;
  contentUrl?: string;
  /**
   * RFC-0231: per-placement visibility override (level 2). When the resolved
   * decision is "hidden", the visible <details> row is omitted but the JSON-LD
   * <script> provenance node is STILL emitted — hiding never strips provenance.
   */
  display?: AttributionDisplay;
  /**
   * RFC-0227: when true the component omits the standalone <script> JSON-LD block
   * because the page-graph layer already includes this node (via materialCreditAtIds).
   */
  suppressScript?: boolean;
  /**
   * RFC-0499: when true, the component is rendered on a surface page and suppresses
   * the visible credit row. Instead it emits a <figcaption> with a localized
   * "Konzeptillustration" label and a link to /bildnachweise/#<credit.id>.
   * The JSON-LD <script> provenance node is still emitted.
   */
  surfacePage?: boolean;
}

async function loadMaterialCreditLabels(
  lang: string,
  defaultLanguageCode: string,
): Promise<MaterialCreditLabels> {
  const localized = await getSiteLabelsData(lang, defaultLanguageCode);
  const fallback =
    lang === defaultLanguageCode
      ? localized
      : await getSiteLabelsData(defaultLanguageCode, defaultLanguageCode);
  return materialCreditLabelsSchema.parse(
    (localized as { materialCredits?: unknown } | null)?.materialCredits ??
      (fallback as { materialCredits?: unknown } | null)?.materialCredits,
  );
}

const {
  credit,
  lang,
  defaultLanguageCode,
  contentUrl,
  display,
  suppressScript = false,
  surfacePage = false,
} = Astro.props as Props;
const activeLang = lang ?? defaultLanguageCode;
if (!activeLang || !defaultLanguageCode) {
  throw new Error("[material-credit] lang and defaultLanguageCode are required.");
}
const labels = await loadMaterialCreditLabels(activeLang, defaultLanguageCode);
const line = formatMaterialCreditLine(credit, labels);
const visibleParties = credit.parties.filter((party) => party.role !== "sourceMaterial");
const jsonLd = buildMaterialCreditJsonLd(credit, contentUrl, labels);

// RFC-0231: resolve whether the VISIBLE row renders. Precedence: per-asset
// (credit.display) → per-placement (display prop) → site default → RFC-0228 intent.
// Provenance (<script> below) is emitted regardless of this decision.
const siteDefault = readCreditsSiteDefault(
  await getSiteLabelsData(activeLang, defaultLanguageCode),
);
const visibleRow =
  resolveAttributionDisplay({
    surface: "material-credit",
    intent: credit.target.intent,
    assetOverride: credit.display,
    placementOverride: display,
    siteDefault,
  }) === "shown";

// RFC-0227: emit at most one JSON-LD node per @id per page. The same asset can be
// disclosed more than once on a page (e.g. a baked surface hero + a section image),
// but two nodes sharing an @id break page-graph parity (jsonld.parity). The visible
// disclosure still renders every time; only the duplicate <script> is suppressed.
const creditAtId = typeof jsonLd["@id"] === "string" ? (jsonLd["@id"] as string) : undefined;
const emitScript =
  !suppressScript && (!creditAtId || claimCreditNode(Astro.url.pathname, creditAtId));

// RFC-0499: surface page mode — suppress visible credit row, emit compact label.
const isAiGenerated = credit.sourceType === "ai-generated" || credit.sourceType === "ai-assisted";
const konzeptLabel = labels.aiUsageLabels?.aiGenerated ?? "Konzeptillustration";
const bildnachweiseHref = `/bildnachweise/#${credit.id}`;
---

{
  surfacePage && isAiGenerated && (
    <figcaption class="material-credit__surface-label" data-credit-context data-ai-generated>
      <a href={bildnachweiseHref}>{konzeptLabel}</a>
    </figcaption>
  )
}
{
  surfacePage && !isAiGenerated && visibleRow && (
    <details class="material-credit" data-credit-context>
      <summary class="material-credit__summary">
        <span class="material-credit__label">{labels.summaryLabel}</span>
        <span class="material-credit__line">{line}</span>
      </summary>
      <div class="material-credit__details">
        {credit.title && <p class="material-credit__title">{credit.title}</p>}
        <dl class="material-credit__list">
          {visibleParties.map((party) => (
            <div class="material-credit__item">
              <dt>{labelForMaterialCreditRole(party.role, labels)}</dt>
              <dd>
                {party.url ? (
                  <a href={party.url} target="_blank" rel="noopener noreferrer">
                    {party.name}
                  </a>
                ) : (
                  party.name
                )}
                {party.kind === "Organization" && (
                  <span class="material-credit__kind"> {party.kind}</span>
                )}
                {party.version && <span class="material-credit__version"> v{party.version}</span>}
                {party.generatedAt && (
                  <span class="material-credit__generated"> {party.generatedAt}</span>
                )}
                {party.note && <span class="material-credit__note"> {party.note}</span>}
              </dd>
            </div>
          ))}
          <div class="material-credit__item">
            <dt>{labels.sourceType}</dt>
            <dd>{labelForSourceType(credit.sourceType, labels)}</dd>
          </div>
          <div class="material-credit__item">
            <dt>{labels.license}</dt>
            <dd>
              {credit.license.url ? (
                <a href={credit.license.url} target="_blank" rel="noopener noreferrer">
                  {credit.license.label}
                </a>
              ) : (
                credit.license.label
              )}
            </dd>
          </div>
        </dl>
      </div>
    </details>
  )
}
{
  !surfacePage && visibleRow && (
    <details class="material-credit" data-credit-context>
      <summary class="material-credit__summary">
        <span class="material-credit__label">{labels.summaryLabel}</span>
        <span class="material-credit__line">{line}</span>
      </summary>
      <div class="material-credit__details">
        {credit.title && <p class="material-credit__title">{credit.title}</p>}
        <dl class="material-credit__list">
          {visibleParties.map((party) => (
            <div class="material-credit__item">
              <dt>{labelForMaterialCreditRole(party.role, labels)}</dt>
              <dd>
                {party.url ? (
                  <a href={party.url} target="_blank" rel="noopener noreferrer">
                    {party.name}
                  </a>
                ) : (
                  party.name
                )}
                {party.kind === "Organization" && (
                  <span class="material-credit__kind"> {party.kind}</span>
                )}
                {party.version && <span class="material-credit__version"> v{party.version}</span>}
                {party.generatedAt && (
                  <span class="material-credit__generated"> {party.generatedAt}</span>
                )}
                {party.note && <span class="material-credit__note"> {party.note}</span>}
              </dd>
            </div>
          ))}
          <div class="material-credit__item">
            <dt>{labels.sourceType}</dt>
            <dd>{labelForSourceType(credit.sourceType, labels)}</dd>
          </div>
          <div class="material-credit__item">
            <dt>{labels.license}</dt>
            <dd>
              {credit.license.url ? (
                <a href={credit.license.url} target="_blank" rel="noopener noreferrer">
                  {credit.license.label}
                </a>
              ) : (
                credit.license.label
              )}
            </dd>
          </div>
        </dl>
      </div>
    </details>
  )
}
{emitScript && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
