---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0105] Canonical global SiteBackground shell-layer component. Renders
  one or more background layers (color, image, gradient) fixed to the viewport
  at z-index -1, independent of section-level SectionBackground.
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import { resolveImage } from "@warpgogol/werkstatt-site/share";
import type { SiteBackgroundConfig } from "@warpgogol/werkstatt-site/share";
import ResponsiveImage from "@warpgogol/werkstatt-site/ui/components/responsive-image.astro";
import "./site-background.css";

const { layers, lang } = Astro.props as SiteBackgroundConfig;
if (!lang) {
  throw new Error("[site-background] lang is required.");
}

import { contentAssetImages } from "../../content-assets.ts";
const images = contentAssetImages;

const resolvedLayers = layers.map((layer) => {
  if (layer.kind === "image") {
    return {
      ...layer,
      imageMeta: resolveImage(images, layer.imageName, { lang }),
    };
  }
  return layer;
});

function gradientCss(layer: Extract<SiteBackgroundConfig["layers"][number], { kind: "gradient" }>) {
  const stops = layer.stops
    .map((s) => {
      const color =
        typeof s.opacity === "number"
          ? `color-mix(in srgb, ${s.color} ${Math.round(s.opacity * 100)}%, transparent)`
          : s.color;
      return `${color} ${Math.round(s.at * 100)}%`;
    })
    .join(", ");
  if (layer.direction === "radial") return `radial-gradient(ellipse at center, ${stops})`;
  const dir = layer.direction === "vertical" ? "to bottom" : "to right";
  return `linear-gradient(${dir}, ${stops})`;
}
---

<div class="site-background" data-volume="site-bg" aria-hidden="true">
  {
    resolvedLayers.map((layer) => {
      if (layer.kind === "color") {
        return (
          <div
            class="site-background__layer site-background__layer--color"
            style={`background: ${layer.color ?? "var(--ds-color-bg)"};`}
          />
        );
      }
      if (layer.kind === "gradient") {
        return (
          <div
            class="site-background__layer site-background__layer--gradient"
            style={`background-image: ${gradientCss(layer)};`}
          />
        );
      }
      if (layer.kind === "image") {
        const fitClass = `site-background__image--${layer.fit ?? "cover"}`;
        const parallaxSpeed = layer.parallax?.speed ?? 0.4;
        const loadingMode = layer.loading ?? "lazy";
        return (
          <div class="site-background__layer site-background__layer--image">
            {"imageMeta" in layer && layer.imageMeta && (
              <ResponsiveImage
                image={layer.imageMeta}
                alt=""
                class={["site-background__image", fitClass].filter(Boolean).join(" ")}
                loading={loadingMode}
                fetchpriority={loadingMode === "eager" ? "high" : undefined}
                data-parallax-speed={layer.parallax ? String(parallaxSpeed) : undefined}
                lang={lang}
              />
            )}
            {layer.tint && (
              <div
                class="site-background__tint"
                style={`background: ${layer.tint.color ?? "var(--ds-color-bg)"}; opacity: ${layer.tint.opacity ?? 0.4};`}
              />
            )}
          </div>
        );
      }
      console.warn(
        `[site-background-component] Unknown layer kind: "${(layer as { kind?: string }).kind ?? "unknown"}. Expected: color, gradient, image.`,
      );
      return null;
    })
  }
</div>
