---
/*
<MODULE_CONTRACT>
<purpose>
  NachweisVerify (Styx) — Cryptographic verification data display for a
  Nachweis record. Shows source SHA-256, public derivative SHA-256, record
  payload SHA-256, envelope SHA-256, operator signature, and qualified
  timestamp. Read-only. RFC-0708.
</purpose>
<non-goals>
  <item>Does not fetch data — receives all data via props from the page block.</item>
  <item>Does not perform verification — only displays verification data.</item>
  <item>Does not handle routing.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0708: initial implementation.</item>
  <item>RFC-0871: replace qualifiedTimestamp prop with structured timestamp prop carrying assurance metadata.</item>
</CHANGE_SUMMARY>
*/

/**
 * NachweisVerify (Styx) — trust verify component
 * RFC-0708 / DNA-17 / DNA-23 / WCAG 2.2 AA
 */

import type { SectionProps } from "@warpgogol/werkstatt-shared/share/page";
import { need, cast } from "@warpgogol/werkstatt-site/share";
import SectionShell from "../section-shell/section-shell.astro";
import "./nachweis-verify-component.css";

export interface NachweisVerifyLabels {
  titleTemplate: string;
  sourceHash: string;
  publicDerivative: string;
  recordHash: string;
  envelopeHash: string;
  verificationLevel: string;
  qualifiedTimestamp: string;
  rfc3161Timestamp: string;
  qualificationEvidence: string;
  operatorSignature: string;
}

interface NachweisVerifyContent {
  slug: string;
  version: string;
  sourceSha256: string;
  publicDerivativeSha256?: string;
  recordPayloadSha256?: string;
  envelopeSha256?: string;
  operatorSignature?: string;
  timestamp?: {
    tokenPresent: boolean;
    assurance: "rfc3161" | "eidas-qualified";
    providerName?: string;
    qualificationEvidenceRef?: string;
  };
  verificationLevel?: string;
  background?: unknown;
  effects?: unknown;
  density?: "compact" | "normal" | "spacious";
  tone?: "default" | "warning" | "success" | "muted";
  labels: NachweisVerifyLabels;
}

const { lang, sectionNumber, pageOverride } = Astro.props as SectionProps;
const props = cast<NachweisVerifyContent>(pageOverride);
const {
  slug,
  version,
  sourceSha256,
  publicDerivativeSha256,
  recordPayloadSha256,
  envelopeSha256,
  operatorSignature,
  timestamp,
  verificationLevel,
} = props;

const t = need("labels", props.labels) as NachweisVerifyLabels;

const headingId = `nachweis-verify-${slug}-${version}-title`;
---

<SectionShell
  slug="nachweis-verify"
  sectionNumber={sectionNumber}
  background={props.background ?? { kind: "transparent" }}
  effects={props.effects}
  density={props.density}
  tone={props.tone}
  lang={lang}
>
  <div class="nachweis-verify" data-component="nachweis-verify" aria-labelledby={headingId}>
    <h2 id={headingId} class="nachweis-verify__title">
      {t.titleTemplate.replace("{version}", version)}
    </h2>

    <dl class="nachweis-verify__data">
      <div class="nachweis-verify__entry">
        <dt>{t.sourceHash}</dt>
        <dd><code class="nachweis-verify__hash">{sourceSha256}</code></dd>
      </div>
      {
        publicDerivativeSha256 && (
          <div class="nachweis-verify__entry">
            <dt>{t.publicDerivative}</dt>
            <dd>
              <code class="nachweis-verify__hash">{publicDerivativeSha256}</code>
            </dd>
          </div>
        )
      }
      {
        recordPayloadSha256 && (
          <div class="nachweis-verify__entry">
            <dt>{t.recordHash}</dt>
            <dd>
              <code class="nachweis-verify__hash">{recordPayloadSha256}</code>
            </dd>
          </div>
        )
      }
      {
        envelopeSha256 && (
          <div class="nachweis-verify__entry">
            <dt>{t.envelopeHash}</dt>
            <dd>
              <code class="nachweis-verify__hash">{envelopeSha256}</code>
            </dd>
          </div>
        )
      }
      {
        verificationLevel && (
          <div class="nachweis-verify__entry">
            <dt>{t.verificationLevel}</dt>
            <dd>{verificationLevel}</dd>
          </div>
        )
      }
      {
        timestamp?.tokenPresent && (
          <div class="nachweis-verify__entry">
            <dt>
              {timestamp.assurance === "eidas-qualified"
                ? t.qualifiedTimestamp
                : t.rfc3161Timestamp}
            </dt>
            <dd>
              {timestamp.providerName && <span>{timestamp.providerName}</span>}
              {timestamp.qualificationEvidenceRef && (
                <a href={timestamp.qualificationEvidenceRef} rel="noopener noreferrer">
                  {t.qualificationEvidence}
                </a>
              )}
            </dd>
          </div>
        )
      }
      {
        operatorSignature && (
          <div class="nachweis-verify__entry">
            <dt>{t.operatorSignature}</dt>
            <dd>
              <code class="nachweis-verify__hash">{operatorSignature}</code>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</SectionShell>
