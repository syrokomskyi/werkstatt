---
/* 
<MODULE_CONTRACT> 
<purpose>Renders a cosmic star map using an embedded SVG, with a fallback for unavailability.</purpose> 
 
 
<non-goals> 
  <item>Do not generate or modify the SVG artifact within this component.</item> 
  <item>Do not manage global application state or side effects beyond local context.</item> 
</non-goals> 
</MODULE_CONTRACT> 
 
<CHANGE_SUMMARY>
  <item>Enhance navigability and maintainability through structured Compass scaffolding.</item>
</CHANGE_SUMMARY> 
*/

/**
 * PassportStarMap (Adrastea) — Cosmic Star Map display moon
 *
 * Embeds the pre-generated cosmic-star-map.svg artifact produced by
 * star-map.render during the passport.emit pipeline. Falls back to a
 * descriptive placeholder when the SVG is not yet available.
 *
 * The SVG path is configurable so the component can be tested in
 * isolation with a custom artifact directory.
 *
 * RFC-0028 / DNA-32 / Adrastea (Jupiter inner moon)
 */

import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { loadPassportData } from "@warpgogol/werkstatt-site/passport/data";
import "./passport-star-map-component.css";

interface Props {
  /** Path to the directory containing cosmic-star-map.svg.
   *  Defaults to the standard dist/.well-known/ location. */
  artifactDir?: string;
  /** Accessible label for the SVG figure. */
  label?: string;
  /** Emit source tag: "star-map-page" (default) or "passport-inline". */
  emitSource?: "star-map-page" | "passport-inline";
}

const {
  artifactDir = join(process.cwd(), "dist", ".well-known"),
  label,
  emitSource = "star-map-page",
} = Astro.props;

const passport = await loadPassportData();
const appId = passport?.appId ?? "unknown";

let svgContent: string | null = null;
try {
  const raw = await readFile(join(artifactDir, "cosmic-star-map.svg"), "utf8");
  // Strip XML declaration if present so inline embedding stays valid HTML5.
  svgContent = raw.replace(/^<\?xml[^?]*\?>\s*/i, "");
} catch {
  // File not yet generated — render unavailable state.
}
---

<section class="passport-star-map" data-component="passport-star-map">
  <h2 class="passport-star-map__heading">{label}</h2>

  {
    svgContent ? (
      <figure class="passport-star-map__figure" aria-label={label}>
        <div class="passport-star-map__svg-wrapper" set:html={svgContent} />
        <figcaption class="passport-star-map__caption">
          Component architecture graph — generated by <code>star-map.render</code>
        </figcaption>
      </figure>
    ) : (
      <div class="passport-star-map__placeholder" role="img" aria-label={label}>
        <svg
          class="passport-star-map__placeholder-icon"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="3" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <p class="passport-star-map__unavailable">
          Star Map not yet generated — run <code>star-map.render</code> to produce the SVG artifact.
        </p>
      </div>
    )
  }
</section>

<script define:vars={{ appId, emitSource }}>
  // Emit star-map-navigate growth event on mount (DNA-27 / RFC-0028).
  (function () {
    function tryEmit() {
      const emitFn = window.__warpgogol_emit__;
      if (typeof emitFn !== "function") return;
      emitFn("star-map-navigate", { appId, source: emitSource });
    }
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", tryEmit, { once: true });
    } else {
      tryEmit();
    }
  })();
</script>
