---
/*
<MODULE_CONTRACT>
<purpose>
  [RFC-0104] Canonical CTA primitive. Renders one button/link with biome-token
  driven styling and resolves the discriminated CtaTarget through
  resolveSemanticTarget (internal), preserves rel for external links, prepends
  # for anchor targets.
</purpose>
<non-goals>
  <item>Do not introduce app-specific runtime composition or deployment behavior into this reusable package source file.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0133: backfilled MODULE_MAP and CHANGE_SUMMARY markers for compass.validate compliance.</item>
</CHANGE_SUMMARY>
*/

import type { CtaConfig } from "@warpgogol/werkstatt-site/share";
import { resolveSemanticTarget } from "@warpgogol/werkstatt-site/share";
import { loadVendorIcon } from "../../icons/icon-resolver.ts";
import "./section-cta.css";

type Props = CtaConfig & { lang?: string; class?: string };

const {
  label,
  target,
  ariaLabel,
  variant = "primary",
  icon,
  iconPosition = "trailing",
  size = "md",
  fullWidth = false,
  lang,
  class: extraClass = "",
} = Astro.props as Props;

if (!lang) {
  throw new Error("[section-cta] lang is required.");
}

let href: string | null = null;
let rel: string | undefined;
let externalAttrs: Record<string, string> = {};
if (target.kind === "internal") {
  href = await resolveSemanticTarget({ kind: "internal", pageId: target.pageId }, lang);
  if (href && target.anchor) href = `${href}#${target.anchor}`;
} else if (target.kind === "external") {
  href = target.href;
  rel = target.rel ?? "noopener noreferrer";
  externalAttrs = { target: "_blank" };
} else if (target.kind === "anchor") {
  href = `#${target.anchor}`;
} else {
  console.warn(
    `[section-cta] Unexpected target.kind: "${(target as { kind?: string }).kind ?? "unknown"}. Expected: internal, external, anchor.`,
  );
  href = `#${(target as { anchor?: string }).anchor ?? ""}`;
}

const Icon = icon ? await loadVendorIcon(icon) : null;

// WCAG 2.5.3 Label in Name: if ariaLabel is set but doesn't contain the visible
// label text, prepend the label so the accessible name includes the visible text.
const resolvedAriaLabel =
  ariaLabel && label && !ariaLabel.toLowerCase().includes(label.toLowerCase())
    ? `${label} — ${ariaLabel}`
    : ariaLabel;
---

{
  href && (
    <a
      href={href}
      class:list={[
        "section-cta",
        `section-cta--${variant}`,
        `section-cta--${size}`,
        { "section-cta--full-width": fullWidth },
        extraClass,
      ]}
      aria-label={resolvedAriaLabel}
      rel={rel}
      {...externalAttrs}
    >
      {Icon && iconPosition === "leading" && (
        <Icon size={icon?.size ?? 18} color="primary" aria-label="" />
      )}
      <span>{label}</span>
      {Icon && iconPosition === "trailing" && (
        <Icon size={icon?.size ?? 18} color="primary" aria-label="" />
      )}
    </a>
  )
}
