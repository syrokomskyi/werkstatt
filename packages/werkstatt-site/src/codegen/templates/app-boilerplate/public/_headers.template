{{GENERATED_HEADER}}
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https:; upgrade-insecure-requests
  Cross-Origin-Resource-Policy: same-site
  X-DNS-Prefetch-Control: on
{{AGENT_LINK_HEADERS}}


# RFC-0315: Markdown twins — text/markdown content type + short freshness
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# RFC-0315: .well-known/* — short freshness, nosniff
/.well-known/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# RFC-0783: API Catalog — application/linkset+json content type
/.well-known/api-catalog
  Content-Type: application/linkset+json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# RFC-0783: MCP Server Card — application/json content type
/.well-known/mcp/server-card.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# Agent Skills Index — application/json content type
/.well-known/agent-skills/index.json
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# OAuth Protected Resource Metadata — application/json content type
/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# OAuth Authorization Server Metadata — application/json content type
/.well-known/oauth-authorization-server
  Content-Type: application/json; charset=utf-8
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

# RFC-0315: /api/agent/v1/* — short freshness, nosniff
/api/agent/v1/*
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

