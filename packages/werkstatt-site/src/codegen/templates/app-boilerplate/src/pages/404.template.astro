---
{{GENERATED_HEADER}}
/*
<MODULE_CONTRACT>
<purpose>Generated Astro 404 route. Returns HTTP 404 and renders the shared @warpgogol/ui not-found component inside the normal site chrome.</purpose>
<non-goals>
  <item>Do not discover routes beyond deterministic v1 home/contact targets.</item>
  <item>Do not serve Markdown twin fallbacks as 200.</item>
</non-goals>
</MODULE_CONTRACT>
<CHANGE_SUMMARY>
  <item>RFC-0310: initial generated 404 route.</item>
</CHANGE_SUMMARY>
*/

import { getRouteRegistry } from "@warpgogol/werkstatt-site/share";
import { resolvePageRoute } from "@warpgogol/werkstatt-site/share/astro/page-handler";
import type { SemanticPageType } from "@warpgogol/werkstatt-site/share/semantic";
import { buildPageSemanticModel, buildPbpSemanticProfile, loadTargetCurrencies } from "@warpgogol/werkstatt-site/pbp/semantic-profile";
import BaseLayout from "@warpgogol/werkstatt-site/ui/components/layout";
import GrowthProvider from "@warpgogol/werkstatt-site/growth/provider.astro";
import Header from "@warpgogol/werkstatt-site/ui/components/header";
import Footer from "@warpgogol/werkstatt-site/ui/components/footer";
import NotFound from "@warpgogol/werkstatt-site/ui/components/not-found/not-found-component.astro";
import globalStylesheetUrl from "@styles/global.css?url";
import { readFileSync } from "node:fs";
import { join } from "node:path";

let agentSurfaceManifest: { actions?: Array<{ id: string; description?: string }>; knowledge?: Array<{ domain: string; url?: string }> } | null = null;
try {
  agentSurfaceManifest = JSON.parse(
    readFileSync(join(process.cwd(), "src/agent-surface.generated.json"), "utf-8"),
  );
} catch {
  agentSurfaceManifest = null;
}

export const prerender = true;

Astro.response.status = 404;

const { defaultLanguage } = await getRouteRegistry();
const lang = defaultLanguage;
const currencies = await loadTargetCurrencies(`${process.cwd()}/src/content/business-profile`, lang);
const data = await resolvePageRoute({
  lang,
  slug: "",
  siteUrl: Astro.site?.toString() ?? Astro.url.origin,
  buildSemanticModel: async ({ pageId, semanticType, lang, url, fallbackFrontmatter, breadcrumbs, collectionItems, surfaceId, depth }) => {
    const profile = await buildPbpSemanticProfile(
      lang,
      url,
      `${process.cwd()}/src/content/business-profile`,
    );
    return buildPageSemanticModel(
      pageId,
      semanticType as SemanticPageType,
      lang,
      url,
      profile,
      fallbackFrontmatter,
      breadcrumbs,
      collectionItems,
      surfaceId,
      depth,
    );
  },
});
---

<BaseLayout
  title={`404 · ${data.page.title}`}
  description="Diese Seite wurde nicht gefunden."
  lang={lang}
  biome={data.biome}
  skipLinkLabel={data.skipLinkLabel}
  globalStylesheetUrl={globalStylesheetUrl}
  orchestratorConfig={data.orchestratorConfig}
  agentSurfaceManifest={agentSurfaceManifest}
  robots="noindex,follow"
>
  {
    data.growthConfig && (
      <GrowthProvider
        appId={data.appId}
        locale={lang}
        vendor={data.growthConfig.vendor}
        activeFunnels={data.growthConfig.funnels ?? []}
        activeExperiments={data.growthConfig.experiments ?? []}
      />
    )
  }
  <Header
    lang={lang}
    currentPath={Astro.url.pathname}
    supportedLangs={data.supportedLangs}
    ctaTarget={data.ctaTarget}
    defaultLanguage={defaultLanguage}
    currencies={currencies}
  />
  <main id="main-content">
    <NotFound
      lang={lang}
      title="Diese Seite gibt es hier nicht."
      intro="Der Link ist vielleicht veraltet oder die Adresse vertippt. Von hier kommen Sie wieder zurück in die wichtigsten Bereiche."
      homeLabel="Zur Startseite"
      homeHref="/"
      primaryLabel="Leistungen ansehen"
      primaryHref="/leistungen"
      contactLabel="Kontakt aufnehmen"
      contactHref="/kontakt"
    />
  </main>
  <Footer lang={lang} defaultLang={defaultLanguage} />
  <script>
    import "../scripts/layout-orchestrator";
  </script>
</BaseLayout>
