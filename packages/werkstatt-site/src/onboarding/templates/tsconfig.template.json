{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src"],
  "exclude": ["dist", "public", "node_modules", "spec"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "es2022",
    "strictNullChecks": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@schemas/*": ["src/content/schemas/*"],
      "@styles/*": ["src/styles/*"],
      "@warpgogol/werkstatt-site": ["../../packages/werkstatt-site/src/index.ts"],
      "@warpgogol/werkstatt-site/*": ["../../packages/werkstatt-site/src/*"],
      "@warpgogol/werkstatt": ["../../packages/werkstatt/src/index.ts"],
      "@warpgogol/werkstatt/*": ["../../packages/werkstatt/src/*"]
    }
  }
}
