{
  "extends": "../../tsconfig/node-lib.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.template.*",
    // TODO: RFC-0776 — remove test exclusions once test fixture paths are repaired
    "src/**/*.test.ts",
    "src/**/tests/**",
    "dist/**",
    "node_modules/**"
  ]
}
