{
  "name": "@warpgogol/passport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cosmic Passport: build-time W3C Verifiable Credential signed provenance + composition + Nebula Score document. Emits to dist/.well-known/cosmic-passport.json (DNA-31, DNA-34, RFC-0028).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./sign": {
      "types": "./src/sign.ts",
      "default": "./src/sign.ts"
    },
    "./emit": {
      "types": "./src/emit.ts",
      "default": "./src/emit.ts"
    },
    "./verify": {
      "types": "./src/verify.ts",
      "default": "./src/verify.ts"
    },
    "./key-rotate": {
      "types": "./src/key-rotate.ts",
      "default": "./src/key-rotate.ts"
    },
    "./data": {
      "types": "./src/data.ts",
      "default": "./src/data.ts"
    },
    "./identity-sign": {
      "types": "./src/identity-sign.ts",
      "default": "./src/identity-sign.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "build": "echo 'No build step required — TypeScript sources consumed directly'",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@warpgogol/nebula": "workspace:*",
    "@warpgogol/ontology": "workspace:*",
    "@warpgogol/site-kernel-content": "workspace:*",
    "@warpgogol/star-map": "workspace:*",
    "@noble/ed25519": "^3.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "fast-check": "^4.9.0",
    "vitest": "^4.1.10"
  },
  "gogol": {
    "testSignal": {
      "signal": "direct",
      "owner": "architecture",
      "rationale": "Vitest unit tests cover passport schema validation and key file schema."
    }
  }
}
