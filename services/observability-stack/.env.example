# RFC-0338: Required environment variables for the SigNoz observability stack.
# Copy to .env on the VPS and fill values. Never commit real secrets.
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# Bearer token for public OTLP ingest (Caddy enforces on ingest.observe.webgogol.com).
# How to obtain: Generate with: openssl rand -hex 32.
WGOGOL_OTLP_TOKEN=

# SMTP for email alert channel (RFC-0342).
# How to obtain: SMTP server hostname (e.g. smtp.example.com).
SIGNOZ_SMTP_HOST=

# How to obtain: SMTP server port (e.g. 587 for STARTTLS, 465 for SSL).
SIGNOZ_SMTP_PORT=

# How to obtain: SMTP authentication username.
SIGNOZ_SMTP_USER=

# How to obtain: SMTP authentication password.
SIGNOZ_SMTP_PASSWORD=

# How to obtain: From address for alert emails (e.g. alerts@webgogol.com).
SIGNOZ_SMTP_FROM=

# Backup target (Hetzner Storage Box or S3-compatible).
# How to obtain: Restic repository path (e.g. sftp://user@host/path or rest:https://endpoint/bucket).
RESTIC_REPOSITORY=

# How to obtain: Restic repository password. Generate with: openssl rand -hex 32.
RESTIC_PASSWORD=
