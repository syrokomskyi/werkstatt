# RFC-0388: Lagebild shared sync worker — environment secrets.
# Copy to .env (never commit) for `wrangler dev` and `wrangler deploy --secrets-file .env`.
# Production secrets are set via `wrangler secret put` or Cloudflare Dashboard.
#
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# ── Tenant Registry (same Supabase project as CRM buffer)
# The worker reads sync_tenants table to discover enabled clients.
# How to obtain: Supabase Dashboard → Settings → General → Project URL.
LAGEBILD_REGISTRY_URL=

# How to obtain: Supabase Dashboard → Settings → API → service_role key.
LAGEBILD_REGISTRY_API_KEY=

# ── Optional: cron group override (default: "default")
# How to obtain: Set to a cron group name if using multiple worker groups; leave empty for default.
LAGEBILD_CRON_GROUP=

# ── Per-tenant secrets (pattern: TENANT_{UPPER_SITE_NAME}_{KIND})
# Resolved dynamically from sync_tenants.secret_ref fields at runtime.
# The site_name "warpgogol-com" becomes "WARPGOGOL_COM" in the env key.
#
# Required per tenant with Pipedrive destination:
# How to obtain: Pipedrive → Settings → Personal Preferences → API → copy the API token. If the API tab is missing, ask an admin to enable API access permission.
TENANT_WARPGOGOL_COM_PIPEDRIVE_TOKEN=

# How to obtain: The company domain in your Pipedrive URL: https://<domain>.pipedrive.com. Alternatively, query GET https://api.pipedrive.com/v1/users/me with x-api-token header → company_domain field.
TENANT_WARPGOGOL_COM_PIPEDRIVE_DOMAIN=

# Required per tenant with Supabase buffer access:
# How to obtain: Supabase Dashboard → Settings → General → Project URL.
TENANT_WARPGOGOL_COM_SUPABASE_URL=

# How to obtain: Supabase Dashboard → Settings → API → service_role key.
TENANT_WARPGOGOL_COM_SUPABASE_SERVICE_KEY=

# ── OTLP metrics push (RFC-0807)
# How to obtain: SigNoz public OTLP ingest URL. Production: https://ingest.observe.warpgogol.com
WARPGOGOL_OTLP_ENDPOINT=

# How to obtain: SigNoz Caddy bearer token. Set via `wrangler secret put WARPGOGOL_OTLP_TOKEN`.
WARPGOGOL_OTLP_TOKEN=
