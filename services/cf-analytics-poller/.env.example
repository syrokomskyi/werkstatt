# cf-analytics-poller — environment variables (RFC-0388).
# Copy to .env and fill values. Never commit real secrets.
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# Cloudflare API token scoped to Analytics:Read for the polled zones.
# How to obtain: Cloudflare Dashboard → My Profile → API Tokens → Create Custom Token with Zone:Read + Analytics:Read.
CF_ANALYTICS_API_TOKEN=

# Poll cycle interval in milliseconds (default: 300000 = 5 min).
# How to obtain: Set to a number of milliseconds; leave empty for default (300000).
POLL_INTERVAL_MS=

# OTLP ingest endpoint (resolved by @gogol/observability).
# EU region only — must point to the SigNoz collector.
# How to obtain: SigNoz collector endpoint URL (e.g. https://ingest.observe.webgogol.com).
WGOGOL_OTLP_ENDPOINT=

# Bearer token for OTLP authentication (resolved by @gogol/observability).
# How to obtain: Generate with: openssl rand -hex 32. Set as WGOGOL_OTLP_TOKEN on both poller and collector.
WGOGOL_OTLP_TOKEN=
