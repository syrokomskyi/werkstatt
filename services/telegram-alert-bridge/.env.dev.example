# RFC-0806: Telegram alert bridge — dev environment secrets.
# Copy to .env.dev (never commit) for `wrangler deploy --config wrangler.dev.jsonc --secrets-file .env.dev`.
# Dev secrets use a separate Telegram bot and test chat.
#
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# Shared secret query param for authenticating inbound SigNoz alert webhooks (dev).
# How to obtain: Generate with: openssl rand -hex 32. Set as BRIDGE_SECRET on both dev SigNoz webhook URL and dev Worker.
BRIDGE_SECRET=

# Dev Telegram Bot API token (separate from production bot).
# How to obtain: Telegram → @BotFather → /newbot → copy the API token (format: 123456789:AA...).
TELEGRAM_BOT_TOKEN=

# Dev Telegram chat ID where alert messages are forwarded (test channel).
# How to obtain: Send any message to the dev bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates → result[0].message.chat.id.
TELEGRAM_CHAT_ID=

# ── OTLP metrics push (RFC-0807)
# How to obtain: SigNoz public OTLP ingest URL. Dev: https://ingest.observe.warpgogol.com
WARPGOGOL_OTLP_ENDPOINT=

# How to obtain: SigNoz Caddy bearer token. Set via `wrangler secret put WARPGOGOL_OTLP_TOKEN`.
WARPGOGOL_OTLP_TOKEN=
