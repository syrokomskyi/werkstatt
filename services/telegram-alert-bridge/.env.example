# telegram-alert-bridge — environment variables (RFC-0388).
# Copy to .env and fill values. Never commit real secrets.
#
# These are Cloudflare Worker bindings set via `wrangler secret put`.
# They are listed here for documentation; the Worker reads them from the
# runtime Env interface, not from a .env file at deploy time.
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# Shared secret query param for authenticating inbound SigNoz alert webhooks.
# How to obtain: Generate with: openssl rand -hex 32. Set as BRIDGE_SECRET on both SigNoz webhook URL and Worker.
BRIDGE_SECRET=

# Telegram Bot API token (obtain from @BotFather).
# How to obtain: Telegram → @BotFather → /newbot → copy the API token (format: 123456789:AA...). For existing bots: send /token to BotFather.
TELEGRAM_BOT_TOKEN=

# Target Telegram chat ID where alert messages are forwarded.
# How to obtain: Send any message to the bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates → result[0].message.chat.id. For groups/channels: invite the bot, send a message, then check the same URL (channel chat IDs are negative, e.g. -1001234567890).
TELEGRAM_CHAT_ID=
