# RFC-0806: Rate Fetcher Worker — dev environment secrets.
# Copy to .env.dev (never commit) for `wrangler deploy --config wrangler.dev.jsonc --secrets-file .env.dev`.
# Dev secrets point to dev/staging Supabase instances, not production.
#
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# ── Supabase (dev: rate_sources, rate_observations, rate_fetcher_health)
# How to obtain: Dev Supabase Dashboard → Settings → General → Project URL.
RATE_FETCHER_SUPABASE_URL=

# How to obtain: Dev Supabase Dashboard → Settings → API → service_role key.
RATE_FETCHER_SUPABASE_KEY=

# ── Optional: cron group override (default: "default")
# How to obtain: Set to "dev" for dev worker group; leave empty for default.
RATE_FETCHER_CRON_GROUP=

# ── OTLP metrics push (RFC-0807)
# How to obtain: SigNoz public OTLP ingest URL. Dev: https://ingest.observe.warpgogol.com
WARPGOGOL_OTLP_ENDPOINT=

# How to obtain: SigNoz Caddy bearer token. Set via `wrangler secret put WARPGOGOL_OTLP_TOKEN`.
WARPGOGOL_OTLP_TOKEN=
