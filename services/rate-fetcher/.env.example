# RFC-0388: Rate Fetcher Worker — environment secrets.
# Copy to .env (never commit) for `wrangler dev` and `wrangler deploy --secrets-file .env`.
# Production secrets are set via `wrangler secret put` or Cloudflare Dashboard.
#
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# ── Supabase (rate_sources, rate_observations, rate_fetcher_health, rate_fetcher_locks)
# The worker reads rate_sources table to discover enabled rate source configurations.
# How to obtain: Supabase Dashboard → Settings → General → Project URL.
RATE_FETCHER_SUPABASE_URL=

# How to obtain: Supabase Dashboard → Settings → API → service_role key.
RATE_FETCHER_SUPABASE_KEY=

# ── Optional: cron group override (default: "default")
# How to obtain: Set to a cron group name if using multiple worker groups; leave empty for default.
RATE_FETCHER_CRON_GROUP=

# ── OTLP metrics push (RFC-0807)
# How to obtain: SigNoz public OTLP ingest URL. Production: https://ingest.observe.warpgogol.com
WARPGOGOL_OTLP_ENDPOINT=

# How to obtain: SigNoz Caddy bearer token. Set via `wrangler secret put WARPGOGOL_OTLP_TOKEN`.
WARPGOGOL_OTLP_TOKEN=
