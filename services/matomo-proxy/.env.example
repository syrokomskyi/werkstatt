# matomo-proxy — environment variables (RFC-0807).
# Copy to .env (never commit) for `wrangler dev` and `wrangler deploy --secrets-file .env`.
# Production secrets are set via `wrangler secret put` or Cloudflare Dashboard.
#
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# ── OTLP metrics push (RFC-0807)
# How to obtain: SigNoz public OTLP ingest URL. Production: https://ingest.observe.warpgogol.com
WARPGOGOL_OTLP_ENDPOINT=

# How to obtain: SigNoz Caddy bearer token. Set via `wrangler secret put WARPGOGOL_OTLP_TOKEN`.
WARPGOGOL_OTLP_TOKEN=
