# matomo-proxy — environment variables (RFC-0388).
# Copy to .env and fill values. Never commit real secrets.
#
# MATOMO_CLOUD_HOST is deployment configuration set via wrangler vars.
# It must be the upstream Matomo host without protocol, e.g. example.matomo.cloud.
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# Upstream Matomo cloud host (bare host, no protocol or trailing slash).
# How to obtain: Matomo Cloud → your instance hostname (e.g. example.matomo.cloud).
MATOMO_CLOUD_HOST=
