// RFC-0806: Dev Worker config for matomo-proxy.
// Deploys as matomo-proxy-dev on <account>.workers.dev (no custom routes).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matomo-proxy-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
  },
}
