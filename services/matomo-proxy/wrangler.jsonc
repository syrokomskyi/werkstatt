{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "matomo-proxy",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-06",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
    "traces": {
      "enabled": true,
      "destinations": ["signoz"],
      "head_sampling_rate": 1.0,
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true,
      "invocation_logs": true,
    },
  },
}
