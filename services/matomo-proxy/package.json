{
  "name": "matomo-proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run gen:upstreams && wrangler dev",
    "build:check": "pnpm run gen:upstreams && tsc --noEmit",
    "check": "site-kernel run matomo.proxy.validate",
    "gen:upstreams": "tsx scripts/gen-upstreams.ts",
    "deploy": "pnpm run gen:upstreams && wrangler deploy"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "wrangler": "^4.118.0"
  },
  "gogol": {
    "testSignal": {
      "signal": "skipped",
      "owner": "architecture",
      "rationale": "Proxy behavior is currently guarded by matomo.proxy.validate and TypeScript; request-fixture tests are scheduled with RFC-0305 fleet controls.",
      "reviewAfter": "2026-10-01"
    }
  }
}
