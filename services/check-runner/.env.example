# check-warpgogol-runner — environment variables (RFC-0388).
# Copy to .env and fill values. Never commit real secrets.
# Every key includes a "# How to obtain:" line with concrete instructions (RFC-0388).

# Workspace root for the runner (auto-detected if not set).
# How to obtain: Set to the monorepo root path; leave empty for auto-detection.
CHECK_WEBGOGOL_WORKSPACE_ROOT=

# Check Warpgogol root directory (default: <workspace>/.check-warpgogol).
# How to obtain: Set to a directory path; leave empty for default (<workspace>/.check-warpgogol).
CHECK_WEBGOGOL_ROOT=

# Poll interval in milliseconds for queue processing (default: 1500).
# How to obtain: Set to a number of milliseconds; leave empty for default (1500).
CHECK_WEBGOGOL_POLL_MS=
