{
  "mcpServers": {
    "signoz": {
      "type": "url",
      "url": "https://observe.warpgogol.com/mcp",
      "headers": {
        "Authorization": "Bearer ${WARPGOGOL_SIGNOZ_MCP_TOKEN}"
      }
    },
    "studio-gate": {
      "type": "stdio",
      "command": "node",
      "args": ["packages/studio-gate/dist/index.js"],
      "env": {
        "WERKSTATT_ROOT": "${workspaceFolder}",
        "STUDIO_GATE_BUILD_CONCURRENCY": "2"
      }
    }
  }
}
